{
  "sayfa_no": 582,
  "ayetler": [
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 1,
      "meal": "Birbirlerine neyi soruyorlar?"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 2,
      "meal": "O büyük haberden mi?"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 3,
      "meal": "(İnanıp inanmamakta) ayrılığa düşmektedirler."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 4,
      "meal": "Hayır! Anlayacaklar!"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 5,
      "meal": "Yine hayır! Onlar anlayacaklar!"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 6,
      "meal": "Biz yeryüzünü bir döşek, yapmadık mı?"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 7,
      "meal": "Dağları da birer kazık."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 8,
      "meal": "Sizi çifter çifter yarattık."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 9,
      "meal": "Uykunuzu bir dinlenme kıldık."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 10,
      "meal": "Geceyi bir örtü yaptık."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 11,
      "meal": "Gündüzü de çalışıp kazanma zamanı kıldık."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 12,
      "meal": "Üstünüzde yedi kat sağlam göğü bina ettik."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 13,
      "meal": "(Orada) alev alev yanan bir kandil yarattık."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 14,
      "meal": "Sıkışan bulutlardan şarıl şarıl akan sular indirdik."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 15,
      "meal": "Size tohumlar, bitkiler, yetiştirmek için"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 16,
      "meal": "Ve ağaçları(birbirine) sarmaş dolaş bahçeler."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 17,
      "meal": "Şüphesiz hüküm günü vakit olarak belirlenmiştir."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 18,
      "meal": "Sur'a üflendiği gün, bölük bölük Allah'a gelirsiniz."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 19,
      "meal": "Gökyüzü açılır ve orada pek çok kapılar oluşur;"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 20,
      "meal": "Dağlar yürütülür, serap haline gelir."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 21,
      "meal": "Şüphesiz, cehennem pusuda beklemektedir."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 22,
      "meal": "Azgınların barınacağı yerdir (cehennem)."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 23,
      "meal": "(Azgınlar) orada çağlar boyu kalacaklar,"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 24,
      "meal": "Orada bir serinlik ya da (susuzluk gideren) bir içecek tatmazlar,"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 25,
      "meal": "Kaynar su ve irin (tadarlar)."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 26,
      "meal": "Ancak (dünyada yaptıklarına) uygun karşılık olarak."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 27,
      "meal": "Çünkü onlar hesap gününü (geleceğini) ummazlardı."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 28,
      "meal": "Bizim ayetlerimizi yalanladıkça yalanlamışlardı."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 29,
      "meal": "Biz ise her şeyi bir kitapta sayıp yazmışızdır."
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 30,
      "meal": "Tadın! Bundan sonra yalnızca azabınızı arttıracağız."
    }
  ]
}