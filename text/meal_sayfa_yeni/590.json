{
  "sayfa_no": 590,
  "ayetler": [
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 1,
      "meal": "Burçlara sahip gökyüzüne,"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 2,
      "meal": "Geleceği bildirilmiş olan güne,"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 3,
      "meal": "(O günde) tanıklık edene ve edilene andolsun ki,"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 4,
      "meal": "Kahroldu o hendeğin sahipleri,"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 5,
      "meal": "O çıralı ateşin,"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 6,
      "meal": "Onlar (yakanlar) da başlarına oturmuşlar,"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 7,
      "meal": "Müminlere yapmakta oldukları işkenceyi seyrediyorlardı."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 8,
      "meal": "Onlardan, sırf, aziz ve hamid olan Allah'a iman ettikleri için intikam aldılar."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 9,
      "meal": "O Allah ki, göklerin ve yerin mülkü kendisine aittir, ve Allah her şeye şahittir."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 10,
      "meal": "Şüphesiz inanmış erkeklerle inanmış kadınlara işkence edip sonra tevbe de etmeyenlere cehennem azabı ve (orada) yanma cezası vardır."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 11,
      "meal": "İman edip salih ameller işleyenlere ise, zemininden ırmaklar akan cennetler vardır. İşte büyük kurtuluş budur."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 12,
      "meal": "Şüphesiz Rabbinin yakalaması çok şiddetlidir."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 13,
      "meal": "Bilin ki O, (kainat yokken) ilk olarak yaratan, (ölümden sonra tekrar hayatı) geri getirendir."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 14,
      "meal": "O, çok bağışlayan ve çok sevendir."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 15,
      "meal": "Şerefli Arş'ın sahibidir."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 16,
      "meal": "Dilediği şeyleri mutlaka yapandır."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 17,
      "meal": "Orduların, haberi sana geldi mi?"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 18,
      "meal": "Yani Firavun ve Semud'un"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 19,
      "meal": "Doğrusu inkarcılar (gerçeği) yalanlayıp dururlar."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 20,
      "meal": "Allah onları arkalarından kuşatmıştır."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 21,
      "meal": "Hayır o şerefli bir Kur'an'dır."
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 22,
      "meal": "Levh-i Mahfuz'dadır."
    }
  ]
}