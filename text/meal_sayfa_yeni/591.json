{
  "sayfa_no": 591,
  "ayetler": [
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 1,
      "meal": "Gökyüzüne ve tarıka (sabah yıldızına) yemin ederim."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 2,
      "meal": "Tarıkın ne olduğunu nereden bileceksin?"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 3,
      "meal": "(O, karanlığı) delen yıldızdır."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 4,
      "meal": "Hiç kimse yoktur ki üzerinde bir koruyucu, bir denetleyici bulunmasın."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 5,
      "meal": "İnsan neden yaratıldığına bir baksın!"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 6,
      "meal": "Atılan bir sudan yaratıldı."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 7,
      "meal": "(O su) sırt ile göğüs kafesi arasından çıkar."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 8,
      "meal": "İşte Allah (başlangıçta bu şekilde yarattığı) insanı tekrar yaratmaya da kadirdir."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 9,
      "meal": "Gizlenenlerin ortaya döküldüğü gün"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 10,
      "meal": "O gün insan için ne bir güç ne de bir yardımcı vardır."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 11,
      "meal": "Dönüş sahibi olan (yağmur yağdıran) göğe, yemin ederim ki,"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 12,
      "meal": "(Nebat ile) yarılan yere,"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 13,
      "meal": "Şüphesiz Kur'an, (hak ile batılı) ayıran bir sözdür."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 14,
      "meal": "O, asla bir şaka değildir."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 15,
      "meal": "Onlar bir tuzak kurarlar,"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 16,
      "meal": "Ben de bir tuzak kurarım."
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 17,
      "meal": "Onun için Kafirlere mühlet ver, onları biraz kendi hallerine bırak (pek yakında desteğimiz sana gelecek)."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 1,
      "meal": "Yüce Rabbinin adını,"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 2,
      "meal": "Yaratıp düzene koyan,"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 3,
      "meal": "Takdir edip yol gösteren,"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 4,
      "meal": "(Topraktan) yeşil otu çıkaran,"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 5,
      "meal": "Sonra da onu kapkara bir sel artığına çeviren yüce Rabbinin adını tesbih (ve takdis) et."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 6,
      "meal": "Sana (Kur an'ı) okutacağız; sen hiç unutmayacaksın."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 7,
      "meal": "Artık Allah'ın dilediği hariç, Şüphesiz Allah, açığı ve gizleneni bilir."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 8,
      "meal": "Seni en kolaya muvaffak kılacağız."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 9,
      "meal": "O halde eğer öğüt fayda verirse öğüt ver."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 10,
      "meal": "(Allah'tan) korkan öğütten yararlanacak."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 11,
      "meal": "Kötü kimse ise öğütten kaçınacaktır."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 12,
      "meal": "O ki, en büyük ateşe girecektir."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 13,
      "meal": "Sonra o, ateşte ne ölür ne de yaşar."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 14,
      "meal": "Doğrusu feraha ermiştir temizlenen,"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 15,
      "meal": "Rabbinin adını anıp O'na kulluk eden."
    }
  ]
}