{
  "sayfa_no": 601,
  "ayetler": [
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 1,
      "meal": "Asra yemin ederim ki"
    },
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 2,
      "meal": "İnsan gerçekten ziyan içindedir."
    },
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 3,
      "meal": "Bundan ancak iman edip iyi ameller işleyenler, birbirlerine hakkı tavsiye edenler ve sabrı tavsiye edenler müstesnadır."
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 1,
      "meal": "Arkadan çekiştirmeyi, yüze karşı eğlenmeyi adet edinen herkesin vay haline!"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 2,
      "meal": "O ki, toplamış ve onu sayıp durmuştur."
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 3,
      "meal": "(O), malının kendisini ebedi kılacağını zanneder."
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 4,
      "meal": "Hayır! Andolsun ki o, Hutame'ye atılacaktır."
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 5,
      "meal": "Hutame'nin ne olduğunu bilir misin?"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 6,
      "meal": "Allah'ın, tutuşturulmuş ateşidir."
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 7,
      "meal": "(Yandıkça) tırmanıp kalplerin ta üstüne çıkar."
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 8,
      "meal": "O, onların üzerine kapatılıp kilitlenecektir."
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 9,
      "meal": "(Bu ateşin içinde) uzatılmış sütunlara bağlanmışlar."
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 1,
      "meal": "Rabbin fil sahiplerine neler etti, görmedin mi?"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 2,
      "meal": "Onların kötü planlarını boşa çıkarmadı mı?"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 3,
      "meal": "Onların üstüne ebabil kuşlarını gönderdi."
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 4,
      "meal": "O kuşlar, onların üzerlerine pişkin tuğladan yapılmış taşlar atıyordu."
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 5,
      "meal": "Böylece Allah onları yenilip çiğnenmiş ekine çevirdi."
    }
  ]
}