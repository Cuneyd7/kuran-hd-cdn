{
  "sayfa_no": 569,
  "ayetler": [
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 11,
      "meal": "Birbirlerine gösterilirler (fakat herkes kendi derdindedir). Günahkar kimse ister ki, o günün azabından (kurtuluş için), oğullarını,"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 12,
      "meal": "Karısını ve kardeşini,"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 13,
      "meal": "Kendisini koruyup barındıran tüm ailesini"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 14,
      "meal": "Ve yeryüzünde kim varsa hepsini fidye olarak versin de, tek kendini kurtarsın."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 15,
      "meal": "Fakat ne mümkün! Bilinmeli ki, o (cehennem) alevlenen bir ateştir."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 16,
      "meal": "Derileri kavurup soyar."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 17,
      "meal": "Yüz çevirip geri döneni, (kendine) çağırır!"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 18,
      "meal": "(Servet) toplayıp yığan kimseyi!."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 19,
      "meal": "Gerçekten insan, pek hırslı (ve sabırsız) yaratılmıştır."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 20,
      "meal": "Kendisine fenalık dokunduğunda sızlanır, feryat eder."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 21,
      "meal": "Ona imkan verildiğinde ise pinti kesilir."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 22,
      "meal": "Ancak şunlar öyle değildir: Namaz kılanlar,"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 23,
      "meal": "Ki, onlar namazlarında devamlıdırlar (ihmal göstermezler;)."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 24,
      "meal": "Mallarında, belli bir hak vardır,"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 25,
      "meal": "Saile ve mahruma(vermek için)."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 26,
      "meal": "Ceza (ve hesap) gününün doğruluğuna inananlar;"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 27,
      "meal": "Rab'lerinin azabından korkanlar,"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 28,
      "meal": "Ki Rab'lerinin azabı(na karşı) emin olunamaz;"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 29,
      "meal": "Irzlarını koruyanlar"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 30,
      "meal": "Ancak eşlerine ve cariyelerine karşı müstesna; çünkü onlar kınanmaz;"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 31,
      "meal": "Bundan öteye (geçmek) isteyenler ise, onlar taşkınların ta kendileridir,"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 32,
      "meal": "Emanetlerine ve ahitlerine riayet edenler;"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 33,
      "meal": "Şahitliklerini (dosdoğru) yapanlar;"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 34,
      "meal": "Namazlarını koruyanlar;"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 35,
      "meal": "İşte bunlar, cennetlerde ağırlanırlar."
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 36,
      "meal": "(Resulüm!) O kafirlere ne oluyor ki, sana doğru koşuyorlar?"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 37,
      "meal": "Bölük bölük sağından ve solundan(gelip etrafını sarıyorlar)"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 38,
      "meal": "Onlardan her biri nimet cennetine sokulacağını mı umuyor?"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 39,
      "meal": "Hayır (hiç ummasınlar!) Şüphesiz biz onları, kendilerinin de bildikleri şeyden yarattık (fakat ibret almadılar, imana gelmediler)."
    }
  ]
}