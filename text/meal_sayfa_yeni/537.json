{
  "sayfa_no": 537,
  "ayetler": [
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 77,
      "meal": "Şüphesiz bu, değerli bir Kur'an'dır,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 78,
      "meal": "Korunmuş bir kitaptır."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 79,
      "meal": "Ona ancak temizlenenler dokunabilir."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 80,
      "meal": "O, alemlerin Rabbinden indirilmiştir."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 81,
      "meal": "Şimdi siz, bu sözü mü küçümsüyorsunuz?"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 82,
      "meal": "Allah'ın verdiği rızka karşı şükrü, onu yalanlamakla mı yerine getiriyorsunuz?"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 83,
      "meal": "Hele can boğaza dayandığı zaman,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 84,
      "meal": "O vakit siz bakar durursunuz."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 85,
      "meal": "(O anda) biz ona sizden daha yakınız, ama göremezsiniz."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 86,
      "meal": "Madem ki ceza görmeyecekmişsiniz,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 87,
      "meal": "Onu (canı) geri çevirsenize, şayet iddianızda doğru iseniz!"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 88,
      "meal": "Fakat (ölen kişi Allah'a) yakın olanlardan ise,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 89,
      "meal": "Ona rahatlık, güzel rızık ve Naim cenneti vardır."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 90,
      "meal": "Eğer o sağdakilerden ise,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 91,
      "meal": "\"Ey sağdaki! Sana selam olsun!\""
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 92,
      "meal": "Ama yalanlayıcı sapıklardan ise,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 93,
      "meal": "İşte ona da kaynar sudan bir ziyafet vardır!"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 94,
      "meal": "Ve (onun sonu) cehenneme atılmaktır."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 95,
      "meal": "Şüphesiz ki bu, kesin gerçektir."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 96,
      "meal": "Öyleyse ulu Rabbinin adını tenzih ile an."
    },
    {
      "sure_no": 57,
      "sure_adi": "Al-Hadid",
      "ayet_no": 1,
      "meal": "Göklerde ve yerde bulunan her şey Allah'ı tesbih etmektedir. O, azizdir, hakimdir."
    },
    {
      "sure_no": 57,
      "sure_adi": "Al-Hadid",
      "ayet_no": 2,
      "meal": "Göklerin ve yerin mülkü O'nundur. O, diriltir, öldürür. O, her şeye gücü yetendir."
    },
    {
      "sure_no": 57,
      "sure_adi": "Al-Hadid",
      "ayet_no": 3,
      "meal": "O ilktir, sondur, zahirdir, batındır. O, her şeyi bilendir."
    }
  ]
}