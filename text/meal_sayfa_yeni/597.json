{
  "sayfa_no": 597,
  "ayetler": [
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 1,
      "meal": "İncire, zeytine,"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 2,
      "meal": "Sina dağına,"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 3,
      "meal": "Ve şu emin beldeye yemin ederim ki,"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 4,
      "meal": "Biz insanı en güzel biçimde yarattık."
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 5,
      "meal": "Sonra da çevirdik aşağıların aşağısına attık."
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 6,
      "meal": "Fakat iman edip salih amel işleyenler için eksilmeyen devamlı bir ecir vardır."
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 7,
      "meal": "Artık bundan sonra, ceza günü konusunda seni kim yalanlayabilir?"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 8,
      "meal": "Allah, hüküm verenlerin en üstünü değil midir?"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 1,
      "meal": "Yaratan Rabbinin adıyla oku!"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 2,
      "meal": "O, insanı bir aşılanmış yumurtadan yarattı."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 3,
      "meal": "Oku! Rabbin, en büyük kerem sahibidir."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 4,
      "meal": "O Rab ki kalemle (yazmayı) öğretti."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 5,
      "meal": "İnsana bilmedikleri şeyi öğretti."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 6,
      "meal": "Gerçek şu ki, insan azar."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 7,
      "meal": "Kendini kendine yeterli gördüğü için."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 8,
      "meal": "Kuşkusuz dönüş Rabbinedir."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 9,
      "meal": "Gördün mü şu men edeni,"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 10,
      "meal": "Namaz kılarken bir kulu (Peygamber'i namazdan)?"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 11,
      "meal": "Gördün mü, ya o (Peygamber) doğru yolda olur,"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 12,
      "meal": "Yahut takvayı emrediyorsa?"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 13,
      "meal": "Ne dersin o (meneden, Peygamber'i) yalanlıyor ve doğru yoldan yüz çeviriyorsa!"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 14,
      "meal": "(Bu adam) Allah'ın, (yaptıklarını) gördüğünü bilmez mi!"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 15,
      "meal": "Hayır, hayır! Eğer vazgeçmezse, derhal onu alnından (perçeminden), yakalarız (cehenneme atarız)."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 16,
      "meal": "O yalancı, günahkar alından (perçemden),"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 17,
      "meal": "O, hemen gidip meclisini (kendi taraftarlarını) çağırsın."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 18,
      "meal": "Biz de zebanileri çağıracağız."
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 19,
      "meal": "Hayır! Ona uyma! Allah'a secde et ve (yalnızca O'na) yaklaş!"
    }
  ]
}