{
  "sayfa_no": 535,
  "ayetler": [
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 17,
      "meal": "Çevrelerinde, (hizmet için) ölümsüz gençler dolaşır;"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 18,
      "meal": "Main çeşmesinden doldurulmuş testiler, ibrikler ve kadehlerle."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 19,
      "meal": "Bu şaraptan ne başları ağrıtılır, ne de akılları giderilir."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 20,
      "meal": "(Onlara) beğendikleri meyveler,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 21,
      "meal": "Canlarının çektiği kuş etleri,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 22,
      "meal": "İri gözlü huriler,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 23,
      "meal": "Saklı inciler gibi."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 24,
      "meal": "Yaptıklarına karşılık olarak (verilir)."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 25,
      "meal": "Orada boş bir söz ve günaha sokan bir laf işitmezler."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 26,
      "meal": "Söylenen, yalnızca \"selam, selam\" dır."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 27,
      "meal": "Sağdakiler, ne mutlu o sağdakilere!"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 28,
      "meal": "Düzgün kiraz ağacı,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 29,
      "meal": "Meyveleri salkım salkım dizili muz ağaçları,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 30,
      "meal": "Uzamış gölgeler,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 31,
      "meal": "Çağlayarak akan sular,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 32,
      "meal": "Sayısız meyveler içindedirler;"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 33,
      "meal": "Tükenmeyen ve yasaklanmayan."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 34,
      "meal": "Ve kabartılmış döşekler üstündedirler."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 35,
      "meal": "Gerçekten biz hurileri apayrı biçimde yeni yarattık."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 36,
      "meal": "Onları, bakireler kıldık."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 37,
      "meal": "Eşlerine düşkün ve yaşıt."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 38,
      "meal": "Bütün bunlar sağdakiler içindir.."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 39,
      "meal": "Bunların birçoğu önceki ümmetlerdendir."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 40,
      "meal": "Birçoğu da sonrakilerdendir."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 41,
      "meal": "Soldakiler; ne yazık o soldakilere!"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 42,
      "meal": "İçlerine işleyen bir ateş ve kaynar su içinde,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 43,
      "meal": "Kapkara dumandan bir gölge altındadırlar;"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 44,
      "meal": "Serin ve hoş olmayan."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 45,
      "meal": "Çünkü onlar bundan önce varlık içinde sefahete dalmışlardı."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 46,
      "meal": "Büyük günahı işlemekte direnir dururlardı."
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 47,
      "meal": "Ve diyorlardı ki: Biz öldükten, toprak ve kemik yığını haline geldikten sonra, biz mi bir daha diriltileceğiz?"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 48,
      "meal": "Önceki atalarımız da mı?"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 49,
      "meal": "De ki: Hem öncekiler hem de sonrakiler,"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 50,
      "meal": "Belli bir günün belli vaktinde mutlaka toplanacaklardır!"
    }
  ]
}