{
  "sayfa_no": 585,
  "ayetler": [
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 1,
      "meal": " (Peygamber), yüzünü ekşitti ve geri döndü."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 2,
      "meal": " Âmanın kendisine gelmesinden ötürü"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 3,
      "meal": " Belki o temizlenecek,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 4,
      "meal": " Yahut öğüt alacak da o öğüt ona fayda verecek."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 5,
      "meal": " Kendini (sana) muhtaç görmeyene gelince,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 6,
      "meal": " Sen ona yöneliyorsun,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 7,
      "meal": "Oysa ki onun temizlenip arınmasından sen sorumlu değilsin."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 8,
      "meal": "Fakat koşarak sana gelen,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 9,
      "meal": "Ve (Allah'tan) korkarak gelenle,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 10,
      "meal": "Sen onunla ilgilenmiyorsun."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 11,
      "meal": "Hayır! Şüphesiz bunlar bir öğüttür,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 12,
      "meal": "Dileyen ondan (Kur'an'dan) öğüt alır,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 13,
      "meal": "O, değerli sahifelerdir,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 14,
      "meal": "Tertemiz kılınmış, yüce makamlara kaldırılmış mukaddes sahifelerde,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 15,
      "meal": "Katiplerin ellerindedir,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 16,
      "meal": "Değerli ve güvenilir katiplerin."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 17,
      "meal": "Kahrolası insan! Ne inkarcıdır!"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 18,
      "meal": "Allah onu neden yarattı?"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 19,
      "meal": "Bir nutfeden (spermadan) yarattı da ona şekil verdi."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 20,
      "meal": "Sonra ona yolu kolaylaştırdı."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 21,
      "meal": "Sonra onun canını aldı ve kabre soktu."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 22,
      "meal": "Sonra dilediği bir vakitte onu yeniden diriltir."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 23,
      "meal": "Hayır! (İnsan) Allah'ın emrettiğini yapmadı."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 24,
      "meal": "İnsan, yediğine bir baksın!"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 25,
      "meal": "Yağmurlar yağdırdık,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 26,
      "meal": "Sonra toprağı göz göz yardık,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 27,
      "meal": "Bu suretle orada ekinler bitirdik,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 28,
      "meal": "Üzümler, yoncalar,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 29,
      "meal": "Zeytinlikler, hurmalıklar,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 30,
      "meal": "İri ve sık ağaçlı bahçeler,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 31,
      "meal": "Meyveler ve çayırlar bitirdik."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 32,
      "meal": "(Bütün bunlar) sizi ve hayvanlarınızı yararlandırmak içindir."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 33,
      "meal": "Kulakları sağır eden o ses geldiğinde,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 34,
      "meal": "İşte o gün kişi kardeşinden, kaçar."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 35,
      "meal": "Annesinden, babasından,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 36,
      "meal": "Eşinden ve çocuklarından."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 37,
      "meal": "O gün, herkesin kendine yetip artacak bir derdi vardır."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 38,
      "meal": "O gün bir takım yüzler parıl parıl,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 39,
      "meal": "Güler ve sevinir."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 40,
      "meal": "Yine o gün birtakım yüzleri de keder bürümüş,"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 41,
      "meal": "Hüzünden kapkara kesilmiştir."
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 42,
      "meal": "İşte bunlar kafirlerdir, günahkarlardır."
    }
  ]
}