{
  "sayfa_no": 576,
  "ayetler": [
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 18,
      "meal": "Zira o, düşündü taşındı, ölçtü biçti."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 19,
      "meal": "Canı çıkasıca, ne biçim ölçtü biçti!"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 20,
      "meal": "Sonra, canı çıkasıca tekrar (ölçtü biçti); nasıl ölçtü biçtiyse!"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 21,
      "meal": "Sonra baktı."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 22,
      "meal": "Sonra kaşlarını çattı, suratını astı."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 23,
      "meal": "En sonunda, kibirini yenemeyip sırt çevirdi."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 24,
      "meal": "\"Bu (Kur'an) dedi, olsa olsa (sihirbazlardan öğrenilip) nakledilen bir sihirdir.\""
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 25,
      "meal": "Bu, insan sözünden başka bir şey değil.\""
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 26,
      "meal": "Ben onu sekara (cehenneme) sokacağım."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 27,
      "meal": "Sen biliyor musun sekar nedir?"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 28,
      "meal": "Hem (bütün bedeni helak eder, hiçbir şey) bırakmaz, hem (eski hale getirip tekrar azap etmekten) vazgeçmez o."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 29,
      "meal": "İnsanın derisini kavurur."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 30,
      "meal": "Üzerinde ondokuz (muhafız melek) vardır."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 31,
      "meal": "Biz cehennemin işlerine bakmakla ancak melekleri görevlendirmişizdir. Onların sayısını da inkarcılar için sadece bir imtihan (vesilesi) yaptık ki, böylelikle, kendilerine kitap verilenler iyiden iyiye öğrensin, iman edenlerin imanını atrttırsın; hem kendilerine kitap verilenler hem müminler şüpheye düşmesinler, kalplerinde hastalık bulunanlar ve kafirler de: \"Allah bu misalle ne demek istemiştir ki?\" desinler. İşte Allah böylece, dilediğini sapıklıkta bırakır, dilediğini doğru yola eriştirir. Rabbinin ordularını, kendisinden başkası bilmez. Bu ise, insanlık için ancak bir öğüttür."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 32,
      "meal": "Hayır hayır (öğüt almazlar). Aya andolsun ki,"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 33,
      "meal": "Dönüp gitmekte olan geceye,"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 34,
      "meal": "Ağarmakta olan sabaha andolsun ki,"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 35,
      "meal": "O (cehennem), büyük musibetlerden biridir."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 36,
      "meal": "İnsanlık için, uyarıcıdır."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 37,
      "meal": "Sizden ileri gitmek ya da geri kalmak isteyen kimseler için (uyarıcıdır)."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 38,
      "meal": "Her nefis, kazandığına karşılık bir rehindir;"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 39,
      "meal": "Ancak sağdakiler başka."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 40,
      "meal": "Onlar cennetler içinde sorarlar."
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 41,
      "meal": "Günahkarların durumunu:"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 42,
      "meal": "\"Sizi şu yakıcı ateşe sokan nedir?\" diye"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 43,
      "meal": "Onlar şöyle cevap verirler: Biz namaz kılanlardan değildik,"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 44,
      "meal": "Yoksulu doyurmuyorduk,"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 45,
      "meal": "(Batıla) dalanlarla birlikte dalıyorduk,"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 46,
      "meal": "Ceza gününü de yalan sayıyorduk,"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 47,
      "meal": "Sonunda bize ölüm geldi çattı."
    }
  ]
}