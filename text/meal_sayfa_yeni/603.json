  "ayetler": [
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 1,
      "meal": "Ey Muhammed! De ki: \"Ey kafirler!"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 2,
      "meal": "\"Ben sizin taptıklarınıza tapmam.\""
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 3,
      "meal": "\"Benim taptıgıma da sizler tapmazsınız.\""
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 4,
      "meal": "\"Ben de sizin taptığınıza tapacak dağilim.\""
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 5,
      "meal": "\"Benim taptığıma da sizler tapmıyorsunuz.\""
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 6,
      "meal": "\"Sizin dininiz size, benim dinim banadır.\""
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 1,
      "meal": "Allah'ın yardımı ve zaferi geldiği,"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 2,
      "meal": "Ve insanların bölük bölük Allah'ın dinine girmekte olduklarını gördüğün vakit,"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 3,
      "meal": "Rabbine hamdederek O'nu tesbih et ve O'ndan mağfiret dile. Çünkü O, tevbeleri çok kabul edendir."
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 1,
      "meal": "Ebu Leheb'in iki eli kurusun! Kurudu da."
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 2,
      "meal": "Malı ve kazandıkları ona fayda vermedi."
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 3,
      "meal": "O, alevli bir ateşte yanacak."
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 4,
      "meal": "Odun taşıyıcı olarak karısı da (ateşe girecek)."
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 5,
      "meal": "Ve boynunda hurma lifinden bükülmüş bir ip olduğu halde."
    }
  ]
