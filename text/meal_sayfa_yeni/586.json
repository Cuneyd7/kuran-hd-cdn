{
  "sayfa_no": 586,
  "ayetler": [
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 1,
      "meal": "Güneş katlanıp dürüldüğünde,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 2,
      "meal": "Yıldızlar (kararıp) döküldüğünde,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 3,
      "meal": "Dağlar (sallanıp) yürütüldüğünde,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 4,
      "meal": "Gebe develer salıverildiğinde,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 5,
      "meal": "Vahşi hayvanlar toplanıp bir araya getirildiğinde,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 6,
      "meal": "Denizler kaynatıldığında,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 7,
      "meal": "Ruhlar (bedenlerle) birleştirildiğinde,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 8,
      "meal": "Diri diri toprağa gömülen kıza, sorulduğunda,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 9,
      "meal": "\"Hangi günah sebebiyle öldürüldü? diye."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 10,
      "meal": "(Amellerin yazılı olduğu) defterler açıldığında,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 11,
      "meal": "Gökyüzü sıyrılıp alındığında,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 12,
      "meal": "Cehennem tutuşturulduğunda,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 13,
      "meal": "Ve cennet yaklaştırıldığında,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 14,
      "meal": "Kişi neler getirdiğini öğrenmiş olacaktır."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 15,
      "meal": "Şimdi yemin ederim o sinenlere,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 16,
      "meal": "O akıp akıp yuvasına gidenlere,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 17,
      "meal": "Kararmaya yüz tuttuğunda geceye andolsun,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 18,
      "meal": "Ağarmaya başladığında sabaha andolsun ki,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 19,
      "meal": "O (Kur'an), şüphesiz değerli, bir elçinin (Cebrail'in) getirdiği sözdür."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 20,
      "meal": "O elçi güçlü, Arş'ın sahibi (Allah'ın) katında çok itibarlıdır."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 21,
      "meal": "O orada sayılan, güvenilen (bir elçi) dir."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 22,
      "meal": "Arkadaşınız (Muhammed) de mecnun değildir."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 23,
      "meal": "Andolsun ki, onu (Cebrail'i) apaçık ufukta görmüştür."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 24,
      "meal": "O, gaybın bilgilerini (sizden) esirgemez."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 25,
      "meal": "O lanetlenmiş şeytanın sözü de değildir."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 26,
      "meal": "Hal böyle iken nereye gidiyorsunuz?"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 27,
      "meal": "O, herkes için, bir öğüttür,"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 28,
      "meal": "Sizden doğru yolda gitmek isteyenler için de."
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 29,
      "meal": "Alemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz."
    }
  ]
}