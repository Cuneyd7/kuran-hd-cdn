{
  "sayfa_no": 592,
  "ayetler": [
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 16,
      "meal": "Fakat siz (ey insanlar! ) dünya hayatını tercih ediyorsunuz."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 17,
      "meal": "Oysa ahiret daha hayırlı daha devamlıdır."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 18,
      "meal": "Şüphesiz bu (anlatılanlar), önceki kitaplarda, vardır."
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 19,
      "meal": "İbrahim ve Musa'nın kitaplarında."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 1,
      "meal": "(Resulüm!) Dehşeti her şeyi kaplayan kıyametin haberi sana geldi mi?"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 2,
      "meal": "O gün bir takım yüzler zelildir,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 3,
      "meal": "Durmadan çalışır, (fakat boşuna) yorulur,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 4,
      "meal": "Kızgın ateşe girer."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 5,
      "meal": "Onlara kaynar su pınarından içirilir."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 6,
      "meal": "Onlar için kuru dikenden başka yemek yoktur,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 7,
      "meal": "O ise ne besler ne de açlığı giderir."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 8,
      "meal": "O gün bir takım yüzler de vardır ki, mutludurlar,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 9,
      "meal": "(dünyadaki) çabalarından hoşnut olmuşlardır,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 10,
      "meal": "Yüce bir cennettedirler."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 11,
      "meal": "Orada boş bir söz işitmezler."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 12,
      "meal": "Orada (cennette) devamlı akan bir pınar,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 13,
      "meal": "Yükseltilmiş tahtlar,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 14,
      "meal": "Konulmuş kadehler,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 15,
      "meal": "Sıra sıra dizilmiş yastıklar,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 16,
      "meal": "Serilmiş halılar vardır."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 17,
      "meal": "(İnsanlar) devenin nasıl yaratıldığına, bakmazlar mı?"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 18,
      "meal": "Göğe bakmıyorlar mı nasıl yükseltilmiş?"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 19,
      "meal": "Dağların nasıl dikildiğine, bakmazlar mı?"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 20,
      "meal": "Yeryüzünün nasıl yayıldığına bir bakmazlar mı?"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 21,
      "meal": "O halde (Resulüm), öğüt ver. Çünkü sen ancak öğüt vericisin."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 22,
      "meal": "Onların üzerinde bir zorba değilsin."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 23,
      "meal": "Ancak yüz çevirir inkar ederse,"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 24,
      "meal": "İşte öylesini Allah en büyük azap ile cezalandırır."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 25,
      "meal": "Şüphesiz onların dönüşü sadece bizedir."
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 26,
      "meal": "Sonra onların sorguya çekilmesi de sadece bize aittir."
    }
  ]
}