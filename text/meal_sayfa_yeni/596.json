{
  "sayfa_no": 596,
  "ayetler": [
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 15,
      "meal": "O ateşe, ancak kötü olan girer."
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 16,
      "meal": "Öyle kötü ki, yalanlayıp ve yüz çevirmiştir."
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 17,
      "meal": "En çok korunan ise ondan (ateşten) uzak tutulur."
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 18,
      "meal": "O ki, Allah yolunda malını verir, temizlenir."
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 19,
      "meal": "Onun nezdinde hiçbir kimseye ait şükranla karşılanacak bir nimet yoktur."
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 20,
      "meal": "O ancak Yüce Rabbinin rızasını aramak için verir."
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 21,
      "meal": "Ve o (buna kavuşarak) hoşnut olacaktır."
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 1,
      "meal": "Andolsun kuşluk vaktine"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 2,
      "meal": "Ve sükuna erdiğinde geceye ki,"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 3,
      "meal": "Rabbin seni bırakmadı ve sana darılmadı."
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 4,
      "meal": "Gerçekten senin için ahiret dünyadan daha hayırlıdır."
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 5,
      "meal": "Pek yakında Rabbin sana verecek de hoşnut olacaksın."
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 6,
      "meal": "O, seni yetim bulup barındırmadı mı?"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 7,
      "meal": "Şaşırmış bulup da yol göstermedi mi?"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 8,
      "meal": "Seni fakir bulup zengin etmedi mi?"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 9,
      "meal": "Öyleyse yetimi sakın ezme."
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 10,
      "meal": "El açıp isteyeni de sakın azarlama."
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 11,
      "meal": "Ve Rabbinin nimetini minnet ve şükranla an."
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 1,
      "meal": "Biz senin göğsünü açıp genişletmedik mi?"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 2,
      "meal": "Yükünü senden alıp atmadık mı?"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 3,
      "meal": "O senin belini büken yükü."
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 4,
      "meal": "Senin şanını ve ününü yüceltmedik mi?"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 5,
      "meal": "Elbette zorluğun yanında bir kolaylık vardır."
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 6,
      "meal": "Gerçekten, zorlukla beraber bir kolaylık daha vardır."
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 7,
      "meal": "Boş kaldın mı hemen (başka) işe koyul,"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 8,
      "meal": "Yalnız Rabbine yönel."
    }
  ]
}