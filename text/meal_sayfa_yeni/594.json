{
  "sayfa_no": 594,
  "ayetler": [
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 24,
      "meal": "(İşte o zaman insan:) \"Keşke bu hayatım için bir şeyler yapıp gönderseydim!\" der."
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 25,
      "meal": "Artık o gün, Allah'ın edeceği azabı kimse edemez."
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 26,
      "meal": "O'nun vuracağı bağı kimse vuramaz."
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 27,
      "meal": "Ey huzura kavuşmuş insan!"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 28,
      "meal": "Sen O'ndan hoşnut, O da senden hoşnut olarak Rabbine dön."
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 29,
      "meal": "(Seçkin) kullarım arasına katıl,"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 30,
      "meal": "Ve cennetim gir."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 1,
      "meal": "Andolsun bu beldeye,"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 2,
      "meal": "Ki sen bu beldedesin,"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 3,
      "meal": "Ve andolsun babaya ve ondan meydana gelen çocuğa,"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 4,
      "meal": "Biz, insanı ( yüzyüze geleceği nice ) zorluklar içinde yarattık."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 5,
      "meal": "İnsan, hiç kimsenin kendisine güç yetiremeyeceğini mi sanıyor?"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 6,
      "meal": "\" Pek çok mal harcadım \" diyor."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 7,
      "meal": "Kimse onu görmedi mi sanıyor?"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 8,
      "meal": "Biz ona iki göz vermedik mi?"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 9,
      "meal": "Bir dil ve iki dudak,"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 10,
      "meal": "Ona iki yolu ( doğru ve eğriyi ) gösterdik."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 11,
      "meal": "Fakat o, sarp yokuşu aşamadı."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 12,
      "meal": "O sarp yokuş nedir bilir misin?"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 13,
      "meal": "Köle azat etmek,"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 14,
      "meal": "Veya açlık gününde yemek yedirmektir,"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 15,
      "meal": "Yakınlığı olan bir yetime."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 16,
      "meal": "Veya hiçbir şeyi olmayan yoksula."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 17,
      "meal": "Sonra iman edenlerden, birbirlerine sabrı tavsiye edenlerden ve birbirlerine acımayı öğütleyenlerden olmaktır."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 18,
      "meal": "İşte bunlar sağdakilerdir."
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 19,
      "meal": "Ayetlerimizi inkar edenler ise işte onlar soldakilerdir,"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 20,
      "meal": "Cezaları, kapıları üzerlerine sımsıkı kapatılmış bir ateştir."
    }
  ]
}