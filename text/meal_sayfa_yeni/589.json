{
  "sayfa_no": 589,
  "ayetler": [
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 35,
      "meal": "Koltuklar üzerinde etrafa bakarlar."
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 36,
      "meal": "Kafirler yaptıklarının cezasını bulduar mı! (Elbette buldular.)"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 1,
      "meal": "Gök yarıldığı,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 2,
      "meal": "Rabbine kulak verip boyun eğecek hale getirildiği zaman,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 3,
      "meal": "Yer dümdüz edildiği,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 4,
      "meal": "İçinde bulunanları atıp boşaldığı,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 5,
      "meal": "Ve Rabb'ini dinleyip O'na hakkıyla itaata mecbur kılındığı vakit (insanoğlu yaptıkları ile karşılaşır)."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 6,
      "meal": "Ey insan! Şüphe yok ki sen Rabbine karşı çaba üstüne çaba göstermektesin; sonunda O'na varacaksın."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 7,
      "meal": "Kimin kitabı sağından verilirse,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 8,
      "meal": "Kolay bir hesapla hesaba çekilecek;"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 9,
      "meal": "Ve sevinçli olarak ailesine dönecektir."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 10,
      "meal": "Kimin de kitabı arkasından verilirse,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 11,
      "meal": "Derhal yok olmayı isteyecek,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 12,
      "meal": "Ve alevli ateşe girecektir."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 13,
      "meal": "Zira o, (dünyada) ailesi içinde (mal-mülk sebebiyle) şımarmıştı."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 14,
      "meal": "O hiçbir zaman Rabbine dönmeyeceğini sandı."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 15,
      "meal": "Oysa gerçekten Rabbi onu görüyordu."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 16,
      "meal": "Hayır! Şafağa, yemin ederim ki,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 17,
      "meal": "Geceye ve onda basan karanlığa,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 18,
      "meal": "Dolunay olmuş aya,"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 19,
      "meal": "Ki, siz elbette halden hale geçeceksiniz."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 20,
      "meal": "Böyleyken onlar acaba neden iman etmezler?"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 21,
      "meal": "Onlar kendilerine Kur'an okununca secde de etmezler."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 22,
      "meal": "Aksine, kafirler yalanlıyorlar."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 23,
      "meal": "Halbuki Allah onların gizlediği şeyleri çok iyi bilir."
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 24,
      "meal": "(Resulüm!) Onlara acı azabı müjdele!"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 25,
      "meal": "İman edip salih amel işleyenler başkadır; onlar için arkası kesilmeyen bir mükafat vardır."
    }
  ]
}