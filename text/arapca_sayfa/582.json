{
  "sayfa_no": 582,
  "ayetler": [
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 2,
      "metin": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 3,
      "metin": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 4,
      "metin": "كَلَّا سَيَعْلَمُونَ"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 5,
      "metin": "ثُمَّ كَلَّا سَيَعْلَمُونَ"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 6,
      "metin": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 7,
      "metin": "وَٱلْجِبَالَ أَوْتَادًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 8,
      "metin": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 9,
      "metin": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 10,
      "metin": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 11,
      "metin": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 12,
      "metin": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 13,
      "metin": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 14,
      "metin": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 15,
      "metin": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 16,
      "metin": "وَجَنَّٰتٍ أَلْفَافًا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 17,
      "metin": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 18,
      "metin": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 19,
      "metin": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 20,
      "metin": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 21,
      "metin": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 22,
      "metin": "لِّلطَّٰغِينَ مَـَٔابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 23,
      "metin": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 24,
      "metin": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 25,
      "metin": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 26,
      "metin": "جَزَآءًۭ وِفَاقًا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 27,
      "metin": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 28,
      "metin": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 29,
      "metin": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 30,
      "metin": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"
    }
  ]
}