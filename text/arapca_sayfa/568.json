{
  "sayfa_no": 568,
  "ayetler": [
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 35,
      "metin": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 36,
      "metin": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 37,
      "metin": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 38,
      "metin": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 39,
      "metin": "وَمَا لَا تُبْصِرُونَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 40,
      "metin": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 41,
      "metin": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 42,
      "metin": "وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 43,
      "metin": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 44,
      "metin": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 45,
      "metin": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 46,
      "metin": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 47,
      "metin": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 48,
      "metin": "وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 49,
      "metin": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 50,
      "metin": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 51,
      "metin": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 52,
      "metin": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 2,
      "metin": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 3,
      "metin": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 4,
      "metin": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 5,
      "metin": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 6,
      "metin": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 7,
      "metin": "وَنَرَىٰهُ قَرِيبًۭا"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 8,
      "metin": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 9,
      "metin": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 10,
      "metin": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا"
    }
  ]
}