{
  "sayfa_no": 449,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 77,
      "metin": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 78,
      "metin": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 79,
      "metin": "سَلَٰمٌ عَلَىٰ نُوحٍۢ فِى ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 80,
      "metin": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 81,
      "metin": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 82,
      "metin": "ثُمَّ أَغْرَقْنَا ٱلْءَاخَرِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 83,
      "metin": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 84,
      "metin": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍۢ سَلِيمٍ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 85,
      "metin": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 86,
      "metin": "أَئِفْكًا ءَالِهَةًۭ دُونَ ٱللَّهِ تُرِيدُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 87,
      "metin": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 88,
      "metin": "فَنَظَرَ نَظْرَةًۭ فِى ٱلنُّجُومِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 89,
      "metin": "فَقَالَ إِنِّى سَقِيمٌۭ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 90,
      "metin": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 91,
      "metin": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 92,
      "metin": "مَا لَكُمْ لَا تَنطِقُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 93,
      "metin": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 94,
      "metin": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 95,
      "metin": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 96,
      "metin": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 97,
      "metin": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَٰنًۭا فَأَلْقُوهُ فِى ٱلْجَحِيمِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 98,
      "metin": "فَأَرَادُوا۟ بِهِۦ كَيْدًۭا فَجَعَلْنَٰهُمُ ٱلْأَسْفَلِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 99,
      "metin": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 100,
      "metin": "رَبِّ هَبْ لِى مِنَ ٱلصَّٰلِحِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 101,
      "metin": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٍۢ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 102,
      "metin": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ"
    }
  ]
}