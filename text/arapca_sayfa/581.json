{
  "sayfa_no": 581,
  "ayetler": [
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 20,
      "metin": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 21,
      "metin": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 22,
      "metin": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 23,
      "metin": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 24,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 25,
      "metin": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 26,
      "metin": "أَحْيَآءًۭ وَأَمْوَٰتًۭا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 27,
      "metin": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 28,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 29,
      "metin": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 30,
      "metin": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 31,
      "metin": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 32,
      "metin": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 33,
      "metin": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 34,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 35,
      "metin": "هَٰذَا يَوْمُ لَا يَنطِقُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 36,
      "metin": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 37,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 38,
      "metin": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 39,
      "metin": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 40,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 41,
      "metin": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 42,
      "metin": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 43,
      "metin": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 44,
      "metin": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 45,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 46,
      "metin": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 47,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 48,
      "metin": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 49,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 50,
      "metin": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"
    }
  ]
}