{
  "sayfa_no": 584,
  "ayetler": [
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 16,
      "metin": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 17,
      "metin": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 18,
      "metin": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 19,
      "metin": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 20,
      "metin": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 21,
      "metin": "فَكَذَّبَ وَعَصَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 22,
      "metin": "ثُمَّ أَدْبَرَ يَسْعَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 23,
      "metin": "فَحَشَرَ فَنَادَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 24,
      "metin": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 25,
      "metin": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 26,
      "metin": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 27,
      "metin": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 28,
      "metin": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 29,
      "metin": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 30,
      "metin": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 31,
      "metin": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 32,
      "metin": "وَٱلْجِبَالَ أَرْسَىٰهَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 33,
      "metin": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 34,
      "metin": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 35,
      "metin": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 36,
      "metin": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 37,
      "metin": "فَأَمَّا مَن طَغَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 38,
      "metin": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 39,
      "metin": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 40,
      "metin": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 41,
      "metin": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 42,
      "metin": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 43,
      "metin": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 44,
      "metin": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 45,
      "metin": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 46,
      "metin": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا"
    }
  ]
}