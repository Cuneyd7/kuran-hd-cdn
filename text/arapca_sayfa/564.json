{
  "sayfa_no": 564,
  "ayetler": [
    {
      "sure_no": 67,
      "sure_adi": "Al-Mulk",
      "ayet_no": 27,
      "metin": "فَلَمَّا رَأَوْهُ زُلْفَةًۭ سِيٓـَٔتْ وُجُوهُ ٱلَّذِينَ كَفَرُوا۟ وَقِيلَ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَدَّعُونَ"
    },
    {
      "sure_no": 67,
      "sure_adi": "Al-Mulk",
      "ayet_no": 28,
      "metin": "قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ ٱللَّهُ وَمَن مَّعِىَ أَوْ رَحِمَنَا فَمَن يُجِيرُ ٱلْكَٰفِرِينَ مِنْ عَذَابٍ أَلِيمٍۢ"
    },
    {
      "sure_no": 67,
      "sure_adi": "Al-Mulk",
      "ayet_no": 29,
      "metin": "قُلْ هُوَ ٱلرَّحْمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَا ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَٰلٍۢ مُّبِينٍۢ"
    },
    {
      "sure_no": 67,
      "sure_adi": "Al-Mulk",
      "ayet_no": 30,
      "metin": "قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ مَآؤُكُمْ غَوْرًۭا فَمَن يَأْتِيكُم بِمَآءٍۢ مَّعِينٍۭ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 2,
      "metin": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 3,
      "metin": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 4,
      "metin": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 5,
      "metin": "فَسَتُبْصِرُ وَيُبْصِرُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 6,
      "metin": "بِأَييِّكُمُ ٱلْمَفْتُونُ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 7,
      "metin": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 8,
      "metin": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 9,
      "metin": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 10,
      "metin": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 11,
      "metin": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 12,
      "metin": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 13,
      "metin": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 14,
      "metin": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 15,
      "metin": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ"
    }
  ]
}