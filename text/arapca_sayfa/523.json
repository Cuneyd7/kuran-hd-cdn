{
  "sayfa_no": 523,
  "ayetler": [
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 52,
      "metin": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 53,
      "metin": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 54,
      "metin": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 55,
      "metin": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 56,
      "metin": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 57,
      "metin": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 58,
      "metin": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 59,
      "metin": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 60,
      "metin": "فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلطُّورِ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 2,
      "metin": "وَكِتَٰبٍۢ مَّسْطُورٍۢ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 3,
      "metin": "فِى رَقٍّۢ مَّنشُورٍۢ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 4,
      "metin": "وَٱلْبَيْتِ ٱلْمَعْمُورِ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 5,
      "metin": "وَٱلسَّقْفِ ٱلْمَرْفُوعِ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 6,
      "metin": "وَٱلْبَحْرِ ٱلْمَسْجُورِ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 7,
      "metin": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌۭ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 8,
      "metin": "مَّا لَهُۥ مِن دَافِعٍۢ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 9,
      "metin": "يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًۭا"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 10,
      "metin": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًۭا"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 11,
      "metin": "فَوَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 12,
      "metin": "ٱلَّذِينَ هُمْ فِى خَوْضٍۢ يَلْعَبُونَ"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 13,
      "metin": "يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 14,
      "metin": "هَٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ"
    }
  ]
}