{
  "sayfa_no": 587,
  "ayetler": [
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 2,
      "metin": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 3,
      "metin": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 4,
      "metin": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 5,
      "metin": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 6,
      "metin": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 7,
      "metin": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 8,
      "metin": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 9,
      "metin": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 10,
      "metin": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 11,
      "metin": "كِرَامًۭا كَٰتِبِينَ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 12,
      "metin": "يَعْلَمُونَ مَا تَفْعَلُونَ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 13,
      "metin": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 14,
      "metin": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 15,
      "metin": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 16,
      "metin": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 17,
      "metin": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 18,
      "metin": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 19,
      "metin": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 2,
      "metin": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 3,
      "metin": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 4,
      "metin": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 5,
      "metin": "لِيَوْمٍ عَظِيمٍۢ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 6,
      "metin": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ"
    }
  ]
}