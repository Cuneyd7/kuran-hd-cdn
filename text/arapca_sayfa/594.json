{
  "sayfa_no": 594,
  "ayetler": [
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 24,
      "metin": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 25,
      "metin": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 26,
      "metin": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 27,
      "metin": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 28,
      "metin": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 29,
      "metin": "فَٱدْخُلِى فِى عِبَٰدِى"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 30,
      "metin": "وَٱدْخُلِى جَنَّتِى"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 2,
      "metin": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 3,
      "metin": "وَوَالِدٍۢ وَمَا وَلَدَ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 4,
      "metin": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 5,
      "metin": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 6,
      "metin": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 7,
      "metin": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 8,
      "metin": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 9,
      "metin": "وَلِسَانًۭا وَشَفَتَيْنِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 10,
      "metin": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 11,
      "metin": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 12,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 13,
      "metin": "فَكُّ رَقَبَةٍ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 14,
      "metin": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 15,
      "metin": "يَتِيمًۭا ذَا مَقْرَبَةٍ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 16,
      "metin": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 17,
      "metin": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 18,
      "metin": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 19,
      "metin": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 20,
      "metin": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ"
    }
  ]
}