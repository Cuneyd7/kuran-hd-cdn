{
  "sayfa_no": 311,
  "ayetler": [
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 77,
      "metin": "أَفَرَءَيْتَ ٱلَّذِى كَفَرَ بِـَٔايَٰتِنَا وَقَالَ لَأُوتَيَنَّ مَالًۭا وَوَلَدًا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 78,
      "metin": "أَطَّلَعَ ٱلْغَيْبَ أَمِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 79,
      "metin": "كَلَّا ۚ سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلْعَذَابِ مَدًّۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 80,
      "metin": "وَنَرِثُهُۥ مَا يَقُولُ وَيَأْتِينَا فَرْدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 81,
      "metin": "وَٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ ءَالِهَةًۭ لِّيَكُونُوا۟ لَهُمْ عِزًّۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 82,
      "metin": "كَلَّا ۚ سَيَكْفُرُونَ بِعِبَادَتِهِمْ وَيَكُونُونَ عَلَيْهِمْ ضِدًّا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 83,
      "metin": "أَلَمْ تَرَ أَنَّآ أَرْسَلْنَا ٱلشَّيَٰطِينَ عَلَى ٱلْكَٰفِرِينَ تَؤُزُّهُمْ أَزًّۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 84,
      "metin": "فَلَا تَعْجَلْ عَلَيْهِمْ ۖ إِنَّمَا نَعُدُّ لَهُمْ عَدًّۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 85,
      "metin": "يَوْمَ نَحْشُرُ ٱلْمُتَّقِينَ إِلَى ٱلرَّحْمَٰنِ وَفْدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 86,
      "metin": "وَنَسُوقُ ٱلْمُجْرِمِينَ إِلَىٰ جَهَنَّمَ وِرْدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 87,
      "metin": "لَّا يَمْلِكُونَ ٱلشَّفَٰعَةَ إِلَّا مَنِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 88,
      "metin": "وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَٰنُ وَلَدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 89,
      "metin": "لَّقَدْ جِئْتُمْ شَيْـًٔا إِدًّۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 90,
      "metin": "تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ وَتَخِرُّ ٱلْجِبَالُ هَدًّا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 91,
      "metin": "أَن دَعَوْا۟ لِلرَّحْمَٰنِ وَلَدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 92,
      "metin": "وَمَا يَنۢبَغِى لِلرَّحْمَٰنِ أَن يَتَّخِذَ وَلَدًا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 93,
      "metin": "إِن كُلُّ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ إِلَّآ ءَاتِى ٱلرَّحْمَٰنِ عَبْدًۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 94,
      "metin": "لَّقَدْ أَحْصَىٰهُمْ وَعَدَّهُمْ عَدًّۭا"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 95,
      "metin": "وَكُلُّهُمْ ءَاتِيهِ يَوْمَ ٱلْقِيَٰمَةِ فَرْدًا"
    }
  ]
}