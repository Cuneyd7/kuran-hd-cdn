{
  "sayfa_no": 452,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 154,
      "metin": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 155,
      "metin": "أَفَلَا تَذَكَّرُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 156,
      "metin": "أَمْ لَكُمْ سُلْطَٰنٌۭ مُّبِينٌۭ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 157,
      "metin": "فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 158,
      "metin": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًۭا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 159,
      "metin": "سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 160,
      "metin": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 161,
      "metin": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 162,
      "metin": "مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 163,
      "metin": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 164,
      "metin": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌۭ مَّعْلُومٌۭ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 165,
      "metin": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 166,
      "metin": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 167,
      "metin": "وَإِن كَانُوا۟ لَيَقُولُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 168,
      "metin": "لَوْ أَنَّ عِندَنَا ذِكْرًۭا مِّنَ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 169,
      "metin": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 170,
      "metin": "فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 171,
      "metin": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 172,
      "metin": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 173,
      "metin": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 174,
      "metin": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 175,
      "metin": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 176,
      "metin": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 177,
      "metin": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 178,
      "metin": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 179,
      "metin": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 180,
      "metin": "سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 181,
      "metin": "وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 182,
      "metin": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"
    }
  ]
}