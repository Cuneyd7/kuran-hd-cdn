{
  "sayfa_no": 498,
  "ayetler": [
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 40,
      "metin": "إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 41,
      "metin": "يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًۭى شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 42,
      "metin": "إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 43,
      "metin": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 44,
      "metin": "طَعَامُ ٱلْأَثِيمِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 45,
      "metin": "كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 46,
      "metin": "كَغَلْىِ ٱلْحَمِيمِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 47,
      "metin": "خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 48,
      "metin": "ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 49,
      "metin": "ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 50,
      "metin": "إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 51,
      "metin": "إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍۢ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 52,
      "metin": "فِى جَنَّٰتٍۢ وَعُيُونٍۢ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 53,
      "metin": "يَلْبَسُونَ مِن سُندُسٍۢ وَإِسْتَبْرَقٍۢ مُّتَقَٰبِلِينَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 54,
      "metin": "كَذَٰلِكَ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍۢ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 55,
      "metin": "يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 56,
      "metin": "لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 57,
      "metin": "فَضْلًۭا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 58,
      "metin": "فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 59,
      "metin": "فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ"
    }
  ]
}