{
  "sayfa_no": 531,
  "ayetler": [
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 50,
      "metin": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌۭ كَلَمْحٍۭ بِٱلْبَصَرِ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 51,
      "metin": "وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍۢ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 52,
      "metin": "وَكُلُّ شَىْءٍۢ فَعَلُوهُ فِى ٱلزُّبُرِ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 53,
      "metin": "وَكُلُّ صَغِيرٍۢ وَكَبِيرٍۢ مُّسْتَطَرٌ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 54,
      "metin": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَهَرٍۢ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 55,
      "metin": "فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍۢ مُّقْتَدِرٍۭ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 2,
      "metin": "عَلَّمَ ٱلْقُرْءَانَ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 3,
      "metin": "خَلَقَ ٱلْإِنسَٰنَ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 4,
      "metin": "عَلَّمَهُ ٱلْبَيَانَ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 5,
      "metin": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 6,
      "metin": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 7,
      "metin": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 8,
      "metin": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 9,
      "metin": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 10,
      "metin": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 11,
      "metin": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 12,
      "metin": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 13,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 14,
      "metin": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 15,
      "metin": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 16,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    }
  ]
}