{
  "sayfa_no": 342,
  "ayetler": [
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قَدْ أَفْلَحَ ٱلْمُؤْمِنُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 2,
      "metin": "ٱلَّذِينَ هُمْ فِى صَلَاتِهِمْ خَٰشِعُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 3,
      "metin": "وَٱلَّذِينَ هُمْ عَنِ ٱللَّغْوِ مُعْرِضُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 4,
      "metin": "وَٱلَّذِينَ هُمْ لِلزَّكَوٰةِ فَٰعِلُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 5,
      "metin": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 6,
      "metin": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 7,
      "metin": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 8,
      "metin": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 9,
      "metin": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَوَٰتِهِمْ يُحَافِظُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 10,
      "metin": "أُو۟لَٰٓئِكَ هُمُ ٱلْوَٰرِثُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 11,
      "metin": "ٱلَّذِينَ يَرِثُونَ ٱلْفِرْدَوْسَ هُمْ فِيهَا خَٰلِدُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 12,
      "metin": "وَلَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ مِن سُلَٰلَةٍۢ مِّن طِينٍۢ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 13,
      "metin": "ثُمَّ جَعَلْنَٰهُ نُطْفَةًۭ فِى قَرَارٍۢ مَّكِينٍۢ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 14,
      "metin": "ثُمَّ خَلَقْنَا ٱلنُّطْفَةَ عَلَقَةًۭ فَخَلَقْنَا ٱلْعَلَقَةَ مُضْغَةًۭ فَخَلَقْنَا ٱلْمُضْغَةَ عِظَٰمًۭا فَكَسَوْنَا ٱلْعِظَٰمَ لَحْمًۭا ثُمَّ أَنشَأْنَٰهُ خَلْقًا ءَاخَرَ ۚ فَتَبَارَكَ ٱللَّهُ أَحْسَنُ ٱلْخَٰلِقِينَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 15,
      "metin": "ثُمَّ إِنَّكُم بَعْدَ ذَٰلِكَ لَمَيِّتُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 16,
      "metin": "ثُمَّ إِنَّكُمْ يَوْمَ ٱلْقِيَٰمَةِ تُبْعَثُونَ"
    },
    {
      "sure_no": 23,
      "sure_adi": "Al-Muminoon",
      "ayet_no": 17,
      "metin": "وَلَقَدْ خَلَقْنَا فَوْقَكُمْ سَبْعَ طَرَآئِقَ وَمَا كُنَّا عَنِ ٱلْخَلْقِ غَٰفِلِينَ"
    }
  ]
}