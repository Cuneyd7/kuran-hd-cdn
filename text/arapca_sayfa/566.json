{
  "sayfa_no": 566,
  "ayetler": [
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 43,
      "metin": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 44,
      "metin": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 45,
      "metin": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 46,
      "metin": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 47,
      "metin": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 48,
      "metin": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 49,
      "metin": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 50,
      "metin": "فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 51,
      "metin": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 52,
      "metin": "وَمَا هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 2,
      "metin": "مَا ٱلْحَآقَّةُ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 3,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 4,
      "metin": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 5,
      "metin": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 6,
      "metin": "وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 7,
      "metin": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 8,
      "metin": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ"
    }
  ]
}