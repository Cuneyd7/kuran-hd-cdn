{
  "sayfa_no": 528,
  "ayetler": [
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 45,
      "metin": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 46,
      "metin": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 47,
      "metin": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 48,
      "metin": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 49,
      "metin": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 50,
      "metin": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 51,
      "metin": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 52,
      "metin": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 53,
      "metin": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 54,
      "metin": "فَغَشَّىٰهَا مَا غَشَّىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 55,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 56,
      "metin": "هَٰذَا نَذِيرٌۭ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 57,
      "metin": "أَزِفَتِ ٱلْءَازِفَةُ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 58,
      "metin": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 59,
      "metin": "أَفَمِنْ هَٰذَا ٱلْحَدِيثِ تَعْجَبُونَ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 60,
      "metin": "وَتَضْحَكُونَ وَلَا تَبْكُونَ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 61,
      "metin": "وَأَنتُمْ سَٰمِدُونَ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 62,
      "metin": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 2,
      "metin": "وَإِن يَرَوْا۟ ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 3,
      "metin": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 4,
      "metin": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 5,
      "metin": "حِكْمَةٌۢ بَٰلِغَةٌۭ ۖ فَمَا تُغْنِ ٱلنُّذُرُ"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 6,
      "metin": "فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍۢ نُّكُرٍ"
    }
  ]
}