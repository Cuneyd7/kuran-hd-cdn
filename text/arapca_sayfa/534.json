      "ayet_no": 72,
      "metin": "حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 73,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 74,
      "metin": "لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 75,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 76,
      "metin": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 77,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 78,
      "metin": "تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 2,
      "metin": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 3,
      "metin": "خَافِضَةٌۭ رَّافِعَةٌ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 4,
      "metin": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 5,
      "metin": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 6,
      "metin": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 7,
      "metin": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 8,
      "metin": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 9,
      "metin": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 10,
      "metin": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 11,
      "metin": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 12,
      "metin": "فِى جَنَّٰتِ ٱلنَّعِيمِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 13,
      "metin": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 14,
      "metin": "وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 15,
      "metin": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 16,
      "metin": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ"
    }
  ]
}