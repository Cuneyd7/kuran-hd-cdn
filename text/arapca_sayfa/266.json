{
  "sayfa_no": 266,
  "ayetler": [
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 71,
      "metin": "قَالَ هَٰٓؤُلَآءِ بَنَاتِىٓ إِن كُنتُمْ فَٰعِلِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 72,
      "metin": "لَعَمْرُكَ إِنَّهُمْ لَفِى سَكْرَتِهِمْ يَعْمَهُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 73,
      "metin": "فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُشْرِقِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 74,
      "metin": "فَجَعَلْنَا عَٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةًۭ مِّن سِجِّيلٍ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 75,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍۢ لِّلْمُتَوَسِّمِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 76,
      "metin": "وَإِنَّهَا لَبِسَبِيلٍۢ مُّقِيمٍ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 77,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ لِّلْمُؤْمِنِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 78,
      "metin": "وَإِن كَانَ أَصْحَٰبُ ٱلْأَيْكَةِ لَظَٰلِمِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 79,
      "metin": "فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍۢ مُّبِينٍۢ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 80,
      "metin": "وَلَقَدْ كَذَّبَ أَصْحَٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 81,
      "metin": "وَءَاتَيْنَٰهُمْ ءَايَٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 82,
      "metin": "وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 83,
      "metin": "فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 84,
      "metin": "فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 85,
      "metin": "وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ ۗ وَإِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌۭ ۖ فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 86,
      "metin": "إِنَّ رَبَّكَ هُوَ ٱلْخَلَّٰقُ ٱلْعَلِيمُ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 87,
      "metin": "وَلَقَدْ ءَاتَيْنَٰكَ سَبْعًۭا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 88,
      "metin": "لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًۭا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 89,
      "metin": "وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 90,
      "metin": "كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ"
    }
  ]
}