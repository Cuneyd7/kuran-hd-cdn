{
  "sayfa_no": 448,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 52,
      "metin": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 53,
      "metin": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 54,
      "metin": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 55,
      "metin": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 56,
      "metin": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 57,
      "metin": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 58,
      "metin": "أَفَمَا نَحْنُ بِمَيِّتِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 59,
      "metin": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 60,
      "metin": "إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 61,
      "metin": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 62,
      "metin": "أَذَٰلِكَ خَيْرٌۭ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 63,
      "metin": "إِنَّا جَعَلْنَٰهَا فِتْنَةًۭ لِّلظَّٰلِمِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 64,
      "metin": "إِنَّهَا شَجَرَةٌۭ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 65,
      "metin": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 66,
      "metin": "فَإِنَّهُمْ لَءَاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 67,
      "metin": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًۭا مِّنْ حَمِيمٍۢ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 68,
      "metin": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 69,
      "metin": "إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 70,
      "metin": "فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 71,
      "metin": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 72,
      "metin": "وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 73,
      "metin": "فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 74,
      "metin": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 75,
      "metin": "وَلَقَدْ نَادَىٰنَا نُوحٌۭ فَلَنِعْمَ ٱلْمُجِيبُونَ"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 76,
      "metin": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"
    }
  ]
}