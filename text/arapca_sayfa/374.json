{
  "sayfa_no": 374,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 160,
      "metin": "كَذَّبَتْ قَوْمُ لُوطٍ ٱلْمُرْسَلِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 161,
      "metin": "إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّقُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 162,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 163,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 164,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 165,
      "metin": "أَتَأْتُونَ ٱلذُّكْرَانَ مِنَ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 166,
      "metin": "وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنْ أَزْوَٰجِكُم ۚ بَلْ أَنتُمْ قَوْمٌ عَادُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 167,
      "metin": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ ٱلْمُخْرَجِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 168,
      "metin": "قَالَ إِنِّى لِعَمَلِكُم مِّنَ ٱلْقَالِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 169,
      "metin": "رَبِّ نَجِّنِى وَأَهْلِى مِمَّا يَعْمَلُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 170,
      "metin": "فَنَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 171,
      "metin": "إِلَّا عَجُوزًۭا فِى ٱلْغَٰبِرِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 172,
      "metin": "ثُمَّ دَمَّرْنَا ٱلْءَاخَرِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 173,
      "metin": "وَأَمْطَرْنَا عَلَيْهِم مَّطَرًۭا ۖ فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 174,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 175,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 176,
      "metin": "كَذَّبَ أَصْحَٰبُ لْـَٔيْكَةِ ٱلْمُرْسَلِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 177,
      "metin": "إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 178,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 179,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 180,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 181,
      "metin": "۞ أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 182,
      "metin": "وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 183,
      "metin": "وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ"
    }
  ]
}