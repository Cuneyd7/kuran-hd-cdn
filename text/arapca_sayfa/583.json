{
  "sayfa_no": 583,
  "ayetler": [
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 31,
      "metin": "إِنَّ لِلْمُتَّقِينَ مَفَازًا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 32,
      "metin": "حَدَآئِقَ وَأَعْنَٰبًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 33,
      "metin": "وَكَوَاعِبَ أَتْرَابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 34,
      "metin": "وَكَأْسًۭا دِهَاقًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 35,
      "metin": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 36,
      "metin": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 37,
      "metin": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 38,
      "metin": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 39,
      "metin": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 40,
      "metin": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 2,
      "metin": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 3,
      "metin": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 4,
      "metin": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 5,
      "metin": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 6,
      "metin": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 7,
      "metin": "تَتْبَعُهَا ٱلرَّادِفَةُ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 8,
      "metin": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 9,
      "metin": "أَبْصَٰرُهَا خَٰشِعَةٌۭ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 10,
      "metin": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 11,
      "metin": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 12,
      "metin": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 13,
      "metin": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 14,
      "metin": "فَإِذَا هُم بِٱلسَّاهِرَةِ"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 15,
      "metin": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"
    }
  ]
}