{
  "sayfa_no": 535,
  "ayetler": [
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 17,
      "metin": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 18,
      "metin": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 19,
      "metin": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 20,
      "metin": "وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 21,
      "metin": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 22,
      "metin": "وَحُورٌ عِينٌۭ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 23,
      "metin": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 24,
      "metin": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 25,
      "metin": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 26,
      "metin": "إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 27,
      "metin": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 28,
      "metin": "فِى سِدْرٍۢ مَّخْضُودٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 29,
      "metin": "وَطَلْحٍۢ مَّنضُودٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 30,
      "metin": "وَظِلٍّۢ مَّمْدُودٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 31,
      "metin": "وَمَآءٍۢ مَّسْكُوبٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 32,
      "metin": "وَفَٰكِهَةٍۢ كَثِيرَةٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 33,
      "metin": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 34,
      "metin": "وَفُرُشٍۢ مَّرْفُوعَةٍ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 35,
      "metin": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 36,
      "metin": "فَجَعَلْنَٰهُنَّ أَبْكَارًا"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 37,
      "metin": "عُرُبًا أَتْرَابًۭا"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 38,
      "metin": "لِّأَصْحَٰبِ ٱلْيَمِينِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 39,
      "metin": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 40,
      "metin": "وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 41,
      "metin": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 42,
      "metin": "فِى سَمُومٍۢ وَحَمِيمٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 43,
      "metin": "وَظِلٍّۢ مِّن يَحْمُومٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 44,
      "metin": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 45,
      "metin": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 46,
      "metin": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 47,
      "metin": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 48,
      "metin": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 49,
      "metin": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 50,
      "metin": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ"
    }
  ]
}