{
  "sayfa_no": 595,
  "ayetler": [
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 2,
      "metin": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 3,
      "metin": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 4,
      "metin": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 5,
      "metin": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 6,
      "metin": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 7,
      "metin": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 8,
      "metin": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 9,
      "metin": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 10,
      "metin": "وَقَدْ خَابَ مَن دَسَّىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 11,
      "metin": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 12,
      "metin": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 13,
      "metin": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 14,
      "metin": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 15,
      "metin": "وَلَا يَخَافُ عُقْبَٰهَا"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 2,
      "metin": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 3,
      "metin": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 4,
      "metin": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 5,
      "metin": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 6,
      "metin": "وَصَدَّقَ بِٱلْحُسْنَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 7,
      "metin": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 8,
      "metin": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 9,
      "metin": "وَكَذَّبَ بِٱلْحُسْنَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 10,
      "metin": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 11,
      "metin": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 12,
      "metin": "إِنَّ عَلَيْنَا لَلْهُدَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 13,
      "metin": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 14,
      "metin": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ"
    }
  ]
}