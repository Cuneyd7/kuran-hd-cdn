{
  "sayfa_no": 578,
  "ayetler": [
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 20,
      "metin": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 21,
      "metin": "وَتَذَرُونَ ٱلْءَاخِرَةَ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 22,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 23,
      "metin": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 24,
      "metin": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 25,
      "metin": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 26,
      "metin": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 27,
      "metin": "وَقِيلَ مَنْ ۜ رَاقٍۢ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 28,
      "metin": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 29,
      "metin": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 30,
      "metin": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 31,
      "metin": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 32,
      "metin": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 33,
      "metin": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 34,
      "metin": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 35,
      "metin": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 36,
      "metin": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 37,
      "metin": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 38,
      "metin": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 39,
      "metin": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 40,
      "metin": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰ عَلَى ٱلْإِنسَٰنِ حِينٌۭ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًۭٔا مَّذْكُورًا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 2,
      "metin": "إِنَّا خَلَقْنَا ٱلْإِنسَٰنَ مِن نُّطْفَةٍ أَمْشَاجٍۢ نَّبْتَلِيهِ فَجَعَلْنَٰهُ سَمِيعًۢا بَصِيرًا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 3,
      "metin": "إِنَّا هَدَيْنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًۭا وَإِمَّا كَفُورًا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 4,
      "metin": "إِنَّآ أَعْتَدْنَا لِلْكَٰفِرِينَ سَلَٰسِلَا۟ وَأَغْلَٰلًۭا وَسَعِيرًا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 5,
      "metin": "إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍۢ كَانَ مِزَاجُهَا كَافُورًا"
    }
  ]
}