{
  "sayfa_no": 373,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 137,
      "metin": "إِنْ هَٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 138,
      "metin": "وَمَا نَحْنُ بِمُعَذَّبِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 139,
      "metin": "فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمْ ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 140,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 141,
      "metin": "كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 142,
      "metin": "إِذْ قَالَ لَهُمْ أَخُوهُمْ صَٰلِحٌ أَلَا تَتَّقُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 143,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 144,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 145,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 146,
      "metin": "أَتُتْرَكُونَ فِى مَا هَٰهُنَآ ءَامِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 147,
      "metin": "فِى جَنَّٰتٍۢ وَعُيُونٍۢ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 148,
      "metin": "وَزُرُوعٍۢ وَنَخْلٍۢ طَلْعُهَا هَضِيمٌۭ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 149,
      "metin": "وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًۭا فَٰرِهِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 150,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 151,
      "metin": "وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 152,
      "metin": "ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 153,
      "metin": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 154,
      "metin": "مَآ أَنتَ إِلَّا بَشَرٌۭ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 155,
      "metin": "قَالَ هَٰذِهِۦ نَاقَةٌۭ لَّهَا شِرْبٌۭ وَلَكُمْ شِرْبُ يَوْمٍۢ مَّعْلُومٍۢ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 156,
      "metin": "وَلَا تَمَسُّوهَا بِسُوٓءٍۢ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٍۢ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 157,
      "metin": "فَعَقَرُوهَا فَأَصْبَحُوا۟ نَٰدِمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 158,
      "metin": "فَأَخَذَهُمُ ٱلْعَذَابُ ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 159,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    }
  ]
}