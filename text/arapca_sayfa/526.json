{
  "sayfa_no": 526,
  "ayetler": [
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّجْمِ إِذَا هَوَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 2,
      "metin": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 3,
      "metin": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 4,
      "metin": "إِنْ هُوَ إِلَّا وَحْىٌۭ يُوحَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 5,
      "metin": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 6,
      "metin": "ذُو مِرَّةٍۢ فَٱسْتَوَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 7,
      "metin": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 8,
      "metin": "ثُمَّ دَنَا فَتَدَلَّىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 9,
      "metin": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 10,
      "metin": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 11,
      "metin": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 12,
      "metin": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 13,
      "metin": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 14,
      "metin": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 15,
      "metin": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 16,
      "metin": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 17,
      "metin": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 18,
      "metin": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 19,
      "metin": "أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 20,
      "metin": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 21,
      "metin": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 22,
      "metin": "تِلْكَ إِذًۭا قِسْمَةٌۭ ضِيزَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 23,
      "metin": "إِنْ هِىَ إِلَّآ أَسْمَآءٌۭ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 24,
      "metin": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 25,
      "metin": "فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 26,
      "metin": "۞ وَكَم مِّن مَّلَكٍۢ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ"
    }
  ]
}