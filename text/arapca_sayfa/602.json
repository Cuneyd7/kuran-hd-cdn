{
  "sayfa_no": 602,
  "ayetler": [
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ"
    },
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 2,
      "metin": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"
    },
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 3,
      "metin": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ"
    },
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 4,
      "metin": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 2,
      "metin": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 3,
      "metin": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 4,
      "metin": "فَوَيْلٌۭ لِّلْمُصَلِّينَ"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 5,
      "metin": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 6,
      "metin": "ٱلَّذِينَ هُمْ يُرَآءُونَ"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 7,
      "metin": "وَيَمْنَعُونَ ٱلْمَاعُونَ"
    },
    {
      "sure_no": 108,
      "sure_adi": "Al-Kawthar",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ"
    },
    {
      "sure_no": 108,
      "sure_adi": "Al-Kawthar",
      "ayet_no": 2,
      "metin": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"
    },
    {
      "sure_no": 108,
      "sure_adi": "Al-Kawthar",
      "ayet_no": 3,
      "metin": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"
    }
  ]
}