{
  "sayfa_no": 496,
  "ayetler": [
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ حمٓ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 2,
      "metin": "وَٱلْكِتَٰبِ ٱلْمُبِينِ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 3,
      "metin": "إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةٍۢ مُّبَٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 4,
      "metin": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 5,
      "metin": "أَمْرًۭا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 6,
      "metin": "رَحْمَةًۭ مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 7,
      "metin": "رَبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 8,
      "metin": "لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 9,
      "metin": "بَلْ هُمْ فِى شَكٍّۢ يَلْعَبُونَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 10,
      "metin": "فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍۢ مُّبِينٍۢ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 11,
      "metin": "يَغْشَى ٱلنَّاسَ ۖ هَٰذَا عَذَابٌ أَلِيمٌۭ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 12,
      "metin": "رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 13,
      "metin": "أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌۭ مُّبِينٌۭ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 14,
      "metin": "ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌۭ مَّجْنُونٌ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 15,
      "metin": "إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 16,
      "metin": "يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 17,
      "metin": "۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌۭ كَرِيمٌ"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 18,
      "metin": "أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ"
    }
  ]
}