{
  "sayfa_no": 596,
  "ayetler": [
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 15,
      "metin": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 16,
      "metin": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 17,
      "metin": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 18,
      "metin": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 19,
      "metin": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 20,
      "metin": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 21,
      "metin": "وَلَسَوْفَ يَرْضَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 2,
      "metin": "وَٱلَّيْلِ إِذَا سَجَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 3,
      "metin": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 4,
      "metin": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 5,
      "metin": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 6,
      "metin": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 7,
      "metin": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 8,
      "metin": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 9,
      "metin": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 10,
      "metin": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 11,
      "metin": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 2,
      "metin": "وَوَضَعْنَا عَنكَ وِزْرَكَ"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 3,
      "metin": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 4,
      "metin": "وَرَفَعْنَا لَكَ ذِكْرَكَ"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 5,
      "metin": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 6,
      "metin": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 7,
      "metin": "فَإِذَا فَرَغْتَ فَٱنصَبْ"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 8,
      "metin": "وَإِلَىٰ رَبِّكَ فَٱرْغَب"
    }
  ]
}