{
  "sayfa_no": 456,
  "ayetler": [
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 43,
      "metin": "وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ رَحْمَةًۭ مِّنَّا وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَٰبِ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 44,
      "metin": "وَخُذْ بِيَدِكَ ضِغْثًۭا فَٱضْرِب بِّهِۦ وَلَا تَحْنَثْ ۗ إِنَّا وَجَدْنَٰهُ صَابِرًۭا ۚ نِّعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ أَوَّابٌۭ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 45,
      "metin": "وَٱذْكُرْ عِبَٰدَنَآ إِبْرَٰهِيمَ وَإِسْحَٰقَ وَيَعْقُوبَ أُو۟لِى ٱلْأَيْدِى وَٱلْأَبْصَٰرِ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 46,
      "metin": "إِنَّآ أَخْلَصْنَٰهُم بِخَالِصَةٍۢ ذِكْرَى ٱلدَّارِ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 47,
      "metin": "وَإِنَّهُمْ عِندَنَا لَمِنَ ٱلْمُصْطَفَيْنَ ٱلْأَخْيَارِ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 48,
      "metin": "وَٱذْكُرْ إِسْمَٰعِيلَ وَٱلْيَسَعَ وَذَا ٱلْكِفْلِ ۖ وَكُلٌّۭ مِّنَ ٱلْأَخْيَارِ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 49,
      "metin": "هَٰذَا ذِكْرٌۭ ۚ وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ مَـَٔابٍۢ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 50,
      "metin": "جَنَّٰتِ عَدْنٍۢ مُّفَتَّحَةًۭ لَّهُمُ ٱلْأَبْوَٰبُ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 51,
      "metin": "مُتَّكِـِٔينَ فِيهَا يَدْعُونَ فِيهَا بِفَٰكِهَةٍۢ كَثِيرَةٍۢ وَشَرَابٍۢ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 52,
      "metin": "۞ وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ أَتْرَابٌ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 53,
      "metin": "هَٰذَا مَا تُوعَدُونَ لِيَوْمِ ٱلْحِسَابِ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 54,
      "metin": "إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُۥ مِن نَّفَادٍ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 55,
      "metin": "هَٰذَا ۚ وَإِنَّ لِلطَّٰغِينَ لَشَرَّ مَـَٔابٍۢ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 56,
      "metin": "جَهَنَّمَ يَصْلَوْنَهَا فَبِئْسَ ٱلْمِهَادُ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 57,
      "metin": "هَٰذَا فَلْيَذُوقُوهُ حَمِيمٌۭ وَغَسَّاقٌۭ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 58,
      "metin": "وَءَاخَرُ مِن شَكْلِهِۦٓ أَزْوَٰجٌ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 59,
      "metin": "هَٰذَا فَوْجٌۭ مُّقْتَحِمٌۭ مَّعَكُمْ ۖ لَا مَرْحَبًۢا بِهِمْ ۚ إِنَّهُمْ صَالُوا۟ ٱلنَّارِ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 60,
      "metin": "قَالُوا۟ بَلْ أَنتُمْ لَا مَرْحَبًۢا بِكُمْ ۖ أَنتُمْ قَدَّمْتُمُوهُ لَنَا ۖ فَبِئْسَ ٱلْقَرَارُ"
    },
    {
      "sure_no": 38,
      "sure_adi": "Saad",
      "ayet_no": 61,
      "metin": "قَالُوا۟ رَبَّنَا مَن قَدَّمَ لَنَا هَٰذَا فَزِدْهُ عَذَابًۭا ضِعْفًۭا فِى ٱلنَّارِ"
    }
  ]
}