{
  "sayfa_no": 597,
  "ayetler": [
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 1,
      "metin": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 2,
      "metin": "وَطُورِ سِينِينَ"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 3,
      "metin": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 4,
      "metin": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 5,
      "metin": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 6,
      "metin": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 7,
      "metin": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 8,
      "metin": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 2,
      "metin": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 3,
      "metin": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 4,
      "metin": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 5,
      "metin": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 6,
      "metin": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 7,
      "metin": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 8,
      "metin": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 9,
      "metin": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 10,
      "metin": "عَبْدًا إِذَا صَلَّىٰٓ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 11,
      "metin": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 12,
      "metin": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 13,
      "metin": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 14,
      "metin": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 15,
      "metin": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 16,
      "metin": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 17,
      "metin": "فَلْيَدْعُ نَادِيَهُۥ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 18,
      "metin": "سَنَدْعُ ٱلزَّبَانِيَةَ"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 19,
      "metin": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"
    }
  ]
}