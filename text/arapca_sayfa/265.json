{
  "sayfa_no": 265,
  "ayetler": [
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 52,
      "metin": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَٰمًۭا قَالَ إِنَّا مِنكُمْ وَجِلُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 53,
      "metin": "قَالُوا۟ لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمٍۢ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 54,
      "metin": "قَالَ أَبَشَّرْتُمُونِى عَلَىٰٓ أَن مَّسَّنِىَ ٱلْكِبَرُ فَبِمَ تُبَشِّرُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 55,
      "metin": "قَالُوا۟ بَشَّرْنَٰكَ بِٱلْحَقِّ فَلَا تَكُن مِّنَ ٱلْقَٰنِطِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 56,
      "metin": "قَالَ وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 57,
      "metin": "قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 58,
      "metin": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍۢ مُّجْرِمِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 59,
      "metin": "إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمْ أَجْمَعِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 60,
      "metin": "إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَآ ۙ إِنَّهَا لَمِنَ ٱلْغَٰبِرِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 61,
      "metin": "فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلْمُرْسَلُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 62,
      "metin": "قَالَ إِنَّكُمْ قَوْمٌۭ مُّنكَرُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 63,
      "metin": "قَالُوا۟ بَلْ جِئْنَٰكَ بِمَا كَانُوا۟ فِيهِ يَمْتَرُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 64,
      "metin": "وَأَتَيْنَٰكَ بِٱلْحَقِّ وَإِنَّا لَصَٰدِقُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 65,
      "metin": "فَأَسْرِ بِأَهْلِكَ بِقِطْعٍۢ مِّنَ ٱلَّيْلِ وَٱتَّبِعْ أَدْبَٰرَهُمْ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌۭ وَٱمْضُوا۟ حَيْثُ تُؤْمَرُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 66,
      "metin": "وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ أَنَّ دَابِرَ هَٰٓؤُلَآءِ مَقْطُوعٌۭ مُّصْبِحِينَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 67,
      "metin": "وَجَآءَ أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 68,
      "metin": "قَالَ إِنَّ هَٰٓؤُلَآءِ ضَيْفِى فَلَا تَفْضَحُونِ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 69,
      "metin": "وَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 70,
      "metin": "قَالُوٓا۟ أَوَلَمْ نَنْهَكَ عَنِ ٱلْعَٰلَمِينَ"
    }
  ]
}