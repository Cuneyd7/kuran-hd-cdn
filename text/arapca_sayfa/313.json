{
  "sayfa_no": 313,
  "ayetler": [
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 13,
      "metin": "وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 14,
      "metin": "إِنَّنِىٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 15,
      "metin": "إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا تَسْعَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 16,
      "metin": "فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 17,
      "metin": "وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوسَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 18,
      "metin": "قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 19,
      "metin": "قَالَ أَلْقِهَا يَٰمُوسَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 20,
      "metin": "فَأَلْقَىٰهَا فَإِذَا هِىَ حَيَّةٌۭ تَسْعَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 21,
      "metin": "قَالَ خُذْهَا وَلَا تَخَفْ ۖ سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 22,
      "metin": "وَٱضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 23,
      "metin": "لِنُرِيَكَ مِنْ ءَايَٰتِنَا ٱلْكُبْرَى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 24,
      "metin": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 25,
      "metin": "قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 26,
      "metin": "وَيَسِّرْ لِىٓ أَمْرِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 27,
      "metin": "وَٱحْلُلْ عُقْدَةًۭ مِّن لِّسَانِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 28,
      "metin": "يَفْقَهُوا۟ قَوْلِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 29,
      "metin": "وَٱجْعَل لِّى وَزِيرًۭا مِّنْ أَهْلِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 30,
      "metin": "هَٰرُونَ أَخِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 31,
      "metin": "ٱشْدُدْ بِهِۦٓ أَزْرِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 32,
      "metin": "وَأَشْرِكْهُ فِىٓ أَمْرِى"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 33,
      "metin": "كَىْ نُسَبِّحَكَ كَثِيرًۭا"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 34,
      "metin": "وَنَذْكُرَكَ كَثِيرًا"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 35,
      "metin": "إِنَّكَ كُنتَ بِنَا بَصِيرًۭا"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 36,
      "metin": "قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَٰمُوسَىٰ"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 37,
      "metin": "وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً أُخْرَىٰٓ"
    }
  ]
}