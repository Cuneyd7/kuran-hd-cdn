{
  "sayfa_no": 577,
  "ayetler": [
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 48,
      "metin": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 49,
      "metin": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 50,
      "metin": "كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 51,
      "metin": "فَرَّتْ مِن قَسْوَرَةٍۭ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 52,
      "metin": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 53,
      "metin": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 54,
      "metin": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 55,
      "metin": "فَمَن شَآءَ ذَكَرَهُۥ"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 56,
      "metin": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 2,
      "metin": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 3,
      "metin": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 4,
      "metin": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 5,
      "metin": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 6,
      "metin": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 7,
      "metin": "فَإِذَا بَرِقَ ٱلْبَصَرُ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 8,
      "metin": "وَخَسَفَ ٱلْقَمَرُ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 9,
      "metin": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 10,
      "metin": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 11,
      "metin": "كَلَّا لَا وَزَرَ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 12,
      "metin": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 13,
      "metin": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 14,
      "metin": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 15,
      "metin": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 16,
      "metin": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 17,
      "metin": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 18,
      "metin": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 19,
      "metin": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"
    }
  ]
}