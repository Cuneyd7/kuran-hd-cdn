{
  "sayfa_no": 601,
  "ayetler": [
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ"
    },
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 2,
      "metin": "إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ"
    },
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 3,
      "metin": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 2,
      "metin": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 3,
      "metin": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 4,
      "metin": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 5,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 6,
      "metin": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 7,
      "metin": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 8,
      "metin": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 9,
      "metin": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 2,
      "metin": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 3,
      "metin": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 4,
      "metin": "تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 5,
      "metin": "فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ"
    }
  ]
}