{
  "sayfa_no": 569,
  "ayetler": [
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 11,
      "metin": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 12,
      "metin": "وَصَٰحِبَتِهِۦ وَأَخِيهِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 13,
      "metin": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 14,
      "metin": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 15,
      "metin": "كَلَّآ ۖ إِنَّهَا لَظَىٰ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 16,
      "metin": "نَزَّاعَةًۭ لِّلشَّوَىٰ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 17,
      "metin": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 18,
      "metin": "وَجَمَعَ فَأَوْعَىٰٓ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 19,
      "metin": "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 20,
      "metin": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 21,
      "metin": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 22,
      "metin": "إِلَّا ٱلْمُصَلِّينَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 23,
      "metin": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 24,
      "metin": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 25,
      "metin": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 26,
      "metin": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 27,
      "metin": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 28,
      "metin": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 29,
      "metin": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 30,
      "metin": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 31,
      "metin": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 32,
      "metin": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 33,
      "metin": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 34,
      "metin": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 35,
      "metin": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 36,
      "metin": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 37,
      "metin": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 38,
      "metin": "أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 39,
      "metin": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ"
    }
  ]
}