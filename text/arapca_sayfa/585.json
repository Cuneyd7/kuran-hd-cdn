{
  "sayfa_no": 585,
  "ayetler": [
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 2,
      "metin": "أَن جَآءَهُ ٱلْأَعْمَىٰ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 3,
      "metin": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 4,
      "metin": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 5,
      "metin": "أَمَّا مَنِ ٱسْتَغْنَىٰ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 6,
      "metin": "فَأَنتَ لَهُۥ تَصَدَّىٰ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 7,
      "metin": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 8,
      "metin": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 9,
      "metin": "وَهُوَ يَخْشَىٰ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 10,
      "metin": "فَأَنتَ عَنْهُ تَلَهَّىٰ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 11,
      "metin": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 12,
      "metin": "فَمَن شَآءَ ذَكَرَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 13,
      "metin": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 14,
      "metin": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 15,
      "metin": "بِأَيْدِى سَفَرَةٍۢ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 16,
      "metin": "كِرَامٍۭ بَرَرَةٍۢ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 17,
      "metin": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 18,
      "metin": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 19,
      "metin": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 20,
      "metin": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 21,
      "metin": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 22,
      "metin": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 23,
      "metin": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 24,
      "metin": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 25,
      "metin": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 26,
      "metin": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 27,
      "metin": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 28,
      "metin": "وَعِنَبًۭا وَقَضْبًۭا"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 29,
      "metin": "وَزَيْتُونًۭا وَنَخْلًۭا"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 30,
      "metin": "وَحَدَآئِقَ غُلْبًۭا"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 31,
      "metin": "وَفَٰكِهَةًۭ وَأَبًّۭا"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 32,
      "metin": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 33,
      "metin": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 34,
      "metin": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 35,
      "metin": "وَأُمِّهِۦ وَأَبِيهِ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 36,
      "metin": "وَصَٰحِبَتِهِۦ وَبَنِيهِ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 37,
      "metin": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 38,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 39,
      "metin": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 40,
      "metin": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 41,
      "metin": "تَرْهَقُهَا قَتَرَةٌ"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 42,
      "metin": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"
    }
  ]
}