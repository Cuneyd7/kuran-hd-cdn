{
  "sayfa_no": 565,
  "ayetler": [
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 16,
      "metin": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 17,
      "metin": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 18,
      "metin": "وَلَا يَسْتَثْنُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 19,
      "metin": "فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 20,
      "metin": "فَأَصْبَحَتْ كَٱلصَّرِيمِ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 21,
      "metin": "فَتَنَادَوْا۟ مُصْبِحِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 22,
      "metin": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 23,
      "metin": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 24,
      "metin": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 25,
      "metin": "وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 26,
      "metin": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 27,
      "metin": "بَلْ نَحْنُ مَحْرُومُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 28,
      "metin": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 29,
      "metin": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 30,
      "metin": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 31,
      "metin": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 32,
      "metin": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 33,
      "metin": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 34,
      "metin": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 35,
      "metin": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 36,
      "metin": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 37,
      "metin": "أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 38,
      "metin": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 39,
      "metin": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 40,
      "metin": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 41,
      "metin": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 42,
      "metin": "يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ"
    }
  ]
}