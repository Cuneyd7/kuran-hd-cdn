{
  "sayfa_no": 591,
  "ayetler": [
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 2,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 3,
      "metin": "ٱلنَّجْمُ ٱلثَّاقِبُ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 4,
      "metin": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 5,
      "metin": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 6,
      "metin": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 7,
      "metin": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 8,
      "metin": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 9,
      "metin": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 10,
      "metin": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 11,
      "metin": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 12,
      "metin": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 13,
      "metin": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 14,
      "metin": "وَمَا هُوَ بِٱلْهَزْلِ"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 15,
      "metin": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 16,
      "metin": "وَأَكِيدُ كَيْدًۭا"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 17,
      "metin": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 2,
      "metin": "ٱلَّذِى خَلَقَ فَسَوَّىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 3,
      "metin": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 4,
      "metin": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 5,
      "metin": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 6,
      "metin": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 7,
      "metin": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 8,
      "metin": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 9,
      "metin": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 10,
      "metin": "سَيَذَّكَّرُ مَن يَخْشَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 11,
      "metin": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 12,
      "metin": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 13,
      "metin": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 14,
      "metin": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 15,
      "metin": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"
    }
  ]
}