{
  "sayfa_no": 604,
  "ayetler": [
    {
      "sure_no": 112,
      "sure_adi": "Al-Ikhlaas",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ"
    },
    {
      "sure_no": 112,
      "sure_adi": "Al-Ikhlaas",
      "ayet_no": 2,
      "metin": "ٱللَّهُ ٱلصَّمَدُ"
    },
    {
      "sure_no": 112,
      "sure_adi": "Al-Ikhlaas",
      "ayet_no": 3,
      "metin": "لَمْ يَلِدْ وَلَمْ يُولَدْ"
    },
    {
      "sure_no": 112,
      "sure_adi": "Al-Ikhlaas",
      "ayet_no": 4,
      "metin": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 2,
      "metin": "مِن شَرِّ مَا خَلَقَ"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 3,
      "metin": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 4,
      "metin": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 5,
      "metin": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"
    },
    {
      "sure_no": 114,
      "sure_adi": "An-Naas",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"
    },
    {
      "sure_no": 114,
      "sure_adi": "An-Naas",
      "ayet_no": 2,
      "metin": "مَلِكِ ٱلنَّاسِ"
    },
    {
      "sure_no": 114,
      "sure_adi": "An-Naas",
      "ayet_no": 3,
      "metin": "إِلَٰهِ ٱلنَّاسِ"
    },
    {
      "sure_no": 114,
      "sure_adi": "An-Naas",
      "ayet_no": 4,
      "metin": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"
    },
    {
      "sure_no": 114,
      "sure_adi": "An-Naas",
      "ayet_no": 5,
      "metin": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"
    },
    {
      "sure_no": 114,
      "sure_adi": "An-Naas",
      "ayet_no": 6,
      "metin": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"
    }
  ]
}