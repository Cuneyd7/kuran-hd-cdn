{
  "sayfa_no": 372,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 112,
      "metin": "قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 113,
      "metin": "إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى ۖ لَوْ تَشْعُرُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 114,
      "metin": "وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 115,
      "metin": "إِنْ أَنَا۠ إِلَّا نَذِيرٌۭ مُّبِينٌۭ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 116,
      "metin": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 117,
      "metin": "قَالَ رَبِّ إِنَّ قَوْمِى كَذَّبُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 118,
      "metin": "فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْحًۭا وَنَجِّنِى وَمَن مَّعِىَ مِنَ ٱلْمُؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 119,
      "metin": "فَأَنجَيْنَٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 120,
      "metin": "ثُمَّ أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 121,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 122,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 123,
      "metin": "كَذَّبَتْ عَادٌ ٱلْمُرْسَلِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 124,
      "metin": "إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 125,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 126,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 127,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 128,
      "metin": "أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةًۭ تَعْبَثُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 129,
      "metin": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 130,
      "metin": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 131,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 132,
      "metin": "وَٱتَّقُوا۟ ٱلَّذِىٓ أَمَدَّكُم بِمَا تَعْلَمُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 133,
      "metin": "أَمَدَّكُم بِأَنْعَٰمٍۢ وَبَنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 134,
      "metin": "وَجَنَّٰتٍۢ وَعُيُونٍ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 135,
      "metin": "إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍۢ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 136,
      "metin": "قَالُوا۟ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ ٱلْوَٰعِظِينَ"
    }
  ]
}