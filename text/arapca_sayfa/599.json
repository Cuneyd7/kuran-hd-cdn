{
  "sayfa_no": 599,
  "ayetler": [
    {
      "sure_no": 98,
      "sure_adi": "Al-Bayyina",
      "ayet_no": 8,
      "metin": "جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّٰتُ عَدْنٍۢ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًۭا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 2,
      "metin": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 3,
      "metin": "وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 4,
      "metin": "يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 5,
      "metin": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 6,
      "metin": "يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 7,
      "metin": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 8,
      "metin": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 2,
      "metin": "فَٱلْمُورِيَٰتِ قَدْحًۭا"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 3,
      "metin": "فَٱلْمُغِيرَٰتِ صُبْحًۭا"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 4,
      "metin": "فَأَثَرْنَ بِهِۦ نَقْعًۭا"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 5,
      "metin": "فَوَسَطْنَ بِهِۦ جَمْعًا"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 6,
      "metin": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 7,
      "metin": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 8,
      "metin": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"
    },
    {
      "sure_no": 100,
      "sure_adi": "Al-Aadiyaat",
      "ayet_no": 9,
      "metin": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"
    }
  ]
}