{
  "sayfa_no": 586,
  "ayetler": [
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 2,
      "metin": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 3,
      "metin": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 4,
      "metin": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 5,
      "metin": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 6,
      "metin": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 7,
      "metin": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 8,
      "metin": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 9,
      "metin": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 10,
      "metin": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 11,
      "metin": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 12,
      "metin": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 13,
      "metin": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 14,
      "metin": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 15,
      "metin": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 16,
      "metin": "ٱلْجَوَارِ ٱلْكُنَّسِ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 17,
      "metin": "وَٱلَّيْلِ إِذَا عَسْعَسَ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 18,
      "metin": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 19,
      "metin": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 20,
      "metin": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 21,
      "metin": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 22,
      "metin": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 23,
      "metin": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 24,
      "metin": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 25,
      "metin": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 26,
      "metin": "فَأَيْنَ تَذْهَبُونَ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 27,
      "metin": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 28,
      "metin": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 29,
      "metin": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ"
    }
  ]
}