{
  "sayfa_no": 589,
  "ayetler": [
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 35,
      "metin": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 36,
      "metin": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 2,
      "metin": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 3,
      "metin": "وَإِذَا ٱلْأَرْضُ مُدَّتْ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 4,
      "metin": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 5,
      "metin": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 6,
      "metin": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 7,
      "metin": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 8,
      "metin": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 9,
      "metin": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 10,
      "metin": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 11,
      "metin": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 12,
      "metin": "وَيَصْلَىٰ سَعِيرًا"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 13,
      "metin": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 14,
      "metin": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 15,
      "metin": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 16,
      "metin": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 17,
      "metin": "وَٱلَّيْلِ وَمَا وَسَقَ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 18,
      "metin": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 19,
      "metin": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 20,
      "metin": "فَمَا لَهُمْ لَا يُؤْمِنُونَ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 21,
      "metin": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 22,
      "metin": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 23,
      "metin": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 24,
      "metin": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 25,
      "metin": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"
    }
  ]
}