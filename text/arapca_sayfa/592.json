{
  "sayfa_no": 592,
  "ayetler": [
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 16,
      "metin": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 17,
      "metin": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 18,
      "metin": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 19,
      "metin": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 2,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 3,
      "metin": "عَامِلَةٌۭ نَّاصِبَةٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 4,
      "metin": "تَصْلَىٰ نَارًا حَامِيَةًۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 5,
      "metin": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 6,
      "metin": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 7,
      "metin": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 8,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 9,
      "metin": "لِّسَعْيِهَا رَاضِيَةٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 10,
      "metin": "فِى جَنَّةٍ عَالِيَةٍۢ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 11,
      "metin": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 12,
      "metin": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 13,
      "metin": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 14,
      "metin": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 15,
      "metin": "وَنَمَارِقُ مَصْفُوفَةٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 16,
      "metin": "وَزَرَابِىُّ مَبْثُوثَةٌ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 17,
      "metin": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 18,
      "metin": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 19,
      "metin": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 20,
      "metin": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 21,
      "metin": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 22,
      "metin": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 23,
      "metin": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 24,
      "metin": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 25,
      "metin": "إِنَّ إِلَيْنَآ إِيَابَهُمْ"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 26,
      "metin": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"
    }
  ]
}