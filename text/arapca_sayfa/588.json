{
  "sayfa_no": 588,
  "ayetler": [
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 7,
      "metin": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 8,
      "metin": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 9,
      "metin": "كِتَٰبٌۭ مَّرْقُومٌۭ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 10,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 11,
      "metin": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 12,
      "metin": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 13,
      "metin": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 14,
      "metin": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 15,
      "metin": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 16,
      "metin": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 17,
      "metin": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 18,
      "metin": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 19,
      "metin": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 20,
      "metin": "كِتَٰبٌۭ مَّرْقُومٌۭ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 21,
      "metin": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 22,
      "metin": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 23,
      "metin": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 24,
      "metin": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 25,
      "metin": "يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 26,
      "metin": "خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 27,
      "metin": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 28,
      "metin": "عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 29,
      "metin": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 30,
      "metin": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 31,
      "metin": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 32,
      "metin": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 33,
      "metin": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 34,
      "metin": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ"
    }
  ]
}