{
  "sayfa_no": 580,
  "ayetler": [
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 26,
      "metin": "وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًۭا طَوِيلًا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 27,
      "metin": "إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًۭا ثَقِيلًۭا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 28,
      "metin": "نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلًا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 29,
      "metin": "إِنَّ هَٰذِهِۦ تَذْكِرَةٌۭ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًۭا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 30,
      "metin": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًۭا"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 31,
      "metin": "يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ ۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 2,
      "metin": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 3,
      "metin": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 4,
      "metin": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 5,
      "metin": "فَٱلْمُلْقِيَٰتِ ذِكْرًا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 6,
      "metin": "عُذْرًا أَوْ نُذْرًا"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 7,
      "metin": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 8,
      "metin": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 9,
      "metin": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 10,
      "metin": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 11,
      "metin": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 12,
      "metin": "لِأَىِّ يَوْمٍ أُجِّلَتْ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 13,
      "metin": "لِيَوْمِ ٱلْفَصْلِ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 14,
      "metin": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 15,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 16,
      "metin": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 17,
      "metin": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 18,
      "metin": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 19,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
    }
  ]
}