{
  "sayfa_no": 375,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 184,
      "metin": "وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 185,
      "metin": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 186,
      "metin": "وَمَآ أَنتَ إِلَّا بَشَرٌۭ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَٰذِبِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 187,
      "metin": "فَأَسْقِطْ عَلَيْنَا كِسَفًۭا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 188,
      "metin": "قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 189,
      "metin": "فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 190,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 191,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 192,
      "metin": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 193,
      "metin": "نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 194,
      "metin": "عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ ٱلْمُنذِرِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 195,
      "metin": "بِلِسَانٍ عَرَبِىٍّۢ مُّبِينٍۢ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 196,
      "metin": "وَإِنَّهُۥ لَفِى زُبُرِ ٱلْأَوَّلِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 197,
      "metin": "أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَن يَعْلَمَهُۥ عُلَمَٰٓؤُا۟ بَنِىٓ إِسْرَٰٓءِيلَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 198,
      "metin": "وَلَوْ نَزَّلْنَٰهُ عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 199,
      "metin": "فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُوا۟ بِهِۦ مُؤْمِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 200,
      "metin": "كَذَٰلِكَ سَلَكْنَٰهُ فِى قُلُوبِ ٱلْمُجْرِمِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 201,
      "metin": "لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 202,
      "metin": "فَيَأْتِيَهُم بَغْتَةًۭ وَهُمْ لَا يَشْعُرُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 203,
      "metin": "فَيَقُولُوا۟ هَلْ نَحْنُ مُنظَرُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 204,
      "metin": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 205,
      "metin": "أَفَرَءَيْتَ إِن مَّتَّعْنَٰهُمْ سِنِينَ"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 206,
      "metin": "ثُمَّ جَآءَهُم مَّا كَانُوا۟ يُوعَدُونَ"
    }
  ]
}