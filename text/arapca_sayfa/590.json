{
  "sayfa_no": 590,
  "ayetler": [
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 2,
      "metin": "وَٱلْيَوْمِ ٱلْمَوْعُودِ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 3,
      "metin": "وَشَاهِدٍۢ وَمَشْهُودٍۢ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 4,
      "metin": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 5,
      "metin": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 6,
      "metin": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 7,
      "metin": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 8,
      "metin": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 9,
      "metin": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 10,
      "metin": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 11,
      "metin": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 12,
      "metin": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 13,
      "metin": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 14,
      "metin": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 15,
      "metin": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 16,
      "metin": "فَعَّالٌۭ لِّمَا يُرِيدُ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 17,
      "metin": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 18,
      "metin": "فِرْعَوْنَ وَثَمُودَ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 19,
      "metin": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 20,
      "metin": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 21,
      "metin": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 22,
      "metin": "فِى لَوْحٍۢ مَّحْفُوظٍۭ"
    }
  ]
}