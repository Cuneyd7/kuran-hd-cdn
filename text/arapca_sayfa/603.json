{
  "sayfa_no": 603,
  "ayetler": [
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 2,
      "metin": "لَآ أَعْبُدُ مَا تَعْبُدُونَ"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 3,
      "metin": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 4,
      "metin": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 5,
      "metin": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 6,
      "metin": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 2,
      "metin": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 3,
      "metin": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 1,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 2,
      "metin": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 3,
      "metin": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 4,
      "metin": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 5,
      "metin": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ"
    }
  ]
}