{
  "sayfa_no": 536,
  "ayetler": [
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 51,
      "metin": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 52,
      "metin": "لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 53,
      "metin": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 54,
      "metin": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 55,
      "metin": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 56,
      "metin": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 57,
      "metin": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 58,
      "metin": "أَفَرَءَيْتُم مَّا تُمْنُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 59,
      "metin": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 60,
      "metin": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 61,
      "metin": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 62,
      "metin": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 63,
      "metin": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 64,
      "metin": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 65,
      "metin": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 66,
      "metin": "إِنَّا لَمُغْرَمُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 67,
      "metin": "بَلْ نَحْنُ مَحْرُومُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 68,
      "metin": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 69,
      "metin": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 70,
      "metin": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 71,
      "metin": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 72,
      "metin": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 73,
      "metin": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 74,
      "metin": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 75,
      "metin": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 76,
      "metin": "وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ"
    }
  ]
}