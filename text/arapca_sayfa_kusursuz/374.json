{
  "sayfa_no": 374,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 160,
      "besmele_var_mi": false,
      "metin": "كَذَّبَتْ قَوْمُ لُوطٍ ٱلْمُرْسَلِينَ ۝١٦٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 161,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّقُونَ ۝١٦١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 162,
      "besmele_var_mi": false,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ ۝١٦٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 163,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١٦٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 164,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ ۝١٦٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 165,
      "besmele_var_mi": false,
      "metin": "أَتَأْتُونَ ٱلذُّكْرَانَ مِنَ ٱلْعَٰلَمِينَ ۝١٦٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 166,
      "besmele_var_mi": false,
      "metin": "وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنْ أَزْوَٰجِكُم ۚ بَلْ أَنتُمْ قَوْمٌ عَادُونَ ۝١٦٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 167,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ ٱلْمُخْرَجِينَ ۝١٦٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 168,
      "besmele_var_mi": false,
      "metin": "قَالَ إِنِّى لِعَمَلِكُم مِّنَ ٱلْقَالِينَ ۝١٦٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 169,
      "besmele_var_mi": false,
      "metin": "رَبِّ نَجِّنِى وَأَهْلِى مِمَّا يَعْمَلُونَ ۝١٦٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 170,
      "besmele_var_mi": false,
      "metin": "فَنَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ ۝١٧٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 171,
      "besmele_var_mi": false,
      "metin": "إِلَّا عَجُوزًۭا فِى ٱلْغَٰبِرِينَ ۝١٧١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 172,
      "besmele_var_mi": false,
      "metin": "ثُمَّ دَمَّرْنَا ٱلْءَاخَرِينَ ۝١٧٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 173,
      "besmele_var_mi": false,
      "metin": "وَأَمْطَرْنَا عَلَيْهِم مَّطَرًۭا ۖ فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ ۝١٧٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 174,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ ۝١٧٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 175,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ۝١٧٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 176,
      "besmele_var_mi": false,
      "metin": "كَذَّبَ أَصْحَٰبُ لْـَٔيْكَةِ ٱلْمُرْسَلِينَ ۝١٧٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 177,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ ۝١٧٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 178,
      "besmele_var_mi": false,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ ۝١٧٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 179,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١٧٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 180,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ ۝١٨٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 181,
      "besmele_var_mi": false,
      "metin": "۞ أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ ۝١٨١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 182,
      "besmele_var_mi": false,
      "metin": "وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ ۝١٨٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 183,
      "besmele_var_mi": false,
      "metin": "وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ ۝١٨٣"
    }
  ]
}