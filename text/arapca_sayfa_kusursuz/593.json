{
  "sayfa_no": 593,
  "ayetler": [
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ ۝١"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَلَيَالٍ عَشْرٍۢ ۝٢"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَٱلشَّفْعِ وَٱلْوَتْرِ ۝٣"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَٱلَّيْلِ إِذَا يَسْرِ ۝٤"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ ۝٥"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ ۝٦"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "إِرَمَ ذَاتِ ٱلْعِمَادِ ۝٧"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ ۝٨"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ ۝٩"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ ۝١٠"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ ۝١١"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ ۝١٢"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ ۝١٣"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ ۝١٤"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ ۝١٥"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ ۝١٦"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ ۝١٧"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ ۝١٨"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا ۝١٩"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا ۝٢٠"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا ۝٢١"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا ۝٢٢"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ ۝٢٣"
    }
  ]
}