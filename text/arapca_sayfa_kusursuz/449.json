{
  "sayfa_no": 449,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 77,
      "besmele_var_mi": false,
      "metin": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ ۝٧٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 78,
      "besmele_var_mi": false,
      "metin": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ ۝٧٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 79,
      "besmele_var_mi": false,
      "metin": "سَلَٰمٌ عَلَىٰ نُوحٍۢ فِى ٱلْعَٰلَمِينَ ۝٧٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 80,
      "besmele_var_mi": false,
      "metin": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ۝٨٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 81,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ ۝٨١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 82,
      "besmele_var_mi": false,
      "metin": "ثُمَّ أَغْرَقْنَا ٱلْءَاخَرِينَ ۝٨٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 83,
      "besmele_var_mi": false,
      "metin": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ ۝٨٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 84,
      "besmele_var_mi": false,
      "metin": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍۢ سَلِيمٍ ۝٨٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 85,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ ۝٨٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 86,
      "besmele_var_mi": false,
      "metin": "أَئِفْكًا ءَالِهَةًۭ دُونَ ٱللَّهِ تُرِيدُونَ ۝٨٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 87,
      "besmele_var_mi": false,
      "metin": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَٰلَمِينَ ۝٨٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 88,
      "besmele_var_mi": false,
      "metin": "فَنَظَرَ نَظْرَةًۭ فِى ٱلنُّجُومِ ۝٨٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 89,
      "besmele_var_mi": false,
      "metin": "فَقَالَ إِنِّى سَقِيمٌۭ ۝٨٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 90,
      "besmele_var_mi": false,
      "metin": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ ۝٩٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 91,
      "besmele_var_mi": false,
      "metin": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ ۝٩١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 92,
      "besmele_var_mi": false,
      "metin": "مَا لَكُمْ لَا تَنطِقُونَ ۝٩٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 93,
      "besmele_var_mi": false,
      "metin": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ ۝٩٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 94,
      "besmele_var_mi": false,
      "metin": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ ۝٩٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 95,
      "besmele_var_mi": false,
      "metin": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ ۝٩٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 96,
      "besmele_var_mi": false,
      "metin": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ ۝٩٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 97,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَٰنًۭا فَأَلْقُوهُ فِى ٱلْجَحِيمِ ۝٩٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 98,
      "besmele_var_mi": false,
      "metin": "فَأَرَادُوا۟ بِهِۦ كَيْدًۭا فَجَعَلْنَٰهُمُ ٱلْأَسْفَلِينَ ۝٩٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 99,
      "besmele_var_mi": false,
      "metin": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ ۝٩٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 100,
      "besmele_var_mi": false,
      "metin": "رَبِّ هَبْ لِى مِنَ ٱلصَّٰلِحِينَ ۝١٠٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 101,
      "besmele_var_mi": false,
      "metin": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٍۢ ۝١٠١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 102,
      "besmele_var_mi": false,
      "metin": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ ۝١٠٢"
    }
  ]
}