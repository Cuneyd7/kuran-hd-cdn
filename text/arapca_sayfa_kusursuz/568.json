{
  "sayfa_no": 568,
  "ayetler": [
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ ۝٣٥"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ ۝٣٦"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ ۝٣٧"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ ۝٣٨"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "وَمَا لَا تُبْصِرُونَ ۝٣٩"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ ۝٤٠"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ ۝٤١"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ ۝٤٢"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ ۝٤٣"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ ۝٤٤"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ ۝٤٥"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ ۝٤٦"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 47,
      "besmele_var_mi": false,
      "metin": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ ۝٤٧"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ ۝٤٨"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ ۝٤٩"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ ۝٥٠"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ ۝٥١"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ ۝٥٢"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ ۝١"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ ۝٢"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ ۝٣"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ ۝٤"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا ۝٥"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا ۝٦"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَنَرَىٰهُ قَرِيبًۭا ۝٧"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ ۝٨"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ۝٩"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا ۝١٠"
    }
  ]
}