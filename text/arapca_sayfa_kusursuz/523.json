{
  "sayfa_no": 523,
  "ayetler": [
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ ۝٥٢"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 53,
      "besmele_var_mi": false,
      "metin": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ ۝٥٣"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 54,
      "besmele_var_mi": false,
      "metin": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ ۝٥٤"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 55,
      "besmele_var_mi": false,
      "metin": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ ۝٥٥"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 56,
      "besmele_var_mi": false,
      "metin": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ ۝٥٦"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 57,
      "besmele_var_mi": false,
      "metin": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ ۝٥٧"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 58,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ ۝٥٨"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 59,
      "besmele_var_mi": false,
      "metin": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ ۝٥٩"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 60,
      "besmele_var_mi": false,
      "metin": "فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ ۝٦٠"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلطُّورِ ۝١"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَكِتَٰبٍۢ مَّسْطُورٍۢ ۝٢"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "فِى رَقٍّۢ مَّنشُورٍۢ ۝٣"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَٱلْبَيْتِ ٱلْمَعْمُورِ ۝٤"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَٱلسَّقْفِ ٱلْمَرْفُوعِ ۝٥"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَٱلْبَحْرِ ٱلْمَسْجُورِ ۝٦"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌۭ ۝٧"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "مَّا لَهُۥ مِن دَافِعٍۢ ۝٨"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًۭا ۝٩"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًۭا ۝١٠"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "فَوَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝١١"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ هُمْ فِى خَوْضٍۢ يَلْعَبُونَ ۝١٢"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا ۝١٣"
    },
    {
      "sure_no": 52,
      "sure_adi": "At-Tur",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "هَٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ ۝١٤"
    }
  ]
}