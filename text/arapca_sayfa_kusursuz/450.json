{
  "sayfa_no": 450,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 103,
      "besmele_var_mi": false,
      "metin": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ ۝١٠٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 104,
      "besmele_var_mi": false,
      "metin": "وَنَٰدَيْنَٰهُ أَن يَٰٓإِبْرَٰهِيمُ ۝١٠٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 105,
      "besmele_var_mi": false,
      "metin": "قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ۝١٠٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 106,
      "besmele_var_mi": false,
      "metin": "إِنَّ هَٰذَا لَهُوَ ٱلْبَلَٰٓؤُا۟ ٱلْمُبِينُ ۝١٠٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 107,
      "besmele_var_mi": false,
      "metin": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٍۢ ۝١٠٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 108,
      "besmele_var_mi": false,
      "metin": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ ۝١٠٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 109,
      "besmele_var_mi": false,
      "metin": "سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ ۝١٠٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 110,
      "besmele_var_mi": false,
      "metin": "كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ۝١١٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 111,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ ۝١١١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 112,
      "besmele_var_mi": false,
      "metin": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيًّۭا مِّنَ ٱلصَّٰلِحِينَ ۝١١٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 113,
      "besmele_var_mi": false,
      "metin": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌۭ وَظَالِمٌۭ لِّنَفْسِهِۦ مُبِينٌۭ ۝١١٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 114,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ ۝١١٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 115,
      "besmele_var_mi": false,
      "metin": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ ۝١١٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 116,
      "besmele_var_mi": false,
      "metin": "وَنَصَرْنَٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَٰلِبِينَ ۝١١٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 117,
      "besmele_var_mi": false,
      "metin": "وَءَاتَيْنَٰهُمَا ٱلْكِتَٰبَ ٱلْمُسْتَبِينَ ۝١١٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 118,
      "besmele_var_mi": false,
      "metin": "وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ ۝١١٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 119,
      "besmele_var_mi": false,
      "metin": "وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْءَاخِرِينَ ۝١١٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 120,
      "besmele_var_mi": false,
      "metin": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ ۝١٢٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 121,
      "besmele_var_mi": false,
      "metin": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ۝١٢١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 122,
      "besmele_var_mi": false,
      "metin": "إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ ۝١٢٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 123,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ ۝١٢٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 124,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ ۝١٢٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 125,
      "besmele_var_mi": false,
      "metin": "أَتَدْعُونَ بَعْلًۭا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ ۝١٢٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 126,
      "besmele_var_mi": false,
      "metin": "ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ ۝١٢٦"
    }
  ]
}