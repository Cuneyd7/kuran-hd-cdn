{
  "sayfa_no": 589,
  "ayetler": [
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ ۝٣٥"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ ۝٣٦"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ ۝١"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۝٢"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْأَرْضُ مُدَّتْ ۝٣"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ ۝٤"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۝٥"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ ۝٦"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ ۝٧"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا ۝٨"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا ۝٩"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ ۝١٠"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا ۝١١"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَيَصْلَىٰ سَعِيرًا ۝١٢"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا ۝١٣"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ ۝١٤"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا ۝١٥"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ ۝١٦"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَٱلَّيْلِ وَمَا وَسَقَ ۝١٧"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ ۝١٨"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ ۝١٩"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "فَمَا لَهُمْ لَا يُؤْمِنُونَ ۝٢٠"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩ ۝٢١"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ ۝٢٢"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ ۝٢٣"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ ۝٢٤"
    },
    {
      "sure_no": 84,
      "sure_adi": "Al-Inshiqaaq",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ ۝٢٥"
    }
  ]
}