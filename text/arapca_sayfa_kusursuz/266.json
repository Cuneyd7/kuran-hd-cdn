{
  "sayfa_no": 266,
  "ayetler": [
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 71,
      "besmele_var_mi": false,
      "metin": "قَالَ هَٰٓؤُلَآءِ بَنَاتِىٓ إِن كُنتُمْ فَٰعِلِينَ ۝٧١"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 72,
      "besmele_var_mi": false,
      "metin": "لَعَمْرُكَ إِنَّهُمْ لَفِى سَكْرَتِهِمْ يَعْمَهُونَ ۝٧٢"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 73,
      "besmele_var_mi": false,
      "metin": "فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُشْرِقِينَ ۝٧٣"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 74,
      "besmele_var_mi": false,
      "metin": "فَجَعَلْنَا عَٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةًۭ مِّن سِجِّيلٍ ۝٧٤"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 75,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍۢ لِّلْمُتَوَسِّمِينَ ۝٧٥"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 76,
      "besmele_var_mi": false,
      "metin": "وَإِنَّهَا لَبِسَبِيلٍۢ مُّقِيمٍ ۝٧٦"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 77,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ لِّلْمُؤْمِنِينَ ۝٧٧"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 78,
      "besmele_var_mi": false,
      "metin": "وَإِن كَانَ أَصْحَٰبُ ٱلْأَيْكَةِ لَظَٰلِمِينَ ۝٧٨"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 79,
      "besmele_var_mi": false,
      "metin": "فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍۢ مُّبِينٍۢ ۝٧٩"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 80,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ كَذَّبَ أَصْحَٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ ۝٨٠"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 81,
      "besmele_var_mi": false,
      "metin": "وَءَاتَيْنَٰهُمْ ءَايَٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ ۝٨١"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 82,
      "besmele_var_mi": false,
      "metin": "وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ ۝٨٢"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 83,
      "besmele_var_mi": false,
      "metin": "فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ ۝٨٣"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 84,
      "besmele_var_mi": false,
      "metin": "فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ ۝٨٤"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 85,
      "besmele_var_mi": false,
      "metin": "وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ ۗ وَإِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌۭ ۖ فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ ۝٨٥"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 86,
      "besmele_var_mi": false,
      "metin": "إِنَّ رَبَّكَ هُوَ ٱلْخَلَّٰقُ ٱلْعَلِيمُ ۝٨٦"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 87,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ ءَاتَيْنَٰكَ سَبْعًۭا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ ۝٨٧"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 88,
      "besmele_var_mi": false,
      "metin": "لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًۭا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ ۝٨٨"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 89,
      "besmele_var_mi": false,
      "metin": "وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ ۝٨٩"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 90,
      "besmele_var_mi": false,
      "metin": "كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ ۝٩٠"
    }
  ]
}