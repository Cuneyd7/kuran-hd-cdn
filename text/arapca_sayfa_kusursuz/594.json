{
  "sayfa_no": 594,
  "ayetler": [
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى ۝٢٤"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ ۝٢٥"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ ۝٢٦"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ ۝٢٧"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ ۝٢٨"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "فَٱدْخُلِى فِى عِبَٰدِى ۝٢٩"
    },
    {
      "sure_no": 89,
      "sure_adi": "Al-Fajr",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "وَٱدْخُلِى جَنَّتِى ۝٣٠"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ ۝١"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ ۝٢"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَوَالِدٍۢ وَمَا وَلَدَ ۝٣"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ ۝٤"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ ۝٥"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا ۝٦"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ ۝٧"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ ۝٨"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَلِسَانًۭا وَشَفَتَيْنِ ۝٩"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ ۝١٠"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ ۝١١"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ ۝١٢"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فَكُّ رَقَبَةٍ ۝١٣"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ ۝١٤"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "يَتِيمًۭا ذَا مَقْرَبَةٍ ۝١٥"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ ۝١٦"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ ۝١٧"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ ۝١٨"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ ۝١٩"
    },
    {
      "sure_no": 90,
      "sure_adi": "Al-Balad",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ ۝٢٠"
    }
  ]
}