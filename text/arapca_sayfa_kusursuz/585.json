{
  "sayfa_no": 585,
  "ayetler": [
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ ۝١"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "أَن جَآءَهُ ٱلْأَعْمَىٰ ۝٢"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ۝٣"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ ۝٤"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "أَمَّا مَنِ ٱسْتَغْنَىٰ ۝٥"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "فَأَنتَ لَهُۥ تَصَدَّىٰ ۝٦"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ ۝٧"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ ۝٨"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَهُوَ يَخْشَىٰ ۝٩"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "فَأَنتَ عَنْهُ تَلَهَّىٰ ۝١٠"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ ۝١١"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "فَمَن شَآءَ ذَكَرَهُۥ ۝١٢"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ ۝١٣"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ ۝١٤"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "بِأَيْدِى سَفَرَةٍۢ ۝١٥"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "كِرَامٍۭ بَرَرَةٍۢ ۝١٦"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ ۝١٧"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ ۝١٨"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ۝١٩"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ۝٢٠"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ ۝٢١"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ۝٢٢"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ ۝٢٣"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ۝٢٤"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا ۝٢٥"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا ۝٢٦"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا ۝٢٧"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "وَعِنَبًۭا وَقَضْبًۭا ۝٢٨"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "وَزَيْتُونًۭا وَنَخْلًۭا ۝٢٩"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "وَحَدَآئِقَ غُلْبًۭا ۝٣٠"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "وَفَٰكِهَةًۭ وَأَبًّۭا ۝٣١"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ ۝٣٢"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ۝٣٣"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ ۝٣٤"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "وَأُمِّهِۦ وَأَبِيهِ ۝٣٥"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "وَصَٰحِبَتِهِۦ وَبَنِيهِ ۝٣٦"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ ۝٣٧"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ ۝٣٨"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ ۝٣٩"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ ۝٤٠"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "تَرْهَقُهَا قَتَرَةٌ ۝٤١"
    },
    {
      "sure_no": 80,
      "sure_adi": "Abasa",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ ۝٤٢"
    }
  ]
}