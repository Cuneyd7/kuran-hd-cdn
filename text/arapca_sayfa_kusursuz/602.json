{
  "sayfa_no": 602,
  "ayetler": [
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ ۝١"
    },
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ ۝٢"
    },
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ ۝٣"
    },
    {
      "sure_no": 106,
      "sure_adi": "Quraish",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ ۝٤"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ ۝١"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ ۝٢"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ ۝٣"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "فَوَيْلٌۭ لِّلْمُصَلِّينَ ۝٤"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ ۝٥"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ هُمْ يُرَآءُونَ ۝٦"
    },
    {
      "sure_no": 107,
      "sure_adi": "Al-Maa'un",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَيَمْنَعُونَ ٱلْمَاعُونَ ۝٧"
    },
    {
      "sure_no": 108,
      "sure_adi": "Al-Kawthar",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ ۝١"
    },
    {
      "sure_no": 108,
      "sure_adi": "Al-Kawthar",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ ۝٢"
    },
    {
      "sure_no": 108,
      "sure_adi": "Al-Kawthar",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ ۝٣"
    }
  ]
}