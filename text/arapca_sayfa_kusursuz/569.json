{
  "sayfa_no": 569,
  "ayetler": [
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ ۝١١"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَصَٰحِبَتِهِۦ وَأَخِيهِ ۝١٢"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ ۝١٣"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ ۝١٤"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "كَلَّآ ۖ إِنَّهَا لَظَىٰ ۝١٥"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "نَزَّاعَةًۭ لِّلشَّوَىٰ ۝١٦"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ ۝١٧"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "وَجَمَعَ فَأَوْعَىٰٓ ۝١٨"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا ۝١٩"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا ۝٢٠"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا ۝٢١"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "إِلَّا ٱلْمُصَلِّينَ ۝٢٢"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ ۝٢٣"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ ۝٢٤"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ ۝٢٥"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ ۝٢٦"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ ۝٢٧"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ ۝٢٨"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ ۝٢٩"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ ۝٣٠"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ ۝٣١"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ ۝٣٢"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ ۝٣٣"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ ۝٣٤"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ ۝٣٥"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ ۝٣٦"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ ۝٣٧"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ ۝٣٨"
    },
    {
      "sure_no": 70,
      "sure_adi": "Al-Ma'aarij",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ ۝٣٩"
    }
  ]
}