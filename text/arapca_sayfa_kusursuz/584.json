{
  "sayfa_no": 584,
  "ayetler": [
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى ۝١٦"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ ۝١٧"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ ۝١٨"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ ۝١٩"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ ۝٢٠"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "فَكَذَّبَ وَعَصَىٰ ۝٢١"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "ثُمَّ أَدْبَرَ يَسْعَىٰ ۝٢٢"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "فَحَشَرَ فَنَادَىٰ ۝٢٣"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ ۝٢٤"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ ۝٢٥"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ ۝٢٦"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا ۝٢٧"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا ۝٢٨"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا ۝٢٩"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ ۝٣٠"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا ۝٣١"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "وَٱلْجِبَالَ أَرْسَىٰهَا ۝٣٢"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ ۝٣٣"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ ۝٣٤"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ ۝٣٥"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ ۝٣٦"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "فَأَمَّا مَن طَغَىٰ ۝٣٧"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا ۝٣٨"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ ۝٣٩"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ ۝٤٠"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ ۝٤١"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا ۝٤٢"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ ۝٤٣"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ ۝٤٤"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا ۝٤٥"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا ۝٤٦"
    }
  ]
}