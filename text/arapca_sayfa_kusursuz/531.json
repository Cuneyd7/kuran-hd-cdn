{
  "sayfa_no": 531,
  "ayetler": [
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌۭ كَلَمْحٍۭ بِٱلْبَصَرِ ۝٥٠"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍۢ ۝٥١"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "وَكُلُّ شَىْءٍۢ فَعَلُوهُ فِى ٱلزُّبُرِ ۝٥٢"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 53,
      "besmele_var_mi": false,
      "metin": "وَكُلُّ صَغِيرٍۢ وَكَبِيرٍۢ مُّسْتَطَرٌ ۝٥٣"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 54,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَهَرٍۢ ۝٥٤"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 55,
      "besmele_var_mi": false,
      "metin": "فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍۢ مُّقْتَدِرٍۭ ۝٥٥"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ ۝١"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "عَلَّمَ ٱلْقُرْءَانَ ۝٢"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "خَلَقَ ٱلْإِنسَٰنَ ۝٣"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "عَلَّمَهُ ٱلْبَيَانَ ۝٤"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ ۝٥"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ ۝٦"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ ۝٧"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ ۝٨"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ ۝٩"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ ۝١٠"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ ۝١١"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ ۝١٢"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٣"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ ۝١٤"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ ۝١٥"
    },
    {
      "sure_no": 55,
      "sure_adi": "Ar-Rahmaan",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٦"
    }
  ]
}