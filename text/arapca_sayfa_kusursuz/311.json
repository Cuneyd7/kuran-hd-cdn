{
  "sayfa_no": 311,
  "ayetler": [
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 77,
      "besmele_var_mi": false,
      "metin": "أَفَرَءَيْتَ ٱلَّذِى كَفَرَ بِـَٔايَٰتِنَا وَقَالَ لَأُوتَيَنَّ مَالًۭا وَوَلَدًا ۝٧٧"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 78,
      "besmele_var_mi": false,
      "metin": "أَطَّلَعَ ٱلْغَيْبَ أَمِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا ۝٧٨"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 79,
      "besmele_var_mi": false,
      "metin": "كَلَّا ۚ سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلْعَذَابِ مَدًّۭا ۝٧٩"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 80,
      "besmele_var_mi": false,
      "metin": "وَنَرِثُهُۥ مَا يَقُولُ وَيَأْتِينَا فَرْدًۭا ۝٨٠"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 81,
      "besmele_var_mi": false,
      "metin": "وَٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ ءَالِهَةًۭ لِّيَكُونُوا۟ لَهُمْ عِزًّۭا ۝٨١"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 82,
      "besmele_var_mi": false,
      "metin": "كَلَّا ۚ سَيَكْفُرُونَ بِعِبَادَتِهِمْ وَيَكُونُونَ عَلَيْهِمْ ضِدًّا ۝٨٢"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 83,
      "besmele_var_mi": false,
      "metin": "أَلَمْ تَرَ أَنَّآ أَرْسَلْنَا ٱلشَّيَٰطِينَ عَلَى ٱلْكَٰفِرِينَ تَؤُزُّهُمْ أَزًّۭا ۝٨٣"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 84,
      "besmele_var_mi": false,
      "metin": "فَلَا تَعْجَلْ عَلَيْهِمْ ۖ إِنَّمَا نَعُدُّ لَهُمْ عَدًّۭا ۝٨٤"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 85,
      "besmele_var_mi": false,
      "metin": "يَوْمَ نَحْشُرُ ٱلْمُتَّقِينَ إِلَى ٱلرَّحْمَٰنِ وَفْدًۭا ۝٨٥"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 86,
      "besmele_var_mi": false,
      "metin": "وَنَسُوقُ ٱلْمُجْرِمِينَ إِلَىٰ جَهَنَّمَ وِرْدًۭا ۝٨٦"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 87,
      "besmele_var_mi": false,
      "metin": "لَّا يَمْلِكُونَ ٱلشَّفَٰعَةَ إِلَّا مَنِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا ۝٨٧"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 88,
      "besmele_var_mi": false,
      "metin": "وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَٰنُ وَلَدًۭا ۝٨٨"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 89,
      "besmele_var_mi": false,
      "metin": "لَّقَدْ جِئْتُمْ شَيْـًٔا إِدًّۭا ۝٨٩"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 90,
      "besmele_var_mi": false,
      "metin": "تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ وَتَخِرُّ ٱلْجِبَالُ هَدًّا ۝٩٠"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 91,
      "besmele_var_mi": false,
      "metin": "أَن دَعَوْا۟ لِلرَّحْمَٰنِ وَلَدًۭا ۝٩١"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 92,
      "besmele_var_mi": false,
      "metin": "وَمَا يَنۢبَغِى لِلرَّحْمَٰنِ أَن يَتَّخِذَ وَلَدًا ۝٩٢"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 93,
      "besmele_var_mi": false,
      "metin": "إِن كُلُّ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ إِلَّآ ءَاتِى ٱلرَّحْمَٰنِ عَبْدًۭا ۝٩٣"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 94,
      "besmele_var_mi": false,
      "metin": "لَّقَدْ أَحْصَىٰهُمْ وَعَدَّهُمْ عَدًّۭا ۝٩٤"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 95,
      "besmele_var_mi": false,
      "metin": "وَكُلُّهُمْ ءَاتِيهِ يَوْمَ ٱلْقِيَٰمَةِ فَرْدًا ۝٩٥"
    }
  ]
}