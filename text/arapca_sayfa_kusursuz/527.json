{
  "sayfa_no": 527,
  "ayetler": [
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ لَيُسَمُّونَ ٱلْمَلَٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ ۝٢٧"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًۭٔا ۝٢٨"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا ۝٢٩"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ ۝٣٠"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى ۝٣١"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌۭ فِى بُطُونِ أُمَّهَٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ ۝٣٢"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ ۝٣٣"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "وَأَعْطَىٰ قَلِيلًۭا وَأَكْدَىٰٓ ۝٣٤"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ ۝٣٥"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ ۝٣٦"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ ۝٣٧"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "أَلَّا تَزِرُ وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۝٣٨"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰ ۝٣٩"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ ۝٤٠"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ ۝٤١"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ ۝٤٢"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ ۝٤٣"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا ۝٤٤"
    }
  ]
}