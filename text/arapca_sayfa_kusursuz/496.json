{
  "sayfa_no": 496,
  "ayetler": [
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ حمٓ ۝١"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَٱلْكِتَٰبِ ٱلْمُبِينِ ۝٢"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةٍۢ مُّبَٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ ۝٣"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ ۝٤"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "أَمْرًۭا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ ۝٥"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "رَحْمَةًۭ مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ۝٦"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "رَبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ ۝٧"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ ۝٨"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "بَلْ هُمْ فِى شَكٍّۢ يَلْعَبُونَ ۝٩"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍۢ مُّبِينٍۢ ۝١٠"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "يَغْشَى ٱلنَّاسَ ۖ هَٰذَا عَذَابٌ أَلِيمٌۭ ۝١١"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ ۝١٢"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌۭ مُّبِينٌۭ ۝١٣"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌۭ مَّجْنُونٌ ۝١٤"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ ۝١٥"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ ۝١٦"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌۭ كَرِيمٌ ۝١٧"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ ۝١٨"
    }
  ]
}