{
  "sayfa_no": 591,
  "ayetler": [
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ ۝١"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ ۝٢"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "ٱلنَّجْمُ ٱلثَّاقِبُ ۝٣"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ ۝٤"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ ۝٥"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ ۝٦"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ ۝٧"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ ۝٨"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ ۝٩"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ ۝١٠"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ ۝١١"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ ۝١٢"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ ۝١٣"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَمَا هُوَ بِٱلْهَزْلِ ۝١٤"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا ۝١٥"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "وَأَكِيدُ كَيْدًۭا ۝١٦"
    },
    {
      "sure_no": 86,
      "sure_adi": "At-Taariq",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا ۝١٧"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى ۝١"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى خَلَقَ فَسَوَّىٰ ۝٢"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ ۝٣"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ ۝٤"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ ۝٥"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ ۝٦"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ ۝٧"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ ۝٨"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ ۝٩"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "سَيَذَّكَّرُ مَن يَخْشَىٰ ۝١٠"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى ۝١١"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ ۝١٢"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ ۝١٣"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ ۝١٤"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ ۝١٥"
    }
  ]
}