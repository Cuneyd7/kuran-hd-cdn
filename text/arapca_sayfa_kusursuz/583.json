{
  "sayfa_no": 583,
  "ayetler": [
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "إِنَّ لِلْمُتَّقِينَ مَفَازًا ۝٣١"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "حَدَآئِقَ وَأَعْنَٰبًۭا ۝٣٢"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "وَكَوَاعِبَ أَتْرَابًۭا ۝٣٣"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "وَكَأْسًۭا دِهَاقًۭا ۝٣٤"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا ۝٣٥"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا ۝٣٦"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا ۝٣٧"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا ۝٣٨"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ۝٣٩"
    },
    {
      "sure_no": 78,
      "sure_adi": "An-Naba",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا ۝٤٠"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا ۝١"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا ۝٢"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا ۝٣"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا ۝٤"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا ۝٥"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ ۝٦"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "تَتْبَعُهَا ٱلرَّادِفَةُ ۝٧"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ ۝٨"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "أَبْصَٰرُهَا خَٰشِعَةٌۭ ۝٩"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ ۝١٠"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ ۝١١"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ ۝١٢"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ ۝١٣"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "فَإِذَا هُم بِٱلسَّاهِرَةِ ۝١٤"
    },
    {
      "sure_no": 79,
      "sure_adi": "An-Naazi'aat",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ۝١٥"
    }
  ]
}