{
  "sayfa_no": 526,
  "ayetler": [
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّجْمِ إِذَا هَوَىٰ ۝١"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ ۝٢"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ ۝٣"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "إِنْ هُوَ إِلَّا وَحْىٌۭ يُوحَىٰ ۝٤"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ ۝٥"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "ذُو مِرَّةٍۢ فَٱسْتَوَىٰ ۝٦"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ ۝٧"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "ثُمَّ دَنَا فَتَدَلَّىٰ ۝٨"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ ۝٩"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ ۝١٠"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ ۝١١"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ ۝١٢"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ ۝١٣"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ ۝١٤"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ ۝١٥"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ ۝١٦"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ ۝١٧"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ ۝١٨"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ ۝١٩"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ ۝٢٠"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ ۝٢١"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "تِلْكَ إِذًۭا قِسْمَةٌۭ ضِيزَىٰٓ ۝٢٢"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "إِنْ هِىَ إِلَّآ أَسْمَآءٌۭ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ ۝٢٣"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ ۝٢٤"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ ۝٢٥"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "۞ وَكَم مِّن مَّلَكٍۢ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ ۝٢٦"
    }
  ]
}