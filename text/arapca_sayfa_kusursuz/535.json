{
  "sayfa_no": 535,
  "ayetler": [
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ ۝١٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ ۝١٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ ۝١٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ ۝٢٠"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ ۝٢١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "وَحُورٌ عِينٌۭ ۝٢٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ ۝٢٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ ۝٢٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا ۝٢٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا ۝٢٦"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ ۝٢٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "فِى سِدْرٍۢ مَّخْضُودٍۢ ۝٢٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "وَطَلْحٍۢ مَّنضُودٍۢ ۝٢٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "وَظِلٍّۢ مَّمْدُودٍۢ ۝٣٠"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "وَمَآءٍۢ مَّسْكُوبٍۢ ۝٣١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "وَفَٰكِهَةٍۢ كَثِيرَةٍۢ ۝٣٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ ۝٣٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "وَفُرُشٍۢ مَّرْفُوعَةٍ ۝٣٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ ۝٣٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "فَجَعَلْنَٰهُنَّ أَبْكَارًا ۝٣٦"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "عُرُبًا أَتْرَابًۭا ۝٣٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "لِّأَصْحَٰبِ ٱلْيَمِينِ ۝٣٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ ۝٣٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ ۝٤٠"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ ۝٤١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "فِى سَمُومٍۢ وَحَمِيمٍۢ ۝٤٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "وَظِلٍّۢ مِّن يَحْمُومٍۢ ۝٤٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ ۝٤٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ ۝٤٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ ۝٤٦"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 47,
      "besmele_var_mi": false,
      "metin": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ ۝٤٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ ۝٤٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ ۝٤٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ ۝٥٠"
    }
  ]
}