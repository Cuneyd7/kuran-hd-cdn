{
  "sayfa_no": 578,
  "ayetler": [
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ ۝٢٠"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "وَتَذَرُونَ ٱلْءَاخِرَةَ ۝٢١"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ ۝٢٢"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ ۝٢٣"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ ۝٢٤"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ ۝٢٥"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ ۝٢٦"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "وَقِيلَ مَنْ ۜ رَاقٍۢ ۝٢٧"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ ۝٢٨"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ ۝٢٩"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ ۝٣٠"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "فَلَا صَدَّقَ وَلَا صَلَّىٰ ۝٣١"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ ۝٣٢"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ ۝٣٣"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "أَوْلَىٰ لَكَ فَأَوْلَىٰ ۝٣٤"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ ۝٣٥"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى ۝٣٦"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ ۝٣٧"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ ۝٣٨"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ ۝٣٩"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ ۝٤٠"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰ عَلَى ٱلْإِنسَٰنِ حِينٌۭ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًۭٔا مَّذْكُورًا ۝١"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "إِنَّا خَلَقْنَا ٱلْإِنسَٰنَ مِن نُّطْفَةٍ أَمْشَاجٍۢ نَّبْتَلِيهِ فَجَعَلْنَٰهُ سَمِيعًۢا بَصِيرًا ۝٢"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "إِنَّا هَدَيْنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًۭا وَإِمَّا كَفُورًا ۝٣"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "إِنَّآ أَعْتَدْنَا لِلْكَٰفِرِينَ سَلَٰسِلَا۟ وَأَغْلَٰلًۭا وَسَعِيرًا ۝٤"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍۢ كَانَ مِزَاجُهَا كَافُورًا ۝٥"
    }
  ]
}