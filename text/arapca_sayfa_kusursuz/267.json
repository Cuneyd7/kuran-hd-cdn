{
  "sayfa_no": 267,
  "ayetler": [
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 91,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ جَعَلُوا۟ ٱلْقُرْءَانَ عِضِينَ ۝٩١"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 92,
      "besmele_var_mi": false,
      "metin": "فَوَرَبِّكَ لَنَسْـَٔلَنَّهُمْ أَجْمَعِينَ ۝٩٢"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 93,
      "besmele_var_mi": false,
      "metin": "عَمَّا كَانُوا۟ يَعْمَلُونَ ۝٩٣"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 94,
      "besmele_var_mi": false,
      "metin": "فَٱصْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ ٱلْمُشْرِكِينَ ۝٩٤"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 95,
      "besmele_var_mi": false,
      "metin": "إِنَّا كَفَيْنَٰكَ ٱلْمُسْتَهْزِءِينَ ۝٩٥"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 96,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ يَجْعَلُونَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ ۚ فَسَوْفَ يَعْلَمُونَ ۝٩٦"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 97,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ ۝٩٧"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 98,
      "besmele_var_mi": false,
      "metin": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُن مِّنَ ٱلسَّٰجِدِينَ ۝٩٨"
    },
    {
      "sure_no": 15,
      "sure_adi": "Al-Hijr",
      "ayet_no": 99,
      "besmele_var_mi": false,
      "metin": "وَٱعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ ٱلْيَقِينُ ۝٩٩"
    },
    {
      "sure_no": 16,
      "sure_adi": "An-Nahl",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَتَىٰٓ أَمْرُ ٱللَّهِ فَلَا تَسْتَعْجِلُوهُ ۚ سُبْحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشْرِكُونَ ۝١"
    },
    {
      "sure_no": 16,
      "sure_adi": "An-Nahl",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "يُنَزِّلُ ٱلْمَلَٰٓئِكَةَ بِٱلرُّوحِ مِنْ أَمْرِهِۦ عَلَىٰ مَن يَشَآءُ مِنْ عِبَادِهِۦٓ أَنْ أَنذِرُوٓا۟ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱتَّقُونِ ۝٢"
    },
    {
      "sure_no": 16,
      "sure_adi": "An-Nahl",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۚ تَعَٰلَىٰ عَمَّا يُشْرِكُونَ ۝٣"
    },
    {
      "sure_no": 16,
      "sure_adi": "An-Nahl",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "خَلَقَ ٱلْإِنسَٰنَ مِن نُّطْفَةٍۢ فَإِذَا هُوَ خَصِيمٌۭ مُّبِينٌۭ ۝٤"
    },
    {
      "sure_no": 16,
      "sure_adi": "An-Nahl",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَٱلْأَنْعَٰمَ خَلَقَهَا ۗ لَكُمْ فِيهَا دِفْءٌۭ وَمَنَٰفِعُ وَمِنْهَا تَأْكُلُونَ ۝٥"
    },
    {
      "sure_no": 16,
      "sure_adi": "An-Nahl",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَلَكُمْ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسْرَحُونَ ۝٦"
    }
  ]
}