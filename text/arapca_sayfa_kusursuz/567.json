{
  "sayfa_no": 567,
  "ayetler": [
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ ۝٩"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً ۝١٠"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ ۝١١"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ ۝١٢"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ ۝١٣"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ ۝١٤"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ ۝١٥"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ ۝١٦"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَٰنِيَةٌۭ ۝١٧"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ ۝١٨"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ ۝١٩"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ ۝٢٠"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ ۝٢١"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "فِى جَنَّةٍ عَالِيَةٍۢ ۝٢٢"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "قُطُوفُهَا دَانِيَةٌۭ ۝٢٣"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ ۝٢٤"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ ۝٢٥"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ ۝٢٦"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ ۝٢٧"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ ۝٢٨"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "هَلَكَ عَنِّى سُلْطَٰنِيَهْ ۝٢٩"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "خُذُوهُ فَغُلُّوهُ ۝٣٠"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ ۝٣١"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ ۝٣٢"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ ۝٣٣"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ ۝٣٤"
    }
  ]
}