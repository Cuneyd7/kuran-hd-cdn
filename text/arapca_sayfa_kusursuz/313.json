{
  "sayfa_no": 313,
  "ayetler": [
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ ۝١٣"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "إِنَّنِىٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ ۝١٤"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا تَسْعَىٰ ۝١٥"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ ۝١٦"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوسَىٰ ۝١٧"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ ۝١٨"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "قَالَ أَلْقِهَا يَٰمُوسَىٰ ۝١٩"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "فَأَلْقَىٰهَا فَإِذَا هِىَ حَيَّةٌۭ تَسْعَىٰ ۝٢٠"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "قَالَ خُذْهَا وَلَا تَخَفْ ۖ سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ ۝٢١"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "وَٱضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ ۝٢٢"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "لِنُرِيَكَ مِنْ ءَايَٰتِنَا ٱلْكُبْرَى ۝٢٣"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ ۝٢٤"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى ۝٢٥"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "وَيَسِّرْ لِىٓ أَمْرِى ۝٢٦"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "وَٱحْلُلْ عُقْدَةًۭ مِّن لِّسَانِى ۝٢٧"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "يَفْقَهُوا۟ قَوْلِى ۝٢٨"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "وَٱجْعَل لِّى وَزِيرًۭا مِّنْ أَهْلِى ۝٢٩"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "هَٰرُونَ أَخِى ۝٣٠"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "ٱشْدُدْ بِهِۦٓ أَزْرِى ۝٣١"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "وَأَشْرِكْهُ فِىٓ أَمْرِى ۝٣٢"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "كَىْ نُسَبِّحَكَ كَثِيرًۭا ۝٣٣"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "وَنَذْكُرَكَ كَثِيرًا ۝٣٤"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "إِنَّكَ كُنتَ بِنَا بَصِيرًۭا ۝٣٥"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَٰمُوسَىٰ ۝٣٦"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً أُخْرَىٰٓ ۝٣٧"
    }
  ]
}