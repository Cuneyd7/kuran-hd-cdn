{
  "sayfa_no": 590,
  "ayetler": [
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ ۝١"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَٱلْيَوْمِ ٱلْمَوْعُودِ ۝٢"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَشَاهِدٍۢ وَمَشْهُودٍۢ ۝٣"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ ۝٤"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ ۝٥"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ ۝٦"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ ۝٧"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ ۝٨"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ ۝٩"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ ۝١٠"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ ۝١١"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ ۝١٢"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ ۝١٣"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ ۝١٤"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ ۝١٥"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "فَعَّالٌۭ لِّمَا يُرِيدُ ۝١٦"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ ۝١٧"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "فِرْعَوْنَ وَثَمُودَ ۝١٨"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ ۝١٩"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ ۝٢٠"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ ۝٢١"
    },
    {
      "sure_no": 85,
      "sure_adi": "Al-Burooj",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "فِى لَوْحٍۢ مَّحْفُوظٍۭ ۝٢٢"
    }
  ]
}