{
  "sayfa_no": 586,
  "ayetler": [
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ ۝١"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ ۝٢"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ ۝٣"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ ۝٤"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ ۝٥"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ ۝٦"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ ۝٧"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ ۝٨"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ ۝٩"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ ۝١٠"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ ۝١١"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ ۝١٢"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ ۝١٣"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ ۝١٤"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ ۝١٥"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "ٱلْجَوَارِ ٱلْكُنَّسِ ۝١٦"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَٱلَّيْلِ إِذَا عَسْعَسَ ۝١٧"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ ۝١٨"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ ۝١٩"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ ۝٢٠"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ ۝٢١"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ ۝٢٢"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ ۝٢٣"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ ۝٢٤"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ ۝٢٥"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "فَأَيْنَ تَذْهَبُونَ ۝٢٦"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ ۝٢٧"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ ۝٢٨"
    },
    {
      "sure_no": 81,
      "sure_adi": "At-Takwir",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ ۝٢٩"
    }
  ]
}