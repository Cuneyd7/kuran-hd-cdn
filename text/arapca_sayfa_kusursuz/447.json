{
  "sayfa_no": 447,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "مَا لَكُمْ لَا تَنَاصَرُونَ ۝٢٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ ۝٢٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ ۝٢٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ ۝٢٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ ۝٢٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًۭا طَٰغِينَ ۝٣٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ ۝٣١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ ۝٣٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "فَإِنَّهُمْ يَوْمَئِذٍۢ فِى ٱلْعَذَابِ مُشْتَرِكُونَ ۝٣٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ ۝٣٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ ۝٣٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍۢ مَّجْنُونٍۭ ۝٣٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ ۝٣٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ ۝٣٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ ۝٣٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ ۝٤٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌۭ مَّعْلُومٌۭ ۝٤١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ ۝٤٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "فِى جَنَّٰتِ ٱلنَّعِيمِ ۝٤٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "عَلَىٰ سُرُرٍۢ مُّتَقَٰبِلِينَ ۝٤٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "يُطَافُ عَلَيْهِم بِكَأْسٍۢ مِّن مَّعِينٍۭ ۝٤٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "بَيْضَآءَ لَذَّةٍۢ لِّلشَّٰرِبِينَ ۝٤٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 47,
      "besmele_var_mi": false,
      "metin": "لَا فِيهَا غَوْلٌۭ وَلَا هُمْ عَنْهَا يُنزَفُونَ ۝٤٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌۭ ۝٤٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "كَأَنَّهُنَّ بَيْضٌۭ مَّكْنُونٌۭ ۝٤٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ ۝٥٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "قَالَ قَآئِلٌۭ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌۭ ۝٥١"
    }
  ]
}