{
  "sayfa_no": 520,
  "ayetler": [
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هُمْ أَشَدُّ مِنْهُم بَطْشًۭا فَنَقَّبُوا۟ فِى ٱلْبِلَٰدِ هَلْ مِن مَّحِيصٍ ۝٣٦"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَذِكْرَىٰ لِمَن كَانَ لَهُۥ قَلْبٌ أَوْ أَلْقَى ٱلسَّمْعَ وَهُوَ شَهِيدٌۭ ۝٣٧"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍۢ وَمَا مَسَّنَا مِن لُّغُوبٍۢ ۝٣٨"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "فَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ ٱلشَّمْسِ وَقَبْلَ ٱلْغُرُوبِ ۝٣٩"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَأَدْبَٰرَ ٱلسُّجُودِ ۝٤٠"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "وَٱسْتَمِعْ يَوْمَ يُنَادِ ٱلْمُنَادِ مِن مَّكَانٍۢ قَرِيبٍۢ ۝٤١"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "يَوْمَ يَسْمَعُونَ ٱلصَّيْحَةَ بِٱلْحَقِّ ۚ ذَٰلِكَ يَوْمُ ٱلْخُرُوجِ ۝٤٢"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "إِنَّا نَحْنُ نُحْىِۦ وَنُمِيتُ وَإِلَيْنَا ٱلْمَصِيرُ ۝٤٣"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "يَوْمَ تَشَقَّقُ ٱلْأَرْضُ عَنْهُمْ سِرَاعًۭا ۚ ذَٰلِكَ حَشْرٌ عَلَيْنَا يَسِيرٌۭ ۝٤٤"
    },
    {
      "sure_no": 50,
      "sure_adi": "Qaaf",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ ۖ وَمَآ أَنتَ عَلَيْهِم بِجَبَّارٍۢ ۖ فَذَكِّرْ بِٱلْقُرْءَانِ مَن يَخَافُ وَعِيدِ ۝٤٥"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلذَّٰرِيَٰتِ ذَرْوًۭا ۝١"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "فَٱلْحَٰمِلَٰتِ وِقْرًۭا ۝٢"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "فَٱلْجَٰرِيَٰتِ يُسْرًۭا ۝٣"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "فَٱلْمُقَسِّمَٰتِ أَمْرًا ۝٤"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "إِنَّمَا تُوعَدُونَ لَصَادِقٌۭ ۝٥"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌۭ ۝٦"
    }
  ]
}