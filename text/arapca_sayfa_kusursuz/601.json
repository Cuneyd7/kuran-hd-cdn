{
  "sayfa_no": 601,
  "ayetler": [
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ ۝١"
    },
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ ۝٢"
    },
    {
      "sure_no": 103,
      "sure_adi": "Al-Asr",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ ۝٣"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ ۝١"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ ۝٢"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ ۝٣"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ ۝٤"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ ۝٥"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ ۝٦"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ ۝٧"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ ۝٨"
    },
    {
      "sure_no": 104,
      "sure_adi": "Al-Humaza",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ ۝٩"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ ۝١"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ ۝٢"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ ۝٣"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ ۝٤"
    },
    {
      "sure_no": 105,
      "sure_adi": "Al-Fil",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ ۝٥"
    }
  ]
}