    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ۝٣"
