    {
      "sure_no": 112,
      "sure_adi": "Al-Ikhlaas",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ ۝٤"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ ۝١"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "مِن شَرِّ مَا خَلَقَ ۝٢"
