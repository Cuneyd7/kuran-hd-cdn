      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ ۝٤"
    },
    {
      "sure_no": 113,
      "sure_adi": "Al-Falaq",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ ۝٥"
    },
    {
      "sure_no": 114,
      "sure_adi": "An-Naas",
