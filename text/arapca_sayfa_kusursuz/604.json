      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ ۝١"
    },
    {
      "sure_no": 112,
      "sure_adi": "Al-Ikhlaas",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "ٱللَّهُ ٱلصَّمَدُ ۝٢"
    },
    {
      "sure_no": 112,
      "sure_adi": "Al-Ikhlaas",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "لَمْ يَلِدْ وَلَمْ يُولَدْ ۝٣"
