{
  "sayfa_no": 521,
  "ayetler": [
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَٱلسَّمَآءِ ذَاتِ ٱلْحُبُكِ ۝٧"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "إِنَّكُمْ لَفِى قَوْلٍۢ مُّخْتَلِفٍۢ ۝٨"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "يُؤْفَكُ عَنْهُ مَنْ أُفِكَ ۝٩"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "قُتِلَ ٱلْخَرَّٰصُونَ ۝١٠"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍۢ سَاهُونَ ۝١١"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "يَسْـَٔلُونَ أَيَّانَ يَوْمُ ٱلدِّينِ ۝١٢"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ ۝١٣"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "ذُوقُوا۟ فِتْنَتَكُمْ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ ۝١٤"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَعُيُونٍ ۝١٥"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ ۝١٦"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "كَانُوا۟ قَلِيلًۭا مِّنَ ٱلَّيْلِ مَا يَهْجَعُونَ ۝١٧"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "وَبِٱلْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ ۝١٨"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَفِىٓ أَمْوَٰلِهِمْ حَقٌّۭ لِّلسَّآئِلِ وَٱلْمَحْرُومِ ۝١٩"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "وَفِى ٱلْأَرْضِ ءَايَٰتٌۭ لِّلْمُوقِنِينَ ۝٢٠"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "وَفِىٓ أَنفُسِكُمْ ۚ أَفَلَا تُبْصِرُونَ ۝٢١"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "وَفِى ٱلسَّمَآءِ رِزْقُكُمْ وَمَا تُوعَدُونَ ۝٢٢"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "فَوَرَبِّ ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّۭ مِّثْلَ مَآ أَنَّكُمْ تَنطِقُونَ ۝٢٣"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "هَلْ أَتَىٰكَ حَدِيثُ ضَيْفِ إِبْرَٰهِيمَ ٱلْمُكْرَمِينَ ۝٢٤"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَٰمًۭا ۖ قَالَ سَلَٰمٌۭ قَوْمٌۭ مُّنكَرُونَ ۝٢٥"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "فَرَاغَ إِلَىٰٓ أَهْلِهِۦ فَجَآءَ بِعِجْلٍۢ سَمِينٍۢ ۝٢٦"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "فَقَرَّبَهُۥٓ إِلَيْهِمْ قَالَ أَلَا تَأْكُلُونَ ۝٢٧"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "فَأَوْجَسَ مِنْهُمْ خِيفَةًۭ ۖ قَالُوا۟ لَا تَخَفْ ۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٍۢ ۝٢٨"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "فَأَقْبَلَتِ ٱمْرَأَتُهُۥ فِى صَرَّةٍۢ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌۭ ۝٢٩"
    },
    {
      "sure_no": 51,
      "sure_adi": "Adh-Dhaariyat",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ كَذَٰلِكِ قَالَ رَبُّكِ ۖ إِنَّهُۥ هُوَ ٱلْحَكِيمُ ٱلْعَلِيمُ ۝٣٠"
    }
  ]
}