{
  "sayfa_no": 452,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 154,
      "besmele_var_mi": false,
      "metin": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ ۝١٥٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 155,
      "besmele_var_mi": false,
      "metin": "أَفَلَا تَذَكَّرُونَ ۝١٥٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 156,
      "besmele_var_mi": false,
      "metin": "أَمْ لَكُمْ سُلْطَٰنٌۭ مُّبِينٌۭ ۝١٥٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 157,
      "besmele_var_mi": false,
      "metin": "فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ ۝١٥٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 158,
      "besmele_var_mi": false,
      "metin": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًۭا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ ۝١٥٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 159,
      "besmele_var_mi": false,
      "metin": "سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ ۝١٥٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 160,
      "besmele_var_mi": false,
      "metin": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ ۝١٦٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 161,
      "besmele_var_mi": false,
      "metin": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ ۝١٦١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 162,
      "besmele_var_mi": false,
      "metin": "مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ ۝١٦٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 163,
      "besmele_var_mi": false,
      "metin": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ ۝١٦٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 164,
      "besmele_var_mi": false,
      "metin": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌۭ مَّعْلُومٌۭ ۝١٦٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 165,
      "besmele_var_mi": false,
      "metin": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ ۝١٦٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 166,
      "besmele_var_mi": false,
      "metin": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ ۝١٦٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 167,
      "besmele_var_mi": false,
      "metin": "وَإِن كَانُوا۟ لَيَقُولُونَ ۝١٦٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 168,
      "besmele_var_mi": false,
      "metin": "لَوْ أَنَّ عِندَنَا ذِكْرًۭا مِّنَ ٱلْأَوَّلِينَ ۝١٦٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 169,
      "besmele_var_mi": false,
      "metin": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ ۝١٦٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 170,
      "besmele_var_mi": false,
      "metin": "فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ ۝١٧٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 171,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ ۝١٧١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 172,
      "besmele_var_mi": false,
      "metin": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ ۝١٧٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 173,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ ۝١٧٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 174,
      "besmele_var_mi": false,
      "metin": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ ۝١٧٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 175,
      "besmele_var_mi": false,
      "metin": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ ۝١٧٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 176,
      "besmele_var_mi": false,
      "metin": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ ۝١٧٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 177,
      "besmele_var_mi": false,
      "metin": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ ۝١٧٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 178,
      "besmele_var_mi": false,
      "metin": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ ۝١٧٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 179,
      "besmele_var_mi": false,
      "metin": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ ۝١٧٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 180,
      "besmele_var_mi": false,
      "metin": "سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ ۝١٨٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 181,
      "besmele_var_mi": false,
      "metin": "وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ ۝١٨١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 182,
      "besmele_var_mi": false,
      "metin": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ۝١٨٢"
    }
  ]
}