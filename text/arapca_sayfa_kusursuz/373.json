{
  "sayfa_no": 373,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 137,
      "besmele_var_mi": false,
      "metin": "إِنْ هَٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ ۝١٣٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 138,
      "besmele_var_mi": false,
      "metin": "وَمَا نَحْنُ بِمُعَذَّبِينَ ۝١٣٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 139,
      "besmele_var_mi": false,
      "metin": "فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمْ ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ ۝١٣٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 140,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ۝١٤٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 141,
      "besmele_var_mi": false,
      "metin": "كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ ۝١٤١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 142,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لَهُمْ أَخُوهُمْ صَٰلِحٌ أَلَا تَتَّقُونَ ۝١٤٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 143,
      "besmele_var_mi": false,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ ۝١٤٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 144,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١٤٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 145,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ ۝١٤٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 146,
      "besmele_var_mi": false,
      "metin": "أَتُتْرَكُونَ فِى مَا هَٰهُنَآ ءَامِنِينَ ۝١٤٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 147,
      "besmele_var_mi": false,
      "metin": "فِى جَنَّٰتٍۢ وَعُيُونٍۢ ۝١٤٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 148,
      "besmele_var_mi": false,
      "metin": "وَزُرُوعٍۢ وَنَخْلٍۢ طَلْعُهَا هَضِيمٌۭ ۝١٤٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 149,
      "besmele_var_mi": false,
      "metin": "وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًۭا فَٰرِهِينَ ۝١٤٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 150,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١٥٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 151,
      "besmele_var_mi": false,
      "metin": "وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ ۝١٥١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 152,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ ۝١٥٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 153,
      "besmele_var_mi": false,
      "metin": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ ۝١٥٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 154,
      "besmele_var_mi": false,
      "metin": "مَآ أَنتَ إِلَّا بَشَرٌۭ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ۝١٥٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 155,
      "besmele_var_mi": false,
      "metin": "قَالَ هَٰذِهِۦ نَاقَةٌۭ لَّهَا شِرْبٌۭ وَلَكُمْ شِرْبُ يَوْمٍۢ مَّعْلُومٍۢ ۝١٥٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 156,
      "besmele_var_mi": false,
      "metin": "وَلَا تَمَسُّوهَا بِسُوٓءٍۢ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٍۢ ۝١٥٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 157,
      "besmele_var_mi": false,
      "metin": "فَعَقَرُوهَا فَأَصْبَحُوا۟ نَٰدِمِينَ ۝١٥٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 158,
      "besmele_var_mi": false,
      "metin": "فَأَخَذَهُمُ ٱلْعَذَابُ ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ ۝١٥٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 159,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ۝١٥٩"
    }
  ]
}