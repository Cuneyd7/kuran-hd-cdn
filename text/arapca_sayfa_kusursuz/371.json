{
  "sayfa_no": 371,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 84,
      "besmele_var_mi": false,
      "metin": "وَٱجْعَل لِّى لِسَانَ صِدْقٍۢ فِى ٱلْءَاخِرِينَ ۝٨٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 85,
      "besmele_var_mi": false,
      "metin": "وَٱجْعَلْنِى مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ ۝٨٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 86,
      "besmele_var_mi": false,
      "metin": "وَٱغْفِرْ لِأَبِىٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ ۝٨٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 87,
      "besmele_var_mi": false,
      "metin": "وَلَا تُخْزِنِى يَوْمَ يُبْعَثُونَ ۝٨٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 88,
      "besmele_var_mi": false,
      "metin": "يَوْمَ لَا يَنفَعُ مَالٌۭ وَلَا بَنُونَ ۝٨٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 89,
      "besmele_var_mi": false,
      "metin": "إِلَّا مَنْ أَتَى ٱللَّهَ بِقَلْبٍۢ سَلِيمٍۢ ۝٨٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 90,
      "besmele_var_mi": false,
      "metin": "وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ ۝٩٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 91,
      "besmele_var_mi": false,
      "metin": "وَبُرِّزَتِ ٱلْجَحِيمُ لِلْغَاوِينَ ۝٩١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 92,
      "besmele_var_mi": false,
      "metin": "وَقِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ ۝٩٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 93,
      "besmele_var_mi": false,
      "metin": "مِن دُونِ ٱللَّهِ هَلْ يَنصُرُونَكُمْ أَوْ يَنتَصِرُونَ ۝٩٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 94,
      "besmele_var_mi": false,
      "metin": "فَكُبْكِبُوا۟ فِيهَا هُمْ وَٱلْغَاوُۥنَ ۝٩٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 95,
      "besmele_var_mi": false,
      "metin": "وَجُنُودُ إِبْلِيسَ أَجْمَعُونَ ۝٩٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 96,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ وَهُمْ فِيهَا يَخْتَصِمُونَ ۝٩٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 97,
      "besmele_var_mi": false,
      "metin": "تَٱللَّهِ إِن كُنَّا لَفِى ضَلَٰلٍۢ مُّبِينٍ ۝٩٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 98,
      "besmele_var_mi": false,
      "metin": "إِذْ نُسَوِّيكُم بِرَبِّ ٱلْعَٰلَمِينَ ۝٩٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 99,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَضَلَّنَآ إِلَّا ٱلْمُجْرِمُونَ ۝٩٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 100,
      "besmele_var_mi": false,
      "metin": "فَمَا لَنَا مِن شَٰفِعِينَ ۝١٠٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 101,
      "besmele_var_mi": false,
      "metin": "وَلَا صَدِيقٍ حَمِيمٍۢ ۝١٠١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 102,
      "besmele_var_mi": false,
      "metin": "فَلَوْ أَنَّ لَنَا كَرَّةًۭ فَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ ۝١٠٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 103,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ ۝١٠٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 104,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ۝١٠٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 105,
      "besmele_var_mi": false,
      "metin": "كَذَّبَتْ قَوْمُ نُوحٍ ٱلْمُرْسَلِينَ ۝١٠٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 106,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لَهُمْ أَخُوهُمْ نُوحٌ أَلَا تَتَّقُونَ ۝١٠٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 107,
      "besmele_var_mi": false,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ ۝١٠٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 108,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١٠٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 109,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ ۝١٠٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 110,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١١٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 111,
      "besmele_var_mi": false,
      "metin": "۞ قَالُوٓا۟ أَنُؤْمِنُ لَكَ وَٱتَّبَعَكَ ٱلْأَرْذَلُونَ ۝١١١"
    }
  ]
}