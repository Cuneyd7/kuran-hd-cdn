{
  "sayfa_no": 595,
  "ayetler": [
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا ۝١"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا ۝٢"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا ۝٣"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا ۝٤"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا ۝٥"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا ۝٦"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا ۝٧"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا ۝٨"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا ۝٩"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَقَدْ خَابَ مَن دَسَّىٰهَا ۝١٠"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ ۝١١"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا ۝١٢"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا ۝١٣"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا ۝١٤"
    },
    {
      "sure_no": 91,
      "sure_adi": "Ash-Shams",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "وَلَا يَخَافُ عُقْبَٰهَا ۝١٥"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ ۝١"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ۝٢"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ ۝٣"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ ۝٤"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ ۝٥"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَصَدَّقَ بِٱلْحُسْنَىٰ ۝٦"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ ۝٧"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ ۝٨"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَكَذَّبَ بِٱلْحُسْنَىٰ ۝٩"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ ۝١٠"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ۝١١"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "إِنَّ عَلَيْنَا لَلْهُدَىٰ ۝١٢"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ ۝١٣"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ ۝١٤"
    }
  ]
}