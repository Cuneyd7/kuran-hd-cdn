{
  "sayfa_no": 565,
  "ayetler": [
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ ۝١٦"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ ۝١٧"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "وَلَا يَسْتَثْنُونَ ۝١٨"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ ۝١٩"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "فَأَصْبَحَتْ كَٱلصَّرِيمِ ۝٢٠"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "فَتَنَادَوْا۟ مُصْبِحِينَ ۝٢١"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ ۝٢٢"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ ۝٢٣"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ ۝٢٤"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ ۝٢٥"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ ۝٢٦"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "بَلْ نَحْنُ مَحْرُومُونَ ۝٢٧"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ ۝٢٨"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ ۝٢٩"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ ۝٣٠"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ ۝٣١"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ ۝٣٢"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ ۝٣٣"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ ۝٣٤"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ ۝٣٥"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ ۝٣٦"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ ۝٣٧"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ ۝٣٨"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ ۝٣٩"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ ۝٤٠"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ ۝٤١"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ ۝٤٢"
    }
  ]
}