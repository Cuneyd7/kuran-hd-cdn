    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ ۝٨"
