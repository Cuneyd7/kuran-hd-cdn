      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ ۝٦"
