      "sure_adi": "Az-Zalzala",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا ۝١"
    },
    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا ۝٢"
