    {
      "sure_no": 99,
      "sure_adi": "Az-Zalzala",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا ۝٥"
