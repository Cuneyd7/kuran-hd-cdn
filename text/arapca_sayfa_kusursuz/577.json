{
  "sayfa_no": 577,
  "ayetler": [
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ ۝٤٨"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ ۝٤٩"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ ۝٥٠"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "فَرَّتْ مِن قَسْوَرَةٍۭ ۝٥١"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ ۝٥٢"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 53,
      "besmele_var_mi": false,
      "metin": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ ۝٥٣"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 54,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ ۝٥٤"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 55,
      "besmele_var_mi": false,
      "metin": "فَمَن شَآءَ ذَكَرَهُۥ ۝٥٥"
    },
    {
      "sure_no": 74,
      "sure_adi": "Al-Muddaththir",
      "ayet_no": 56,
      "besmele_var_mi": false,
      "metin": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ ۝٥٦"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ ۝١"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ ۝٢"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ ۝٣"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ ۝٤"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ ۝٥"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ ۝٦"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "فَإِذَا بَرِقَ ٱلْبَصَرُ ۝٧"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَخَسَفَ ٱلْقَمَرُ ۝٨"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ ۝٩"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ ۝١٠"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "كَلَّا لَا وَزَرَ ۝١١"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ ۝١٢"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ ۝١٣"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ ۝١٤"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ ۝١٥"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ ۝١٦"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ ۝١٧"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ ۝١٨"
    },
    {
      "sure_no": 75,
      "sure_adi": "Al-Qiyaama",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ ۝١٩"
    }
  ]
}