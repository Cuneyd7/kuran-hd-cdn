{
  "sayfa_no": 537,
  "ayetler": [
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 77,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ ۝٧٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 78,
      "besmele_var_mi": false,
      "metin": "فِى كِتَٰبٍۢ مَّكْنُونٍۢ ۝٧٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 79,
      "besmele_var_mi": false,
      "metin": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ ۝٧٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 80,
      "besmele_var_mi": false,
      "metin": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ ۝٨٠"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 81,
      "besmele_var_mi": false,
      "metin": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ ۝٨١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 82,
      "besmele_var_mi": false,
      "metin": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ ۝٨٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 83,
      "besmele_var_mi": false,
      "metin": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ ۝٨٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 84,
      "besmele_var_mi": false,
      "metin": "وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ ۝٨٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 85,
      "besmele_var_mi": false,
      "metin": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ ۝٨٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 86,
      "besmele_var_mi": false,
      "metin": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ ۝٨٦"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 87,
      "besmele_var_mi": false,
      "metin": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ ۝٨٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 88,
      "besmele_var_mi": false,
      "metin": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ ۝٨٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 89,
      "besmele_var_mi": false,
      "metin": "فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ ۝٨٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 90,
      "besmele_var_mi": false,
      "metin": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ ۝٩٠"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 91,
      "besmele_var_mi": false,
      "metin": "فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ ۝٩١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 92,
      "besmele_var_mi": false,
      "metin": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ ۝٩٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 93,
      "besmele_var_mi": false,
      "metin": "فَنُزُلٌۭ مِّنْ حَمِيمٍۢ ۝٩٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 94,
      "besmele_var_mi": false,
      "metin": "وَتَصْلِيَةُ جَحِيمٍ ۝٩٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 95,
      "besmele_var_mi": false,
      "metin": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ ۝٩٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 96,
      "besmele_var_mi": false,
      "metin": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ ۝٩٦"
    },
    {
      "sure_no": 57,
      "sure_adi": "Al-Hadid",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ۝١"
    },
    {
      "sure_no": 57,
      "sure_adi": "Al-Hadid",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍۢ قَدِيرٌ ۝٢"
    },
    {
      "sure_no": 57,
      "sure_adi": "Al-Hadid",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "هُوَ ٱلْأَوَّلُ وَٱلْءَاخِرُ وَٱلظَّٰهِرُ وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ ۝٣"
    }
  ]
}