{
  "sayfa_no": 588,
  "ayetler": [
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ ۝٧"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ ۝٨"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "كِتَٰبٌۭ مَّرْقُومٌۭ ۝٩"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝١٠"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ ۝١١"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ ۝١٢"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ ۝١٣"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ ۝١٤"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ ۝١٥"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ ۝١٦"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ ۝١٧"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ ۝١٨"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ ۝١٩"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "كِتَٰبٌۭ مَّرْقُومٌۭ ۝٢٠"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ ۝٢١"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ ۝٢٢"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ ۝٢٣"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ ۝٢٤"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ ۝٢٥"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ ۝٢٦"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ ۝٢٧"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ ۝٢٨"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ ۝٢٩"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ ۝٣٠"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ ۝٣١"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ ۝٣٢"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ ۝٣٣"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ ۝٣٤"
    }
  ]
}