{
  "sayfa_no": 566,
  "ayetler": [
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ ۝٤٣"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ ۝٤٤"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ ۝٤٥"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ ۝٤٦"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 47,
      "besmele_var_mi": false,
      "metin": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ ۝٤٧"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ ۝٤٨"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ ۝٤٩"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ ۝٥٠"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ ۝٥١"
    },
    {
      "sure_no": 68,
      "sure_adi": "Al-Qalam",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "وَمَا هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ ۝٥٢"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ ۝١"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "مَا ٱلْحَآقَّةُ ۝٢"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ ۝٣"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ ۝٤"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ ۝٥"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ ۝٦"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ ۝٧"
    },
    {
      "sure_no": 69,
      "sure_adi": "Al-Haaqqa",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ ۝٨"
    }
  ]
}