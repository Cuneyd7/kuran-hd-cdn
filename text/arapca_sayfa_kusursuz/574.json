{
  "sayfa_no": 574,
  "ayetler": [
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُزَّمِّلُ ۝١"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "قُمِ ٱلَّيْلَ إِلَّا قَلِيلًۭا ۝٢"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "نِّصْفَهُۥٓ أَوِ ٱنقُصْ مِنْهُ قَلِيلًا ۝٣"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "أَوْ زِدْ عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ تَرْتِيلًا ۝٤"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "إِنَّا سَنُلْقِى عَلَيْكَ قَوْلًۭا ثَقِيلًا ۝٥"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "إِنَّ نَاشِئَةَ ٱلَّيْلِ هِىَ أَشَدُّ وَطْـًۭٔا وَأَقْوَمُ قِيلًا ۝٦"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "إِنَّ لَكَ فِى ٱلنَّهَارِ سَبْحًۭا طَوِيلًۭا ۝٧"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَٱذْكُرِ ٱسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًۭا ۝٨"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "رَّبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ لَآ إِلَٰهَ إِلَّا هُوَ فَٱتَّخِذْهُ وَكِيلًۭا ۝٩"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱهْجُرْهُمْ هَجْرًۭا جَمِيلًۭا ۝١٠"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "وَذَرْنِى وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا ۝١١"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "إِنَّ لَدَيْنَآ أَنكَالًۭا وَجَحِيمًۭا ۝١٢"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "وَطَعَامًۭا ذَا غُصَّةٍۢ وَعَذَابًا أَلِيمًۭا ۝١٣"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "يَوْمَ تَرْجُفُ ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ ٱلْجِبَالُ كَثِيبًۭا مَّهِيلًا ۝١٤"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًۭا شَٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًۭا ۝١٥"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "فَعَصَىٰ فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَٰهُ أَخْذًۭا وَبِيلًۭا ۝١٦"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْمًۭا يَجْعَلُ ٱلْوِلْدَٰنَ شِيبًا ۝١٧"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "ٱلسَّمَآءُ مُنفَطِرٌۢ بِهِۦ ۚ كَانَ وَعْدُهُۥ مَفْعُولًا ۝١٨"
    },
    {
      "sure_no": 73,
      "sure_adi": "Al-Muzzammil",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "إِنَّ هَٰذِهِۦ تَذْكِرَةٌۭ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا ۝١٩"
    }
  ]
}