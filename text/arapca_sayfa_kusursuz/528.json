{
  "sayfa_no": 528,
  "ayetler": [
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ ۝٤٥"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ ۝٤٦"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 47,
      "besmele_var_mi": false,
      "metin": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ ۝٤٧"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ ۝٤٨"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ ۝٤٩"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ ۝٥٠"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ ۝٥١"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ ۝٥٢"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 53,
      "besmele_var_mi": false,
      "metin": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ ۝٥٣"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 54,
      "besmele_var_mi": false,
      "metin": "فَغَشَّىٰهَا مَا غَشَّىٰ ۝٥٤"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 55,
      "besmele_var_mi": false,
      "metin": "فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ ۝٥٥"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 56,
      "besmele_var_mi": false,
      "metin": "هَٰذَا نَذِيرٌۭ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ ۝٥٦"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 57,
      "besmele_var_mi": false,
      "metin": "أَزِفَتِ ٱلْءَازِفَةُ ۝٥٧"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 58,
      "besmele_var_mi": false,
      "metin": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ ۝٥٨"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 59,
      "besmele_var_mi": false,
      "metin": "أَفَمِنْ هَٰذَا ٱلْحَدِيثِ تَعْجَبُونَ ۝٥٩"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 60,
      "besmele_var_mi": false,
      "metin": "وَتَضْحَكُونَ وَلَا تَبْكُونَ ۝٦٠"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 61,
      "besmele_var_mi": false,
      "metin": "وَأَنتُمْ سَٰمِدُونَ ۝٦١"
    },
    {
      "sure_no": 53,
      "sure_adi": "An-Najm",
      "ayet_no": 62,
      "besmele_var_mi": false,
      "metin": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩ ۝٦٢"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ ۝١"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَإِن يَرَوْا۟ ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ ۝٢"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ ۝٣"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ ۝٤"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "حِكْمَةٌۢ بَٰلِغَةٌۭ ۖ فَمَا تُغْنِ ٱلنُّذُرُ ۝٥"
    },
    {
      "sure_no": 54,
      "sure_adi": "Al-Qamar",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍۢ نُّكُرٍ ۝٦"
    }
  ]
}