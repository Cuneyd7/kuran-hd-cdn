    {
      "sure_no": 102,
      "sure_adi": "At-Takaathur",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ ۝٥"
