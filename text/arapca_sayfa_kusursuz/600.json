    {
      "sure_no": 102,
      "sure_adi": "At-Takaathur",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ ۝٤"
