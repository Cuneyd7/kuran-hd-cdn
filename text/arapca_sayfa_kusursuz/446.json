{
  "sayfa_no": 446,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّۭا ۝١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "فَٱلزَّٰجِرَٰتِ زَجْرًۭا ۝٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "فَٱلتَّٰلِيَٰتِ ذِكْرًا ۝٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌۭ ۝٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ ۝٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ ۝٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَحِفْظًۭا مِّن كُلِّ شَيْطَٰنٍۢ مَّارِدٍۢ ۝٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍۢ ۝٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "دُحُورًۭا ۖ وَلَهُمْ عَذَابٌۭ وَاصِبٌ ۝٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ ۝١٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍۢ لَّازِبٍۭ ۝١١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "بَلْ عَجِبْتَ وَيَسْخَرُونَ ۝١٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ ۝١٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَإِذَا رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ ۝١٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ مُّبِينٌ ۝١٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ ۝١٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ ۝١٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ ۝١٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ فَإِذَا هُمْ يَنظُرُونَ ۝١٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ ۝٢٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ ۝٢١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ ۝٢٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ ۝٢٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ ۝٢٤"
    }
  ]
}