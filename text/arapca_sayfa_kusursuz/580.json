{
  "sayfa_no": 580,
  "ayetler": [
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًۭا طَوِيلًا ۝٢٦"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًۭا ثَقِيلًۭا ۝٢٧"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلًا ۝٢٨"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "إِنَّ هَٰذِهِۦ تَذْكِرَةٌۭ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًۭا ۝٢٩"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًۭا ۝٣٠"
    },
    {
      "sure_no": 76,
      "sure_adi": "Al-Insaan",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ ۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا ۝٣١"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا ۝١"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا ۝٢"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا ۝٣"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا ۝٤"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَٱلْمُلْقِيَٰتِ ذِكْرًا ۝٥"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "عُذْرًا أَوْ نُذْرًا ۝٦"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ ۝٧"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ ۝٨"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ ۝٩"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ ۝١٠"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ ۝١١"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "لِأَىِّ يَوْمٍ أُجِّلَتْ ۝١٢"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "لِيَوْمِ ٱلْفَصْلِ ۝١٣"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ ۝١٤"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝١٥"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ ۝١٦"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ ۝١٧"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ ۝١٨"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝١٩"
    }
  ]
}