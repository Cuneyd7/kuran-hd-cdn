{
  "sayfa_no": 597,
  "ayetler": [
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ ۝١"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَطُورِ سِينِينَ ۝٢"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ ۝٣"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ ۝٤"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ ۝٥"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ ۝٦"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ ۝٧"
    },
    {
      "sure_no": 95,
      "sure_adi": "At-Tin",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ ۝٨"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ ۝١"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ ۝٢"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ ۝٣"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ ۝٤"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ ۝٥"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ ۝٦"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ ۝٧"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ ۝٨"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ ۝٩"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "عَبْدًا إِذَا صَلَّىٰٓ ۝١٠"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ ۝١١"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ ۝١٢"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ ۝١٣"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ ۝١٤"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ ۝١٥"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ ۝١٦"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "فَلْيَدْعُ نَادِيَهُۥ ۝١٧"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "سَنَدْعُ ٱلزَّبَانِيَةَ ۝١٨"
    },
    {
      "sure_no": 96,
      "sure_adi": "Al-Alaq",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩ ۝١٩"
    }
  ]
}