{
  "sayfa_no": 592,
  "ayetler": [
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا ۝١٦"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ ۝١٧"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ ۝١٨"
    },
    {
      "sure_no": 87,
      "sure_adi": "Al-A'laa",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ ۝١٩"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ ۝١"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ ۝٢"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "عَامِلَةٌۭ نَّاصِبَةٌۭ ۝٣"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "تَصْلَىٰ نَارًا حَامِيَةًۭ ۝٤"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ ۝٥"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ ۝٦"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ ۝٧"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ ۝٨"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "لِّسَعْيِهَا رَاضِيَةٌۭ ۝٩"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "فِى جَنَّةٍ عَالِيَةٍۢ ۝١٠"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ ۝١١"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ ۝١٢"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ ۝١٣"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ ۝١٤"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "وَنَمَارِقُ مَصْفُوفَةٌۭ ۝١٥"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "وَزَرَابِىُّ مَبْثُوثَةٌ ۝١٦"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ ۝١٧"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ ۝١٨"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ ۝١٩"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ ۝٢٠"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ ۝٢١"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ ۝٢٢"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ۝٢٣"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ ۝٢٤"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "إِنَّ إِلَيْنَآ إِيَابَهُمْ ۝٢٥"
    },
    {
      "sure_no": 88,
      "sure_adi": "Al-Ghaashiya",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم ۝٢٦"
    }
  ]
}