{
  "sayfa_no": 376,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 207,
      "besmele_var_mi": false,
      "metin": "مَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يُمَتَّعُونَ ۝٢٠٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 208,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ ۝٢٠٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 209,
      "besmele_var_mi": false,
      "metin": "ذِكْرَىٰ وَمَا كُنَّا ظَٰلِمِينَ ۝٢٠٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 210,
      "besmele_var_mi": false,
      "metin": "وَمَا تَنَزَّلَتْ بِهِ ٱلشَّيَٰطِينُ ۝٢١٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 211,
      "besmele_var_mi": false,
      "metin": "وَمَا يَنۢبَغِى لَهُمْ وَمَا يَسْتَطِيعُونَ ۝٢١١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 212,
      "besmele_var_mi": false,
      "metin": "إِنَّهُمْ عَنِ ٱلسَّمْعِ لَمَعْزُولُونَ ۝٢١٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 213,
      "besmele_var_mi": false,
      "metin": "فَلَا تَدْعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلْمُعَذَّبِينَ ۝٢١٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 214,
      "besmele_var_mi": false,
      "metin": "وَأَنذِرْ عَشِيرَتَكَ ٱلْأَقْرَبِينَ ۝٢١٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 215,
      "besmele_var_mi": false,
      "metin": "وَٱخْفِضْ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلْمُؤْمِنِينَ ۝٢١٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 216,
      "besmele_var_mi": false,
      "metin": "فَإِنْ عَصَوْكَ فَقُلْ إِنِّى بَرِىٓءٌۭ مِّمَّا تَعْمَلُونَ ۝٢١٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 217,
      "besmele_var_mi": false,
      "metin": "وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ ۝٢١٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 218,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ ۝٢١٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 219,
      "besmele_var_mi": false,
      "metin": "وَتَقَلُّبَكَ فِى ٱلسَّٰجِدِينَ ۝٢١٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 220,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ۝٢٢٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 221,
      "besmele_var_mi": false,
      "metin": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَٰطِينُ ۝٢٢١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 222,
      "besmele_var_mi": false,
      "metin": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٍۢ ۝٢٢٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 223,
      "besmele_var_mi": false,
      "metin": "يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَٰذِبُونَ ۝٢٢٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 224,
      "besmele_var_mi": false,
      "metin": "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلْغَاوُۥنَ ۝٢٢٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 225,
      "besmele_var_mi": false,
      "metin": "أَلَمْ تَرَ أَنَّهُمْ فِى كُلِّ وَادٍۢ يَهِيمُونَ ۝٢٢٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 226,
      "besmele_var_mi": false,
      "metin": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَ ۝٢٢٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 227,
      "besmele_var_mi": false,
      "metin": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَذَكَرُوا۟ ٱللَّهَ كَثِيرًۭا وَٱنتَصَرُوا۟ مِنۢ بَعْدِ مَا ظُلِمُوا۟ ۗ وَسَيَعْلَمُ ٱلَّذِينَ ظَلَمُوٓا۟ أَىَّ مُنقَلَبٍۢ يَنقَلِبُونَ ۝٢٢٧"
    }
  ]
}