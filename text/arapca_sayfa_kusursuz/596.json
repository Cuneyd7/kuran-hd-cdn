{
  "sayfa_no": 596,
  "ayetler": [
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى ۝١٥"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ ۝١٦"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى ۝١٧"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ ۝١٨"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ ۝١٩"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ ۝٢٠"
    },
    {
      "sure_no": 92,
      "sure_adi": "Al-Lail",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "وَلَسَوْفَ يَرْضَىٰ ۝٢١"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ ۝١"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَٱلَّيْلِ إِذَا سَجَىٰ ۝٢"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ۝٣"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ ۝٤"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ ۝٥"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ ۝٦"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ ۝٧"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ ۝٨"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ ۝٩"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ ۝١٠"
    },
    {
      "sure_no": 93,
      "sure_adi": "Ad-Dhuhaa",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ۝١١"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ۝١"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَوَضَعْنَا عَنكَ وِزْرَكَ ۝٢"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ ۝٣"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَرَفَعْنَا لَكَ ذِكْرَكَ ۝٤"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا ۝٥"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا ۝٦"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "فَإِذَا فَرَغْتَ فَٱنصَبْ ۝٧"
    },
    {
      "sure_no": 94,
      "sure_adi": "Ash-Sharh",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "وَإِلَىٰ رَبِّكَ فَٱرْغَب ۝٨"
    }
  ]
}