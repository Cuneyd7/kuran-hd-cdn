{
  "sayfa_no": 312,
  "ayetler": [
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 96,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَيَجْعَلُ لَهُمُ ٱلرَّحْمَٰنُ وُدًّۭا ۝٩٦"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 97,
      "besmele_var_mi": false,
      "metin": "فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوْمًۭا لُّدًّۭا ۝٩٧"
    },
    {
      "sure_no": 19,
      "sure_adi": "Maryam",
      "ayet_no": 98,
      "besmele_var_mi": false,
      "metin": "وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هَلْ تُحِسُّ مِنْهُم مِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًۢا ۝٩٨"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ طه ۝١"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "مَآ أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ ۝٢"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "إِلَّا تَذْكِرَةًۭ لِّمَن يَخْشَىٰ ۝٣"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "تَنزِيلًۭا مِّمَّنْ خَلَقَ ٱلْأَرْضَ وَٱلسَّمَٰوَٰتِ ٱلْعُلَى ۝٤"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "ٱلرَّحْمَٰنُ عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ ۝٥"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ ۝٦"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "وَإِن تَجْهَرْ بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ وَأَخْفَى ۝٧"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ۝٨"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "وَهَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ۝٩"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "إِذْ رَءَا نَارًۭا فَقَالَ لِأَهْلِهِ ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ نَارًۭا لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى ٱلنَّارِ هُدًۭى ۝١٠"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "فَلَمَّآ أَتَىٰهَا نُودِىَ يَٰمُوسَىٰٓ ۝١١"
    },
    {
      "sure_no": 20,
      "sure_adi": "Taa-Haa",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "إِنِّىٓ أَنَا۠ رَبُّكَ فَٱخْلَعْ نَعْلَيْكَ ۖ إِنَّكَ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًۭى ۝١٢"
    }
  ]
}