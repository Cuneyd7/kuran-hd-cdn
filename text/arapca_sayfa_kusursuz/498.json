{
  "sayfa_no": 498,
  "ayetler": [
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ ۝٤٠"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًۭى شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ ۝٤١"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ۝٤٢"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ ۝٤٣"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "طَعَامُ ٱلْأَثِيمِ ۝٤٤"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ ۝٤٥"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "كَغَلْىِ ٱلْحَمِيمِ ۝٤٦"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 47,
      "besmele_var_mi": false,
      "metin": "خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ ۝٤٧"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ ۝٤٨"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ ۝٤٩"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ ۝٥٠"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍۢ ۝٥١"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "فِى جَنَّٰتٍۢ وَعُيُونٍۢ ۝٥٢"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 53,
      "besmele_var_mi": false,
      "metin": "يَلْبَسُونَ مِن سُندُسٍۢ وَإِسْتَبْرَقٍۢ مُّتَقَٰبِلِينَ ۝٥٣"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 54,
      "besmele_var_mi": false,
      "metin": "كَذَٰلِكَ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍۢ ۝٥٤"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 55,
      "besmele_var_mi": false,
      "metin": "يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ ۝٥٥"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 56,
      "besmele_var_mi": false,
      "metin": "لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ ۝٥٦"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 57,
      "besmele_var_mi": false,
      "metin": "فَضْلًۭا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ۝٥٧"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 58,
      "besmele_var_mi": false,
      "metin": "فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ ۝٥٨"
    },
    {
      "sure_no": 44,
      "sure_adi": "Ad-Dukhaan",
      "ayet_no": 59,
      "besmele_var_mi": false,
      "metin": "فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ ۝٥٩"
    }
  ]
}