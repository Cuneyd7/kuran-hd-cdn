{
  "sayfa_no": 603,
  "ayetler": [
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ ۝١"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "لَآ أَعْبُدُ مَا تَعْبُدُونَ ۝٢"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ ۝٣"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ ۝٤"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ ۝٥"
    },
    {
      "sure_no": 109,
      "sure_adi": "Al-Kaafiroon",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ ۝٦"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ ۝١"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا ۝٢"
    },
    {
      "sure_no": 110,
      "sure_adi": "An-Nasr",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا ۝٣"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ ۝١"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ ۝٢"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ ۝٣"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ ۝٤"
    },
    {
      "sure_no": 111,
      "sure_adi": "Al-Masad",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ ۝٥"
    }
  ]
}