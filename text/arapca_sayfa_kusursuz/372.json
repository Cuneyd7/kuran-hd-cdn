{
  "sayfa_no": 372,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 112,
      "besmele_var_mi": false,
      "metin": "قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ ۝١١٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 113,
      "besmele_var_mi": false,
      "metin": "إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى ۖ لَوْ تَشْعُرُونَ ۝١١٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 114,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ ۝١١٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 115,
      "besmele_var_mi": false,
      "metin": "إِنْ أَنَا۠ إِلَّا نَذِيرٌۭ مُّبِينٌۭ ۝١١٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 116,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ ۝١١٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 117,
      "besmele_var_mi": false,
      "metin": "قَالَ رَبِّ إِنَّ قَوْمِى كَذَّبُونِ ۝١١٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 118,
      "besmele_var_mi": false,
      "metin": "فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْحًۭا وَنَجِّنِى وَمَن مَّعِىَ مِنَ ٱلْمُؤْمِنِينَ ۝١١٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 119,
      "besmele_var_mi": false,
      "metin": "فَأَنجَيْنَٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ ۝١١٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 120,
      "besmele_var_mi": false,
      "metin": "ثُمَّ أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ ۝١٢٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 121,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ ۝١٢١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 122,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ۝١٢٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 123,
      "besmele_var_mi": false,
      "metin": "كَذَّبَتْ عَادٌ ٱلْمُرْسَلِينَ ۝١٢٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 124,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ ۝١٢٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 125,
      "besmele_var_mi": false,
      "metin": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ ۝١٢٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 126,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١٢٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 127,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ ۝١٢٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 128,
      "besmele_var_mi": false,
      "metin": "أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةًۭ تَعْبَثُونَ ۝١٢٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 129,
      "besmele_var_mi": false,
      "metin": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ ۝١٢٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 130,
      "besmele_var_mi": false,
      "metin": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ ۝١٣٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 131,
      "besmele_var_mi": false,
      "metin": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ۝١٣١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 132,
      "besmele_var_mi": false,
      "metin": "وَٱتَّقُوا۟ ٱلَّذِىٓ أَمَدَّكُم بِمَا تَعْلَمُونَ ۝١٣٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 133,
      "besmele_var_mi": false,
      "metin": "أَمَدَّكُم بِأَنْعَٰمٍۢ وَبَنِينَ ۝١٣٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 134,
      "besmele_var_mi": false,
      "metin": "وَجَنَّٰتٍۢ وَعُيُونٍ ۝١٣٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 135,
      "besmele_var_mi": false,
      "metin": "إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍۢ ۝١٣٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 136,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ ٱلْوَٰعِظِينَ ۝١٣٦"
    }
  ]
}