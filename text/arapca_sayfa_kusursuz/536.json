{
  "sayfa_no": 536,
  "ayetler": [
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 51,
      "besmele_var_mi": false,
      "metin": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ ۝٥١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 52,
      "besmele_var_mi": false,
      "metin": "لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ ۝٥٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 53,
      "besmele_var_mi": false,
      "metin": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ ۝٥٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 54,
      "besmele_var_mi": false,
      "metin": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ ۝٥٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 55,
      "besmele_var_mi": false,
      "metin": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ ۝٥٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 56,
      "besmele_var_mi": false,
      "metin": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ ۝٥٦"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 57,
      "besmele_var_mi": false,
      "metin": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ ۝٥٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 58,
      "besmele_var_mi": false,
      "metin": "أَفَرَءَيْتُم مَّا تُمْنُونَ ۝٥٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 59,
      "besmele_var_mi": false,
      "metin": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ ۝٥٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 60,
      "besmele_var_mi": false,
      "metin": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ ۝٦٠"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 61,
      "besmele_var_mi": false,
      "metin": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ ۝٦١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 62,
      "besmele_var_mi": false,
      "metin": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ ۝٦٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 63,
      "besmele_var_mi": false,
      "metin": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ ۝٦٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 64,
      "besmele_var_mi": false,
      "metin": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ ۝٦٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 65,
      "besmele_var_mi": false,
      "metin": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ ۝٦٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 66,
      "besmele_var_mi": false,
      "metin": "إِنَّا لَمُغْرَمُونَ ۝٦٦"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 67,
      "besmele_var_mi": false,
      "metin": "بَلْ نَحْنُ مَحْرُومُونَ ۝٦٧"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 68,
      "besmele_var_mi": false,
      "metin": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ ۝٦٨"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 69,
      "besmele_var_mi": false,
      "metin": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ ۝٦٩"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 70,
      "besmele_var_mi": false,
      "metin": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ ۝٧٠"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 71,
      "besmele_var_mi": false,
      "metin": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ ۝٧١"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 72,
      "besmele_var_mi": false,
      "metin": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ ۝٧٢"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 73,
      "besmele_var_mi": false,
      "metin": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ ۝٧٣"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 74,
      "besmele_var_mi": false,
      "metin": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ ۝٧٤"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 75,
      "besmele_var_mi": false,
      "metin": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ۝٧٥"
    },
    {
      "sure_no": 56,
      "sure_adi": "Al-Waaqia",
      "ayet_no": 76,
      "besmele_var_mi": false,
      "metin": "وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ ۝٧٦"
    }
  ]
}