{
  "sayfa_no": 571,
  "ayetler": [
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًۭا ۝١١"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "وَيُمْدِدْكُم بِأَمْوَٰلٍۢ وَبَنِينَ وَيَجْعَل لَّكُمْ جَنَّٰتٍۢ وَيَجْعَل لَّكُمْ أَنْهَٰرًۭا ۝١٢"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًۭا ۝١٣"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَقَدْ خَلَقَكُمْ أَطْوَارًا ۝١٤"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "أَلَمْ تَرَوْا۟ كَيْفَ خَلَقَ ٱللَّهُ سَبْعَ سَمَٰوَٰتٍۢ طِبَاقًۭا ۝١٥"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "وَجَعَلَ ٱلْقَمَرَ فِيهِنَّ نُورًۭا وَجَعَلَ ٱلشَّمْسَ سِرَاجًۭا ۝١٦"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَٱللَّهُ أَنۢبَتَكُم مِّنَ ٱلْأَرْضِ نَبَاتًۭا ۝١٧"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًۭا ۝١٨"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "وَٱللَّهُ جَعَلَ لَكُمُ ٱلْأَرْضَ بِسَاطًۭا ۝١٩"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "لِّتَسْلُكُوا۟ مِنْهَا سُبُلًۭا فِجَاجًۭا ۝٢٠"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "قَالَ نُوحٌۭ رَّبِّ إِنَّهُمْ عَصَوْنِى وَٱتَّبَعُوا۟ مَن لَّمْ يَزِدْهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارًۭا ۝٢١"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "وَمَكَرُوا۟ مَكْرًۭا كُبَّارًۭا ۝٢٢"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "وَقَالُوا۟ لَا تَذَرُنَّ ءَالِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّۭا وَلَا سُوَاعًۭا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًۭا ۝٢٣"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "وَقَدْ أَضَلُّوا۟ كَثِيرًۭا ۖ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا ضَلَٰلًۭا ۝٢٤"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "مِّمَّا خَطِيٓـَٰٔتِهِمْ أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًۭا فَلَمْ يَجِدُوا۟ لَهُم مِّن دُونِ ٱللَّهِ أَنصَارًۭا ۝٢٥"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "وَقَالَ نُوحٌۭ رَّبِّ لَا تَذَرْ عَلَى ٱلْأَرْضِ مِنَ ٱلْكَٰفِرِينَ دَيَّارًا ۝٢٦"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "إِنَّكَ إِن تَذَرْهُمْ يُضِلُّوا۟ عِبَادَكَ وَلَا يَلِدُوٓا۟ إِلَّا فَاجِرًۭا كَفَّارًۭا ۝٢٧"
    },
    {
      "sure_no": 71,
      "sure_adi": "Nooh",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "رَّبِّ ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ بَيْتِىَ مُؤْمِنًۭا وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا تَبَارًۢا ۝٢٨"
    }
  ]
}