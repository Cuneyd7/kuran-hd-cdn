{
  "sayfa_no": 370,
  "ayetler": [
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 61,
      "besmele_var_mi": false,
      "metin": "فَلَمَّا تَرَٰٓءَا ٱلْجَمْعَانِ قَالَ أَصْحَٰبُ مُوسَىٰٓ إِنَّا لَمُدْرَكُونَ ۝٦١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 62,
      "besmele_var_mi": false,
      "metin": "قَالَ كَلَّآ ۖ إِنَّ مَعِىَ رَبِّى سَيَهْدِينِ ۝٦٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 63,
      "besmele_var_mi": false,
      "metin": "فَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْبَحْرَ ۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرْقٍۢ كَٱلطَّوْدِ ٱلْعَظِيمِ ۝٦٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 64,
      "besmele_var_mi": false,
      "metin": "وَأَزْلَفْنَا ثَمَّ ٱلْءَاخَرِينَ ۝٦٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 65,
      "besmele_var_mi": false,
      "metin": "وَأَنجَيْنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجْمَعِينَ ۝٦٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 66,
      "besmele_var_mi": false,
      "metin": "ثُمَّ أَغْرَقْنَا ٱلْءَاخَرِينَ ۝٦٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 67,
      "besmele_var_mi": false,
      "metin": "إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ ۝٦٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 68,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ۝٦٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 69,
      "besmele_var_mi": false,
      "metin": "وَٱتْلُ عَلَيْهِمْ نَبَأَ إِبْرَٰهِيمَ ۝٦٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 70,
      "besmele_var_mi": false,
      "metin": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَ ۝٧٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 71,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ نَعْبُدُ أَصْنَامًۭا فَنَظَلُّ لَهَا عَٰكِفِينَ ۝٧١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 72,
      "besmele_var_mi": false,
      "metin": "قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ ۝٧٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 73,
      "besmele_var_mi": false,
      "metin": "أَوْ يَنفَعُونَكُمْ أَوْ يَضُرُّونَ ۝٧٣"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 74,
      "besmele_var_mi": false,
      "metin": "قَالُوا۟ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَ ۝٧٤"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 75,
      "besmele_var_mi": false,
      "metin": "قَالَ أَفَرَءَيْتُم مَّا كُنتُمْ تَعْبُدُونَ ۝٧٥"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 76,
      "besmele_var_mi": false,
      "metin": "أَنتُمْ وَءَابَآؤُكُمُ ٱلْأَقْدَمُونَ ۝٧٦"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 77,
      "besmele_var_mi": false,
      "metin": "فَإِنَّهُمْ عَدُوٌّۭ لِّىٓ إِلَّا رَبَّ ٱلْعَٰلَمِينَ ۝٧٧"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 78,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى خَلَقَنِى فَهُوَ يَهْدِينِ ۝٧٨"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 79,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِى هُوَ يُطْعِمُنِى وَيَسْقِينِ ۝٧٩"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 80,
      "besmele_var_mi": false,
      "metin": "وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ ۝٨٠"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 81,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِى يُمِيتُنِى ثُمَّ يُحْيِينِ ۝٨١"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 82,
      "besmele_var_mi": false,
      "metin": "وَٱلَّذِىٓ أَطْمَعُ أَن يَغْفِرَ لِى خَطِيٓـَٔتِى يَوْمَ ٱلدِّينِ ۝٨٢"
    },
    {
      "sure_no": 26,
      "sure_adi": "Ash-Shu'araa",
      "ayet_no": 83,
      "besmele_var_mi": false,
      "metin": "رَبِّ هَبْ لِى حُكْمًۭا وَأَلْحِقْنِى بِٱلصَّٰلِحِينَ ۝٨٣"
    }
  ]
}