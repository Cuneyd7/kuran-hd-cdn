{
  "sayfa_no": 581,
  "ayetler": [
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 20,
      "besmele_var_mi": false,
      "metin": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ ۝٢٠"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 21,
      "besmele_var_mi": false,
      "metin": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ ۝٢١"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 22,
      "besmele_var_mi": false,
      "metin": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ ۝٢٢"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 23,
      "besmele_var_mi": false,
      "metin": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ ۝٢٣"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 24,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٢٤"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 25,
      "besmele_var_mi": false,
      "metin": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا ۝٢٥"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 26,
      "besmele_var_mi": false,
      "metin": "أَحْيَآءًۭ وَأَمْوَٰتًۭا ۝٢٦"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 27,
      "besmele_var_mi": false,
      "metin": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا ۝٢٧"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 28,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٢٨"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 29,
      "besmele_var_mi": false,
      "metin": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ۝٢٩"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 30,
      "besmele_var_mi": false,
      "metin": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ ۝٣٠"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 31,
      "besmele_var_mi": false,
      "metin": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ ۝٣١"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 32,
      "besmele_var_mi": false,
      "metin": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ ۝٣٢"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 33,
      "besmele_var_mi": false,
      "metin": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ ۝٣٣"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 34,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٣٤"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 35,
      "besmele_var_mi": false,
      "metin": "هَٰذَا يَوْمُ لَا يَنطِقُونَ ۝٣٥"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 36,
      "besmele_var_mi": false,
      "metin": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ ۝٣٦"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 37,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٣٧"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 38,
      "besmele_var_mi": false,
      "metin": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ ۝٣٨"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 39,
      "besmele_var_mi": false,
      "metin": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ ۝٣٩"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 40,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٤٠"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 41,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ ۝٤١"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 42,
      "besmele_var_mi": false,
      "metin": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ ۝٤٢"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 43,
      "besmele_var_mi": false,
      "metin": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ ۝٤٣"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 44,
      "besmele_var_mi": false,
      "metin": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ۝٤٤"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 45,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٤٥"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 46,
      "besmele_var_mi": false,
      "metin": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ ۝٤٦"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 47,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٤٧"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 48,
      "besmele_var_mi": false,
      "metin": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ ۝٤٨"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 49,
      "besmele_var_mi": false,
      "metin": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ ۝٤٩"
    },
    {
      "sure_no": 77,
      "sure_adi": "Al-Mursalaat",
      "ayet_no": 50,
      "besmele_var_mi": false,
      "metin": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ ۝٥٠"
    }
  ]
}