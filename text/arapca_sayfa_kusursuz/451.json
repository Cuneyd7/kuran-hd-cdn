{
  "sayfa_no": 451,
  "ayetler": [
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 127,
      "besmele_var_mi": false,
      "metin": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ ۝١٢٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 128,
      "besmele_var_mi": false,
      "metin": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ ۝١٢٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 129,
      "besmele_var_mi": false,
      "metin": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ ۝١٢٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 130,
      "besmele_var_mi": false,
      "metin": "سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ ۝١٣٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 131,
      "besmele_var_mi": false,
      "metin": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ۝١٣١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 132,
      "besmele_var_mi": false,
      "metin": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ ۝١٣٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 133,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ لُوطًۭا لَّمِنَ ٱلْمُرْسَلِينَ ۝١٣٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 134,
      "besmele_var_mi": false,
      "metin": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ ۝١٣٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 135,
      "besmele_var_mi": false,
      "metin": "إِلَّا عَجُوزًۭا فِى ٱلْغَٰبِرِينَ ۝١٣٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 136,
      "besmele_var_mi": false,
      "metin": "ثُمَّ دَمَّرْنَا ٱلْءَاخَرِينَ ۝١٣٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 137,
      "besmele_var_mi": false,
      "metin": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ ۝١٣٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 138,
      "besmele_var_mi": false,
      "metin": "وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ ۝١٣٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 139,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ ۝١٣٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 140,
      "besmele_var_mi": false,
      "metin": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ ۝١٤٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 141,
      "besmele_var_mi": false,
      "metin": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ ۝١٤١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 142,
      "besmele_var_mi": false,
      "metin": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌۭ ۝١٤٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 143,
      "besmele_var_mi": false,
      "metin": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ ۝١٤٣"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 144,
      "besmele_var_mi": false,
      "metin": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ ۝١٤٤"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 145,
      "besmele_var_mi": false,
      "metin": "۞ فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌۭ ۝١٤٥"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 146,
      "besmele_var_mi": false,
      "metin": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةًۭ مِّن يَقْطِينٍۢ ۝١٤٦"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 147,
      "besmele_var_mi": false,
      "metin": "وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ ۝١٤٧"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 148,
      "besmele_var_mi": false,
      "metin": "فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍۢ ۝١٤٨"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 149,
      "besmele_var_mi": false,
      "metin": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ ۝١٤٩"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 150,
      "besmele_var_mi": false,
      "metin": "أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًۭا وَهُمْ شَٰهِدُونَ ۝١٥٠"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 151,
      "besmele_var_mi": false,
      "metin": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ ۝١٥١"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 152,
      "besmele_var_mi": false,
      "metin": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ ۝١٥٢"
    },
    {
      "sure_no": 37,
      "sure_adi": "As-Saaffaat",
      "ayet_no": 153,
      "besmele_var_mi": false,
      "metin": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ ۝١٥٣"
    }
  ]
}