{
  "sayfa_no": 587,
  "ayetler": [
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ ۝١"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ ۝٢"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ ۝٣"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ ۝٤"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ ۝٥"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ ۝٦"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 7,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ ۝٧"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 8,
      "besmele_var_mi": false,
      "metin": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ ۝٨"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 9,
      "besmele_var_mi": false,
      "metin": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ ۝٩"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 10,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ ۝١٠"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 11,
      "besmele_var_mi": false,
      "metin": "كِرَامًۭا كَٰتِبِينَ ۝١١"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 12,
      "besmele_var_mi": false,
      "metin": "يَعْلَمُونَ مَا تَفْعَلُونَ ۝١٢"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 13,
      "besmele_var_mi": false,
      "metin": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ ۝١٣"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 14,
      "besmele_var_mi": false,
      "metin": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ ۝١٤"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 15,
      "besmele_var_mi": false,
      "metin": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ ۝١٥"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 16,
      "besmele_var_mi": false,
      "metin": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ ۝١٦"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 17,
      "besmele_var_mi": false,
      "metin": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ ۝١٧"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 18,
      "besmele_var_mi": false,
      "metin": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ ۝١٨"
    },
    {
      "sure_no": 82,
      "sure_adi": "Al-Infitaar",
      "ayet_no": 19,
      "besmele_var_mi": false,
      "metin": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ ۝١٩"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 1,
      "besmele_var_mi": false,
      "metin": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ ۝١"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 2,
      "besmele_var_mi": false,
      "metin": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ ۝٢"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 3,
      "besmele_var_mi": false,
      "metin": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ ۝٣"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 4,
      "besmele_var_mi": false,
      "metin": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ ۝٤"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 5,
      "besmele_var_mi": false,
      "metin": "لِيَوْمٍ عَظِيمٍۢ ۝٥"
    },
    {
      "sure_no": 83,
      "sure_adi": "Al-Mutaffifin",
      "ayet_no": 6,
      "besmele_var_mi": false,
      "metin": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ ۝٦"
    }
  ]
}