  "sure_id": 87,
  "ayetler": [
    "Sabbihisma Rabbikal Alâ",
    "Allazî halaqa fasavvâ",
    "Vallazî qaddara fahadâ",
    "Vallazîe ahrajal marâ",
    "Fajaalahû ğusâaan ahvâ",
    "Sanuqriuka falâ tansâa",
    "Illâ mâ şâaal lâh; innahû yalamul jahra va mâ yahfâ",
    "Va nu-yassiruka lilyusrâ",
    "Fazakkir in nafaatizzikrâ",
    "Sa yazzakkaru maiyahşâ",
    "Va yatajannabuhal aşqâ",
    "Allazî yaslan Nâral kubrâ",
    "Summa lâ yamûtu fîhâ va lâ yahyâ",
    "Qad aflaha man tazakkâ",
    "Va zakaras ma Rabbihî fasallâ",
    "Bal tusirûnal hayâtad dunyâ",
    "Val Aahiratu hairunv va abqâ",
    "Inna hâzâ lafis suhu fil ûlâ",
    "Suhufi Ibrâhîma va Mûsâ"
  ]
